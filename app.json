{
  "name": "tavolo",
  "description": "AdonisJS application",
  "repository": "https://github.com/invector-tecnologia/tavolo",
  "keywords": [
    "adonisjs",
    "node",
    "typescript"
  ],
  "stack": "heroku-26",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "env": {
    "APP_KEY": {
      "description": "A secret key for verifying the integrity of signed cookies.",
      "generator": "secret"
    },
    "NODE_ENV": {
      "value": "production"
    },
    "HOST": {
      "value": "0.0.0.0"
    },
    "LOG_LEVEL": {
      "value": "info"
    },
    "TZ": {
      "value": "UTC"
    },
    "SESSION_DRIVER": {
      "value": "cookie"
    },
    "FISCAL_ENCRYPTION_KEY": {
      "description": "Chave de criptografia do módulo fiscal (AES-256, 32 bytes)",
      "generator": "secret"
    }
  }
}