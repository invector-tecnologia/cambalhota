# Aplicação
TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=your_app_key_here
NODE_ENV=development

# Banco de Dados
# Para desenvolvimento local com PostgreSQL
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=tavolo

# Para desenvolvimento local com SQLite (alternativa)
# DB_CONNECTION=sqlite
# DB_DATABASE=./tmp/db.sqlite

# Para produção no Heroku (será configurado automaticamente)
# DATABASE_URL=postgres://user:pass@hostname:port/dbname

# Sessões
SESSION_DRIVER=cookie

# Configurações de segurança (opcional)
# CSRF_ENABLED=true
# SHIELD_ENABLED=true

# Upload de arquivos (opcional)
# MAX_FILE_SIZE=2mb
# ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,xml

# Email (opcional - para notificações futuras)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Logs
# LOG_FILE_ENABLED=true
# LOG_FILE_PATH=./tmp/logs
SMTP_HOST=
SMTP_PORT=

# Fiscal Engine
# Chave de criptografia do módulo fiscal (AES-256, 32 bytes)
# Gere uma chave forte (exemplos):
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FISCAL_ENCRYPTION_KEY=defina-uma-chave-forte-de-32-bytes

# Cloudflare Images
# Conta e autenticação
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
# Entrega
# Exemplo: https://imagedelivery.net/SEU_ACCOUNT_HASH
CF_IMAGES_DELIVERY_BASE=
# Variante padrão (deve existir nas variants da sua conta: ex. public, thumb, card)
CF_IMAGES_DEFAULT_VARIANT=public