        <header class="bg-white ring-1 ring-industrial-100">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <div class="flex h-16 items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-accent-500/10 text-accent-600 flex items-center justify-center">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold text-industrial-900">Notas Fiscais Eletrônicas</h1>
                        <p class="text-sm text-industrial-500">Gestão de NFes</p>
                    </div>
                    <div class="flex items-center gap-3 ml-auto">
                        <a href="{{ route('notas_fiscais.create') }}" class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
                            <i class="fas fa-file-import"></i>
                            Importar NFe
