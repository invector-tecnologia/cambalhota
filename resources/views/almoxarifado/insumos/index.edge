    </head>
<body class="bg-industrial-50 min-h-screen font-sans text-industrial-900">
    <!-- Cabeçalho -->
    <header class="app-card shadow-sm">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center gap-3">
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-accent-500/10 text-accent-600 flex items-center justify-center">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <div>
                        <h1 class="text-lg font-semibold app-strong app-strong">Insumos</h1>
                        <p class="text-sm app-muted">Gestão de estoque</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 ml-auto">
                    <a href="{{ route('insumos.create') }}" class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-500">
                        <i class="fas fa-plus"></i>
                        Novo Insumo
                    </a>
                    <a href="{{ route('dashboard.index') }}"
                        class="inline-flex items-center gap-2 rounded-lg bg-industrial-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-industrial-400">
                        <i class="fas fa-home mr-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </header>    

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Search and Filters -->
        <div class="mb-6">
            <form method="GET" class="space-y-4">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
                    <!-- Search -->
                    <div class="md:col-span-2">                    
                        <div class="relative">
                            <input 
                                type="text" 
                                name="search" 
                                value="{{ filters.search }}" 
                                placeholder="Buscar insumos..." 
                                class="w-full px-4 py-2 app-border shadow-sm rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                            <button type="submit" class="absolute right-0 top-0 h-full px-4 text-industrial-400 hover:app-muted">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Tipo -->
                    <div>
                        <select name="type" id="type" class="w-full px-4 py-2 app-border shadow-sm rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                            <option value="">Todos os Tipos</option>
                            <option value="ingredient" {{ filters.type === 'ingredient' ? 'selected' : '' }}>Ingrediente</option>
                            <option value="finished_product" {{ filters.type === 'finished_product' ? 'selected' : '' }}>Insumo Acabado</option>
                            <option value="beverage" {{ filters.type === 'beverage' ? 'selected' : '' }}>Bebida</option>
                            <option value="insumo" {{ filters.type === 'insumo' ? 'selected' : '' }}>Suprimento</option>
                        </select>
                    </div>

                    <!-- Categoria -->
                    <div>
                        <select name="categoria" id="categoria" class="w-full px-4 py-2 app-border shadow-sm rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                            <option value="">Todas Categorias</option>
                            @each(cat in categorias)
                                <option value="{{ cat }}" {{ filters.categoria === cat ? 'selected' : '' }}>{{ cat }}</option>
                            @end
                        </select>
                    </div>
                </div>

                <!-- Stock Status Filter -->
                <div class="flex items-center gap-4">                
                    <select name="stock_status" id="stock_status" class="px-4 py-2 app-border shadow-sm rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                        <option value="">Status do Estoque</option>
                        <option value="low" {{ filters.stock_status === 'low' ? 'selected' : '' }}>Estoque Baixo</option>
                        <option value="high" {{ filters.stock_status === 'high' ? 'selected' : '' }}>Estoque Alto</option>
                    </select>
                    
                    <a href="{{ route('insumos.index') }}" class="inline-flex items-center px-4 py-2 text-sm font-semibold app-muted hover:text-industrial-900">
                        Limpar Filtros
                    </a>
                </div>
            </form>
        </div>

        <!-- Insumos List -->
        <div class="app-card shadow-sm rounded-xl app-border overflow-hidden">
            <div class="px-6 py-4 app-border">
                <h3 class="text-lg font-semibold app-strong app-strong">
                    Lista de Insumos
                </h3>
            </div>
            
            @if(insumos.data.length > 0)
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y app-border">
                    <thead class="app-card">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                                Insumo
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                                Tipo
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                                Estoque
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                                Preços
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                                Status
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                                Ações
                            </th>
                        </tr>
                    </thead>
                    <tbody class="app-card divide-y app-border">
                        @each(insumo in insumos.data)
                        <tr class="hover:bg-industrial-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-semibold app-strong">{{ insumo.name }}</div>
                                @if(insumo.code)
                                <div class="text-sm app-muted">Código: {{ insumo.code }}</div>
                                @end
                                @if(insumo.categoria)
                                <div class="text-sm app-muted">{{ insumo.categoria }}</div>
                                @end
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex px-2.5 py-0.5 text-xs font-semibold rounded-full
                                    @if(insumo.type === 'ingredient')
                                        bg-pink-50 text-pink-700
                                    @elseif(insumo.type === 'finished_product')
                                        bg-blue-50 text-blue-700
                                    @elseif(insumo.type === 'beverage')
                                        bg-orange-50 text-orange-700
                                    @else
                                        bg-purple-50 text-purple-700
                                    @end
                                ">
                                    @if(insumo.type === 'ingredient')
                                        Ingrediente
                                    @elseif(insumo.type === 'finished_product')
                                        Insumo Acabado
                                    @elseif(insumo.type === 'beverage')
                                        Bebida
                                    @else
                                        Suprimento
                                    @end
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm app-text">
                                    @if(insumo.stockControl && Number(insumo.currentStock) <= Number(insumo.minimumStock))
                                    <span class="inline-flex px-2.5 py-0.5 text-xs font-semibold bg-red-50 text-red-700 rounded-full">
                                        Baixo
                                    </span>
                                    @elseif(insumo.maximumStock && Number(insumo.currentStock) >= Number(insumo.maximumStock))
                                    <span class="inline-flex px-2.5 py-0.5 text-xs font-semibold bg-yellow-50 text-yellow-700 rounded-full">
                                        Alto
                                    </span>
                                    @end
                                    <span class="font-semibold">{{ formatDecimal(insumo.currentStock) }} {{ insumo.unit }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm app-text">
                                    Compra: {{ formatCurrency(insumo.purchasePrice) }}
                                </div>
                                @if(insumo.salePrice)
                                <div class="text-sm app-muted">
                                    Venda: {{ formatCurrency(insumo.salePrice) }}
                                </div>
                                @end
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if(insumo.active)
                                <span class="inline-flex px-2.5 py-0.5 text-xs font-semibold bg-green-50 text-green-700 rounded-full">
                                    Ativo
                                </span>
                                @else
                                <span class="inline-flex px-2.5 py-0.5 text-xs font-semibold bg-red-50 text-red-700 rounded-full">
                                    Inativo
                                </span>
                                @end
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="inline-flex gap-3">
                                    <a href="{{ route('insumos.show', { id: insumo.id }) }}" class="text-accent-600 hover:text-accent-500">
                                        Ver
                                    </a>
                                    <a href="{{ route('insumos.edit', { id: insumo.id }) }}" class="app-muted hover:text-industrial-500">
                                        Editar
                                    </a>
                                </div>
                            </td>
                        </tr>
                        @end
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            @if(insumos.meta.total > insumos.meta.per_page)
            <div class="px-6 py-4 app-border">
                <div class="flex items-center justify-between">
                    <div class="text-sm app-text">
                        Mostrando {{ insumos.meta.from }} a {{ insumos.meta.to }} de {{ insumos.meta.total }} insumos
                    </div>
                    <div class="flex gap-2">
                        @if(insumos.meta.current_page > 1)
                        <a href="?page={{ insumos.meta.current_page - 1 }}&search={{ filters.search }}&type={{ filters.type }}&categoria={{ filters.categoria }}&stock_status={{ filters.stock_status }}" class="px-3 py-1.5 text-sm app-border rounded-lg hover:bg-industrial-50 font-semibold">
                            Anterior
                        </a>
                        @end
                        @if(insumos.meta.current_page < insumos.meta.last_page)
                        <a href="?page={{ insumos.meta.current_page + 1 }}&search={{ filters.search }}&type={{ filters.type }}&categoria={{ filters.categoria }}&stock_status={{ filters.stock_status }}" class="px-3 py-1.5 text-sm app-border rounded-lg hover:bg-industrial-50 font-semibold">
                            Próxima
                        </a>
                        @end
                    </div>
                </div>
            </div>
            @end
            
            @else
            <div class="px-6 py-12 text-center">
                <i class="fas fa-boxes text-6xl text-industrial-200 mb-4"></i>
                <h3 class="mt-4 text-sm font-semibold app-strong">Nenhum insumo encontrado</h3>
                <p class="mt-2 text-sm app-muted">
                    @if(filters.search)
                    Tente buscar com outros termos ou 
                    <a href="{{ route('insumos.index') }}" class="app-accent-text hover:text-accent-500">limpe o filtro</a>.
                    @else
                    Comece adicionando um novo insumo.
                    @end
                </p>
                @if(!filters.search)
                <div class="mt-6">
                    <a href="{{ route('insumos.create') }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg text-white bg-accent-600 shadow-sm hover:bg-accent-500">
                        <i class="fas fa-plus"></i>
                        Novo Insumo
                    </a>
                </div>
                @end
            </div>
            @end
        </div>
    </main>

    </main>
  @include('components/quick_actions')

    <script>
        // Auto-submit do formulário ao mudar filtros
        document.getElementById('type').addEventListener('change', function() {
            this.form.submit();
        });
        document.getElementById('categoria').addEventListener('change', function() {
            this.form.submit();
        });
        document.getElementById('stock_status').addEventListener('change', function() {
            this.form.submit();
        });
    </script>
</body>
</html>