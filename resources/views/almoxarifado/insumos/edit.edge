  @include('components/quick_actions')

    <script>
        // Mostrar/esconder campo de prazo de validade
        document.getElementById('perishable').addEventListener('change', function() {
            const container = document.getElementById('shelf_life_container');
            if (this.checked) {
                container.style.display = 'block';
            } else {
                container.style.display = 'none';
                document.getElementById('shelf_life_days').value = '';
            }
        });

        // Validações
        const validators = {
            currency: (value) => {
                if (!value) return { valid: false, message: 'Valor é obrigatório' };
                const num = parseFloat(value);
                if (isNaN(num) || num < 0) return { valid: false, message: 'Valor inválido' };
                return { valid: true, message: '' };
            },
            currencyOptional: (value) => {
                if (!value) return { valid: true, message: '' };
                const num = parseFloat(value);
                if (isNaN(num) || num < 0) return { valid: false, message: 'Valor inválido' };
                return { valid: true, message: '' };
            },
            number: (value, min = 0) => {
                if (value === '' || value === null) return { valid: false, message: 'Campo obrigatório' };
                const num = parseFloat(value);
                if (isNaN(num)) return { valid: false, message: 'Número inválido' };
                if (num < min) return { valid: false, message: `Valor mínimo: ${min}` };
                return { valid: true, message: '' };
            },
            numberOptional: (value, min = 0) => {
                if (!value || value === '') return { valid: true, message: '' };
                const num = parseFloat(value);
                if (isNaN(num)) return { valid: false, message: 'Número inválido' };
                if (num < min) return { valid: false, message: `Valor mínimo: ${min}` };
                return { valid: true, message: '' };
            },
            required: (value) => {
                if (!value || value.trim() === '') {
                    return { valid: false, message: 'Campo obrigatório' };
                }
                return { valid: true, message: '' };
            }
        };

        function showFeedback(input, validation) {
            const existingFeedback = input.parentElement.querySelector('.field-feedback');
            if (existingFeedback) existingFeedback.remove();

            input.classList.remove('border-red-500', 'border-green-500', 'focus:ring-red-500', 'focus:ring-green-500');
            
            if (validation.valid && validation.message) {
                input.classList.add('border-green-500', 'focus:ring-green-500');
            } else if (!validation.valid) {
                input.classList.add('border-red-500', 'focus:ring-red-500');
            }

            if (validation.message) {
                const feedback = document.createElement('div');
                feedback.className = `field-feedback text-xs mt-1 ${validation.valid ? 'text-green-600' : 'text-red-600'}`;
                feedback.textContent = validation.message;
                input.parentElement.appendChild(feedback);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Campos monetários obrigatórios
            ['purchase_price'].forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener('blur', function() {
                        const validation = validators.currency(this.value);
                        showFeedback(this, validation);
                    });
                }
            });

            // Campos monetários opcionais
            ['sale_price'].forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener('blur', function() {
                        if (this.value) {
                            const validation = validators.currencyOptional(this.value);
                            showFeedback(this, validation);
                        }
                    });
                }
            });

            // Campos numéricos (estoque)
            ['current_stock'].forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener('blur', function() {
                        const validation = validators.number(this.value, 0);
                        showFeedback(this, validation);
                    });
                }
            });

            // Campos numéricos opcionais
            ['minimum_stock', 'maximum_stock', 'conversion_factor', 'tax_rate', 'shelf_life_days'].forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener('blur', function() {
                        if (this.value) {
                            const validation = validators.numberOptional(this.value, 0);
                            showFeedback(this, validation);
                        }
                    });
                }
            });

            // Campos obrigatórios
            ['name', 'sku'].forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener('blur', function() {
                        const validation = validators.required(this.value);
                        showFeedback(this, validation);
                    });
                }
            });

            // Nota: Formatação automática de moeda e decimal aplicada via data-mask
            // Definida em resources/js/number-formatter.js
        });
    </script>
  @include('components/quick_actions')
</body>
</html>