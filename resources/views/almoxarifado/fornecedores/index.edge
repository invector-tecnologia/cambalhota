                        </tr>
                        @endeach
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            @if(fornecedores.meta.total > fornecedores.meta.per_page)
            <div class="px-6 py-4 app-border">
                <div class="flex items-center justify-between">
                    <div class="text-sm app-text">
                        Mostrando {{ fornecedores.meta.from }} a {{ fornecedores.meta.to }} de {{ fornecedores.meta.total }} fornecedores
                    </div>
                    <div class="flex gap-2">
                        @if(fornecedores.meta.current_page > 1)
                        <a href="?page={{ fornecedores.meta.current_page - 1 }}&search={{ search }}" class="px-3 py-1.5 text-sm app-border rounded-lg hover:bg-industrial-50 font-semibold">
                            Anterior
                        </a>
                        @endif
                        @if(fornecedores.meta.current_page < fornecedores.meta.last_page)
                        <a href="?page={{ fornecedores.meta.current_page + 1 }}&search={{ search }}" class="px-3 py-1.5 text-sm app-border rounded-lg hover:bg-industrial-50 font-semibold">
                            Próxima
                        </a>
                        @endif
                    </div>
                </div>
            </div>
            @endif
            
            @else
            <div class="px-6 py-12 text-center">
