                                @if(fornecedor.phone)
                                <div class="text-sm app-muted">{{ fornecedor.phone }}</div>
                                @endif
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if(fornecedor.document)
                                <div class="text-sm app-text">{{ fornecedor.document }}</div>
                                @endif
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if(fornecedor.active)
                                <span class="inline-flex px-2.5 py-0.5 text-xs font-semibold bg-green-50 text-green-700 rounded-full">
                                    Ativo
                                </span>
                                @else
