                <div class="mt-6">
                    <a href="/almoxarifado/fornecedores/novo" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg text-white bg-accent-600 shadow-sm hover:bg-accent-500">
                        <i class="fas fa-plus"></i>
                        Novo Fornecedor
                    </a>
                </div>
                @endif
            </div>
