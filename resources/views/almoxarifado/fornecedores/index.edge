                    >
                    <button type="submit" class="absolute right-0 top-0 h-full px-4 text-industrial-400 hover:app-muted">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Suppliers List -->
        <div class="app-card shadow-sm rounded-xl app-border overflow-hidden">
