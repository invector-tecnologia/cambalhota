                <h3 class="mt-4 text-sm font-semibold app-strong">Nenhum fornecedor encontrado</h3>
                <p class="mt-2 text-sm app-muted">
                    @if(search)
                    Tente buscar com outros termos ou 
                    <a href="/almoxarifado/fornecedores" class="app-accent-text hover:text-accent-500">limpe o filtro</a>.
                    @else
                    Comece adicionando um novo fornecedor.
                    @endif
                </p>
