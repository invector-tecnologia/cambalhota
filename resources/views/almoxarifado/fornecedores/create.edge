<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrfToken }}">
    <title>Novo Fornecedor - Almoxarifado - Tavolo</title>
    @vite(['resources/css/app.css'])
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    </head>
<body class="h-full font-sans text-industrial-900">
    <!-- Cabeçalho -->
    <header class="app-card shadow">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center gap-3">
                <div class="flex">
                    <h1 class="text-xl font-semibold leading-6 app-strong app-strong">Novo Fornecedor</h1>
                </div>
                <div class="flex items-center space-x-4 ml-auto">
                    <a href="{{ route('fornecedores.index') }}" class="inline-flex items-center rounded-md bg-industrial-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-industrial-500">
                        <i class="fas fa-list mr-2"></i> Lista de Fornecedores
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Page Header -->
        <div class="mb-8">
            <div class="flex items-center space-x-3 mb-4">
                <a href="/almoxarifado/fornecedores" class="text-industrial-400 hover:app-muted">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <h1 class="text-3xl font-bold app-strong app-strong">
                    Novo Fornecedor
                </h1>
            </div>
            <p class="app-muted">
                Cadastre um novo fornecedor para o almoxarifado
            </p>
        </div>

        <!-- Form -->
        <div class="app-card rounded-lg overflow-hidden">
            <form action="/almoxarifado/fornecedores" method="POST" class="space-y-8 p-6">
                {{ csrfField() }}
                
                <!-- Seção: Dados Principais -->
                <div>
                    <h3 class="text-lg font-semibold app-strong mb-4 app-border pb-2">Dados Principais</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Nome/Razão Social -->
                        <div class="md:col-span-2">
                            <label for="name" class="block text-sm font-medium app-muted mb-2">
                                Razão Social *
                            </label>
                            <input 
                                type="text" 
                                name="name" 
                                id="name" 
                                required
                                value="{{ old('name') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="Ex: Distribuidora ABC Ltda"
                            >
                        </div>

                        <!-- Nome Fantasia -->
                        <div class="md:col-span-2">
                            <label for="trade_name" class="block text-sm font-medium app-muted mb-2">
                                Nome Fantasia
                            </label>
                            <input 
                                type="text" 
                                name="trade_name" 
                                id="trade_name"
                                value="{{ old('trade_name') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="Ex: ABC Distribuidora"
                            >
                        </div>

                        <!-- Tipo de Documento -->
                        <div>
                            <label for="document_type" class="block text-sm font-medium app-muted mb-2">
                                Tipo de Documento *
                            </label>
                            <select 
                                name="document_type" 
                                id="document_type"
                                required
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                                <option value="cnpj" {{ old('document_type') === 'cnpj' ? 'selected' : '' }}>CNPJ</option>
                                <option value="cpf" {{ old('document_type') === 'cpf' ? 'selected' : '' }}>CPF</option>
                            </select>
                        </div>

                        <!-- Documento -->
                        <div>
                            <label for="document" class="block text-sm font-medium app-muted mb-2">
                                CPF/CNPJ *
                            </label>
                            <input 
                                type="text" 
                                name="document" 
                                id="document"
                                required
                                value="{{ old('document') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="00.000.000/0001-00"
                            >
                        </div>

                        <!-- IE -->
                        <div>
                            <label for="ie" class="block text-sm font-medium app-muted mb-2">
                                Inscrição Estadual
                            </label>
                            <input 
                                type="text" 
                                name="ie" 
                                id="ie"
                                value="{{ old('ie') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="000.000.000.000"
                            >
                        </div>

                        <!-- Condições de Pagamento -->
                        <div>
                            <label for="payment_terms" class="block text-sm font-medium app-muted mb-2">
                                Condições de Pagamento *
                            </label>
                            <select 
                                name="payment_terms" 
                                id="payment_terms"
                                required
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                                <option value="vista" {{ old('payment_terms') === 'vista' ? 'selected' : '' }}>À Vista</option>
                                <option value="7_dias" {{ old('payment_terms') === '7_dias' ? 'selected' : '' }}>7 dias</option>
                                <option value="15_dias" {{ old('payment_terms') === '15_dias' ? 'selected' : '' }}>15 dias</option>
                                <option value="30_dias" {{ old('payment_terms', '30_dias') === '30_dias' ? 'selected' : '' }}>30 dias</option>
                                <option value="45_dias" {{ old('payment_terms') === '45_dias' ? 'selected' : '' }}>45 dias</option>
                                <option value="60_dias" {{ old('payment_terms') === '60_dias' ? 'selected' : '' }}>60 dias</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Seção: Contato -->
                <div>
                    <h3 class="text-lg font-semibold app-strong mb-4 app-border pb-2">Contato</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Pessoa de Contato -->
                        <div>
                            <label for="contact_person" class="block text-sm font-medium app-muted mb-2">
                                Pessoa de Contato
                            </label>
                            <input 
                                type="text" 
                                name="contact_person" 
                                id="contact_person"
                                value="{{ old('contact_person') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="Ex: João Silva"
                            >
                        </div>

                        <!-- Email -->
                        <div>
                            <label for="email" class="block text-sm font-medium app-muted mb-2">
                                Email
                            </label>
                            <input 
                                type="email" 
                                name="email" 
                                id="email"
                                value="{{ old('email') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="contato@fornecedor.com"
                            >
                        </div>

                        <!-- Telefone -->
                        <div>
                            <label for="phone" class="block text-sm font-medium app-muted mb-2">
                                Telefone
                            </label>
                            <input 
                                type="tel" 
                                name="phone" 
                                id="phone"
                                value="{{ old('phone') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="(11) 99999-9999"
                            >
                        </div>
                    </div>
                </div>

                <!-- Seção: Endereço -->
                <div>
                    <h3 class="text-lg font-semibold app-strong mb-4 app-border pb-2">Endereço</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- CEP -->
                        <div>
                            <label for="zip_code" class="block text-sm font-medium app-muted mb-2">
                                CEP
                            </label>
                            <input 
                                type="text" 
                                name="zip_code" 
                                id="zip_code"
                                value="{{ old('zip_code') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="00000-000"
                            >
                        </div>

                        <!-- Endereço -->
                        <div class="md:col-span-2">
                            <label for="address" class="block text-sm font-medium app-muted mb-2">
                                Logradouro
                            </label>
                            <input 
                                type="text" 
                                name="address" 
                                id="address"
                                value="{{ old('address') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="Rua, Avenida, etc"
                            >
                        </div>

                        <!-- Número -->
                        <div>
                            <label for="address_number" class="block text-sm font-medium app-muted mb-2">
                                Número
                            </label>
                            <input 
                                type="text" 
                                name="address_number" 
                                id="address_number"
                                value="{{ old('address_number') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="123"
                            >
                        </div>

                        <!-- Complemento -->
                        <div class="md:col-span-2">
                            <label for="address_complement" class="block text-sm font-medium app-muted mb-2">
                                Complemento
                            </label>
                            <input 
                                type="text" 
                                name="address_complement" 
                                id="address_complement"
                                value="{{ old('address_complement') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="Apto, Sala, etc"
                            >
                        </div>

                        <!-- Bairro -->
                        <div>
                            <label for="neighborhood" class="block text-sm font-medium app-muted mb-2">
                                Bairro
                            </label>
                            <input 
                                type="text" 
                                name="neighborhood" 
                                id="neighborhood"
                                value="{{ old('neighborhood') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="Centro"
                            >
                        </div>

                        <!-- Cidade -->
                        <div>
                            <label for="city" class="block text-sm font-medium app-muted mb-2">
                                Cidade
                            </label>
                            <input 
                                type="text" 
                                name="city" 
                                id="city"
                                value="{{ old('city') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="São Paulo"
                            >
                        </div>

                        <!-- Estado -->
                        <div>
                            <label for="state" class="block text-sm font-medium app-muted mb-2">
                                Estado
                            </label>
                            <select 
                                name="state" 
                                id="state"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                                <option value="">Selecione</option>
                                <option value="AC">AC</option>
                                <option value="AL">AL</option>
                                <option value="AP">AP</option>
                                <option value="AM">AM</option>
                                <option value="BA">BA</option>
                                <option value="CE">CE</option>
                                <option value="DF">DF</option>
                                <option value="ES">ES</option>
                                <option value="GO">GO</option>
                                <option value="MA">MA</option>
                                <option value="MT">MT</option>
                                <option value="MS">MS</option>
                                <option value="MG">MG</option>
                                <option value="PA">PA</option>
                                <option value="PB">PB</option>
                                <option value="PR">PR</option>
                                <option value="PE">PE</option>
                                <option value="PI">PI</option>
                                <option value="RJ">RJ</option>
                                <option value="RN">RN</option>
                                <option value="RS">RS</option>
                                <option value="RO">RO</option>
                                <option value="RR">RR</option>
                                <option value="SC">SC</option>
                                <option value="SP">SP</option>
                                <option value="SE">SE</option>
                                <option value="TO">TO</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Seção: Observações -->
                <div>
                    <h3 class="text-lg font-semibold app-strong mb-4 app-border pb-2">Informações Adicionais</h3>
                    <div class="grid grid-cols-1 gap-6">
                        <!-- Observações -->
                        <div>
                            <label for="notes" class="block text-sm font-medium app-muted mb-2">
                                Observações
                            </label>
                            <textarea 
                                name="notes" 
                                id="notes"
                                rows="4"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="Informações adicionais sobre o fornecedor">{{ old('notes') || '' }}</textarea>
                        </div>

                        <!-- Status -->
                        <div>
                            <div class="flex items-center">                            
                                <input 
                                    type="checkbox" 
                                    name="active" 
                                    id="active" 
                                    value="true"
                                    checked
                                    class="h-4 w-4 text-accent-600 focus:ring-accent-500 app-border rounded"
                                >
                                <label for="active" class="ml-2 block text-sm app-text">
                                    Fornecedor ativo
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex justify-end space-x-4 pt-6 app-border">
                    <a href="/almoxarifado/fornecedores" class="px-4 py-2 text-sm font-medium app-text bg-white app-border rounded-lg hover:bg-industrial-50">
                        Cancelar
                    </a>
                    <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-accent-600 border border-transparent rounded-lg hover:bg-accent-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-500">
                        Cadastrar Fornecedor
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        // Funções de formatação
        const formatters = {
            cnpj: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length <= 14) {
                    return numbers.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2}).*/, '$1.$2.$3/$4-$5');
                }
                return value;
            },
            cpf: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length <= 11) {
                    return numbers.replace(/^(\d{3})(\d{3})(\d{3})(\d{2}).*/, '$1.$2.$3-$4');
                }
                return value;
            },
            cep: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length <= 8) {
                    return numbers.replace(/^(\d{5})(\d{3}).*/, '$1-$2');
                }
                return value;
            },
            phone: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length === 11) {
                    return numbers.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
                } else if (numbers.length === 10) {
                    return numbers.replace(/^(\d{2})(\d{4})(\d{4}).*/, '($1) $2-$3');
                }
                return value;
            }
        };

        // Funções de validação
        const validators = {
            cnpj: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length !== 14) return { valid: false, message: 'CNPJ deve ter 14 dígitos' };
                if (/^(\d)\1+$/.test(numbers)) return { valid: false, message: 'CNPJ inválido' };
                
                let size = numbers.length - 2;
                let nums = numbers.substring(0, size);
                const digits = numbers.substring(size);
                let sum = 0;
                let pos = size - 7;
                
                for (let i = size; i >= 1; i--) {
                    sum += nums.charAt(size - i) * pos--;
                    if (pos < 2) pos = 9;
                }
                
                let result = sum % 11 < 2 ? 0 : 11 - (sum % 11);
                if (result != digits.charAt(0)) return { valid: false, message: 'CNPJ inválido' };
                
                size = size + 1;
                nums = numbers.substring(0, size);
                sum = 0;
                pos = size - 7;
                
                for (let i = size; i >= 1; i--) {
                    sum += nums.charAt(size - i) * pos--;
                    if (pos < 2) pos = 9;
                }
                
                result = sum % 11 < 2 ? 0 : 11 - (sum % 11);
                if (result != digits.charAt(1)) return { valid: false, message: 'CNPJ inválido' };
                
                return { valid: true, message: 'CNPJ válido' };
            },
            cpf: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length !== 11) return { valid: false, message: 'CPF deve ter 11 dígitos' };
                if (/^(\d)\1+$/.test(numbers)) return { valid: false, message: 'CPF inválido' };
                
                let sum = 0;
                for (let i = 0; i < 9; i++) {
                    sum += parseInt(numbers.charAt(i)) * (10 - i);
                }
                let digit = 11 - (sum % 11);
                if (digit === 10 || digit === 11) digit = 0;
                if (digit !== parseInt(numbers.charAt(9))) return { valid: false, message: 'CPF inválido' };
                
                sum = 0;
                for (let i = 0; i < 10; i++) {
                    sum += parseInt(numbers.charAt(i)) * (11 - i);
                }
                digit = 11 - (sum % 11);
                if (digit === 10 || digit === 11) digit = 0;
                if (digit !== parseInt(numbers.charAt(10))) return { valid: false, message: 'CPF inválido' };
                
                return { valid: true, message: 'CPF válido' };
            },
            cep: (value) => {
                if (!value) return { valid: true, message: '' };
                const numbers = value.replace(/\D/g, '');
                if (numbers.length !== 8) return { valid: false, message: 'CEP deve ter 8 dígitos' };
                return { valid: true, message: 'CEP válido' };
            },
            email: (value) => {
                if (!value) return { valid: true, message: '' };
                const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!regex.test(value)) return { valid: false, message: 'Email inválido' };
                return { valid: true, message: 'Email válido' };
            },
            phone: (value) => {
                if (!value) return { valid: true, message: '' };
                const numbers = value.replace(/\D/g, '');
                if (numbers.length !== 10 && numbers.length !== 11) {
                    return { valid: false, message: 'Telefone deve ter 10 ou 11 dígitos' };
                }
                return { valid: true, message: 'Telefone válido' };
            },
            required: (value) => {
                if (!value || value.trim() === '') {
                    return { valid: false, message: 'Campo obrigatório' };
                }
                return { valid: true, message: '' };
            }
        };

        function showFeedback(input, validation) {
            const existingFeedback = input.parentElement.querySelector('.field-feedback');
            if (existingFeedback) existingFeedback.remove();

            input.classList.remove('border-red-500', 'border-green-500', 'focus:ring-red-500', 'focus:ring-green-500');
            
            if (validation.valid) {
                input.classList.add('border-green-500', 'focus:ring-green-500');
            } else if (validation.message) {
                input.classList.add('border-red-500', 'focus:ring-red-500');
            }

            if (validation.message) {
                const feedback = document.createElement('div');
                feedback.className = `field-feedback text-xs mt-1 ${validation.valid ? 'text-green-600' : 'text-red-600'}`;
                feedback.textContent = validation.message;
                input.parentElement.appendChild(feedback);
            }
        }

        async function buscarCep(cep) {
            const numbers = cep.replace(/\D/g, '');
            if (numbers.length !== 8) return;

            const cepInput = document.getElementById('zip_code');
            const addressInput = document.getElementById('address');
            const neighborhoodInput = document.getElementById('neighborhood');
            const cityInput = document.getElementById('city');
            const stateInput = document.getElementById('state');

            try {
                const response = await fetch(`https://viacep.com.br/ws/${numbers}/json/`);
                const data = await response.json();

                if (!data.erro) {
                    if (data.logradouro && addressInput) addressInput.value = data.logradouro;
                    if (data.bairro && neighborhoodInput) neighborhoodInput.value = data.bairro;
                    if (data.localidade && cityInput) cityInput.value = data.localidade;
                    if (data.uf && stateInput) stateInput.value = data.uf;

                    showFeedback(cepInput, { valid: true, message: 'CEP encontrado' });
                    if (addressInput && !data.logradouro) addressInput.focus();
                } else {
                    showFeedback(cepInput, { valid: false, message: 'CEP não encontrado' });
                }
            } catch (error) {
                showFeedback(cepInput, { valid: false, message: 'Erro ao buscar CEP' });
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Documento (CPF/CNPJ dinâmico)
            const documentInput = document.getElementById('document');
            const documentTypeSelect = document.getElementById('document_type');
            
            documentInput.addEventListener('blur', function() {
                const docType = documentTypeSelect.value;
                if (this.value) {
                    this.value = formatters[docType](this.value);
                    const validation = validators[docType](this.value);
                    showFeedback(this, validation);
                }
            });

            // Mudar placeholder quando trocar tipo
            documentTypeSelect.addEventListener('change', function() {
                documentInput.placeholder = this.value === 'cnpj' ? '00.000.000/0001-00' : '000.000.000-00';
                documentInput.value = '';
                const existingFeedback = documentInput.parentElement.querySelector('.field-feedback');
                if (existingFeedback) existingFeedback.remove();
                documentInput.classList.remove('border-red-500', 'border-green-500');
            });

            // CEP
            const cepInput = document.getElementById('zip_code');
            if (cepInput) {
                cepInput.addEventListener('blur', function() {
                    if (this.value) {
                        this.value = formatters.cep(this.value);
                        const validation = validators.cep(this.value);
                        showFeedback(this, validation);
                        if (validation.valid) buscarCep(this.value);
                    }
                });
            }

            // Telefone
            const phoneInput = document.getElementById('phone');
            if (phoneInput) {
                phoneInput.addEventListener('blur', function() {
                    if (this.value) {
                        this.value = formatters.phone(this.value);
                        const validation = validators.phone(this.value);
                        showFeedback(this, validation);
                    }
                });
            }

            // Email
            const emailInput = document.getElementById('email');
            if (emailInput) {
                emailInput.addEventListener('blur', function() {
                    if (this.value) {
                        const validation = validators.email(this.value);
                        showFeedback(this, validation);
                    }
                });
            }

            // Campos obrigatórios
            ['name'].forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener('blur', function() {
                        const validation = validators.required(this.value);
                        showFeedback(this, validation);
                    });
                }
      });
    });
  </script>
  @include('components/quick_actions')
</body>
</html>