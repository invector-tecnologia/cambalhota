<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Configuração Inicial - Tavolo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="bg-industrial-50 min-h-screen">
    <!-- Navigation Top -->
    <div class="bg-white shadow-sm">
        <div class="px-4 sm:px-6 lg:px-8 py-4 flex items-center">
            <div class="flex items-center gap-3 ml-auto">
                <a href="/login" class="inline-flex items-center gap-2 rounded-md bg-industrial-600 px-4 py-2 text-sm font-semibold text-white hover:bg-industrial-700">
                    Fazer Login
                </a>
                <a href="/" class="inline-flex items-center gap-2 rounded-md bg-industrial-800 px-4 py-2 text-sm font-semibold text-white hover:bg-industrial-700">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
            </div>
        </div>
    </div>

    <div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            <!-- Logo & Header -->
            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-industrial-900">Tavolo</h1>
                <div class="mt-2 h-1 w-16 bg-accent-500 mx-auto"></div>
                <p class="mt-4 app-muted">Sistema de Gestão para Restaurantes</p>
                <h2 class="mt-6 text-2xl font-bold text-industrial-900">Configuração Inicial</h2>
                <p class="mt-2 text-sm app-muted">
                    Configure sua empresa e crie o primeiro usuário administrador
                </p>
            </div>

            <!-- Register Form -->
            <form class="space-y-6" action="/register" method="POST">
                {{ csrfField() }}

                <!-- Empresa Section -->
                <div class="bg-white rounded-lg shadow-sm app-border">
                    <div class="px-6 py-4 border-b border-industrial-200 bg-industrial-50">
                        <h3 class="text-lg font-semibold text-industrial-900">Dados da Empresa</h3>
                    </div>
                    <div class="p-6 space-y-6">
                        <!-- Dados Principais -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Razão Social -->
                            <div class="md:col-span-2">
                                <label for="razao_social" class="block text-sm font-medium app-muted mb-2">
                                    Razão Social * <span class="text-xs text-industrial-400">(será utilizada para emissão de NFC-e)</span>
                                </label>
                                <input id="razao_social" name="razao_social" type="text" required
                                    value="{{ old('razao_social') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="Restaurante Exemplo Ltda">
                            </div>

                            <!-- Nome Fantasia -->
                            <div class="md:col-span-2">
                                <label for="empresa_trade_name" class="block text-sm font-medium app-muted mb-2">
                                    Nome Fantasia
                                </label>
                                <input id="empresa_trade_name" name="empresa_trade_name" type="text"
                                    value="{{ old('empresa_trade_name') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="Restaurante Exemplo">
                            </div>

                            <!-- CNPJ -->
                            <div>
                                <label for="cnpj" class="block text-sm font-medium app-muted mb-2">
                                    CNPJ *
                                </label>
                                <input id="cnpj" name="cnpj" type="text" required
                                    value="{{ old('cnpj') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="00.000.000/0001-00">
                            </div>

                            <!-- IE -->
                            <div>
                                <label for="ie" class="block text-sm font-medium app-muted mb-2">
                                    Inscrição Estadual
                                </label>
                                <input id="ie" name="ie" type="text"
                                    value="{{ old('ie') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="000.000.000.000">
                            </div>

                            <!-- IM -->
                            <div>
                                <label for="im" class="block text-sm font-medium app-muted mb-2">
                                    Inscrição Municipal
                                </label>
                                <input id="im" name="im" type="text"
                                    value="{{ old('im') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="000.000.000">
                            </div>
                        </div>

                        <!-- Endereço -->
                        <div>
                            <h4 class="text-sm font-semibold text-industrial-900 mb-3 border-b pb-2">Endereço</h4>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <!-- CEP -->
                                <div>
                                    <label for="zip_code" class="block text-sm font-medium app-muted mb-2">
                                        CEP *
                                    </label>
                                    <input id="zip_code" name="zip_code" type="text" required
                                        value="{{ old('zip_code') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="00000-000">
                                </div>

                                <!-- Logradouro -->
                                <div class="md:col-span-2">
                                    <label for="address" class="block text-sm font-medium app-muted mb-2">
                                        Logradouro *
                                    </label>
                                    <input id="address" name="address" type="text" required
                                        value="{{ old('address') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="Rua, Avenida, etc">
                                </div>

                                <!-- Número -->
                                <div>
                                    <label for="address_number" class="block text-sm font-medium app-muted mb-2">
                                        Número
                                    </label>
                                    <input id="address_number" name="address_number" type="text"
                                        value="{{ old('address_number') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="123">
                                </div>

                                <!-- Complemento -->
                                <div class="md:col-span-2">
                                    <label for="address_complement" class="block text-sm font-medium app-muted mb-2">
                                        Complemento
                                    </label>
                                    <input id="address_complement" name="address_complement" type="text"
                                        value="{{ old('address_complement') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="Sala, Andar, etc">
                                </div>

                                <!-- Bairro -->
                                <div>
                                    <label for="neighborhood" class="block text-sm font-medium app-muted mb-2">
                                        Bairro *
                                    </label>
                                    <input id="neighborhood" name="neighborhood" type="text" required
                                        value="{{ old('neighborhood') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="Centro">
                                </div>

                                <!-- Cidade -->
                                <div>
                                    <label for="city" class="block text-sm font-medium app-muted mb-2">
                                        Cidade *
                                    </label>
                                    <input id="city" name="city" type="text" required
                                        value="{{ old('city') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="São Paulo">
                                </div>

                                <!-- Estado -->
                                <div>
                                    <label for="state" class="block text-sm font-medium app-muted mb-2">
                                        Estado *
                                    </label>
                                    <select id="state" name="state" required
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                                        <option value="">Selecione</option>
                                        <option value="AC">AC</option>
                                        <option value="AL">AL</option>
                                        <option value="AP">AP</option>
                                        <option value="AM">AM</option>
                                        <option value="BA">BA</option>
                                        <option value="CE">CE</option>
                                        <option value="DF">DF</option>
                                        <option value="ES">ES</option>
                                        <option value="GO">GO</option>
                                        <option value="MA">MA</option>
                                        <option value="MT">MT</option>
                                        <option value="MS">MS</option>
                                        <option value="MG">MG</option>
                                        <option value="PA">PA</option>
                                        <option value="PB">PB</option>
                                        <option value="PR">PR</option>
                                        <option value="PE">PE</option>
                                        <option value="PI">PI</option>
                                        <option value="RJ" selected>RJ</option>
                                        <option value="RN">RN</option>
                                        <option value="RS">RS</option>
                                        <option value="RO">RO</option>
                                        <option value="RR">RR</option>
                                        <option value="SC">SC</option>
                                        <option value="SP">SP</option>
                                        <option value="SE">SE</option>
                                        <option value="TO">TO</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Contato -->
                        <div>
                            <h4 class="text-sm font-semibold text-industrial-900 mb-3 border-b pb-2">Contato</h4>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <!-- Telefone -->
                                <div>
                                    <label for="empresa_phone" class="block text-sm font-medium app-muted mb-2">
                                        Telefone
                                    </label>
                                    <input id="empresa_phone" name="empresa_phone" type="tel"
                                        value="{{ old('empresa_phone') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="(11) 99999-9999">
                                </div>

                                <!-- Email -->
                                <div>
                                    <label for="empresa_email" class="block text-sm font-medium app-muted mb-2">
                                        Email
                                    </label>
                                    <input id="empresa_email" name="empresa_email" type="email"
                                        value="{{ old('empresa_email') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="contato@restaurante.com">
                                </div>

                                <!-- Website -->
                                <div>
                                    <label for="empresa_website" class="block text-sm font-medium app-muted mb-2">
                                        Website
                                    </label>
                                    <input id="empresa_website" name="empresa_website" type="url"
                                        value="{{ old('empresa_website') || '' }}"
                                        class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                        placeholder="https://restaurante.com">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Section -->
                <div class="bg-white rounded-lg shadow-sm app-border">
                    <div class="px-6 py-4 border-b border-industrial-200 bg-industrial-50">
                        <h3 class="text-lg font-semibold text-industrial-900">Administrador Principal</h3>
                    </div>
                    <div class="p-6 space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Nome Completo -->
                            <div class="md:col-span-2">
                                <label for="full_name" class="block text-sm font-medium app-muted mb-2">
                                    Nome Completo *
                                </label>
                                <input id="full_name" name="full_name" type="text" required
                                    value="{{ old('full_name') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="João Silva">
                            </div>

                            <!-- Email -->
                            <div>
                                <label for="email" class="block text-sm font-medium app-muted mb-2">
                                    Email *
                                </label>
                                <input id="email" name="email" type="email" required
                                    value="{{ old('email') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="admin@restaurante.com">
                            </div>

                            <!-- CPF -->
                            <div>
                                <label for="cpf" class="block text-sm font-medium app-muted mb-2">
                                    CPF
                                </label>
                                <input id="cpf" name="cpf" type="text"
                                    value="{{ old('cpf') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="000.000.000-00">
                            </div>

                            <!-- Telefone -->
                            <div>
                                <label for="user_phone" class="block text-sm font-medium app-muted mb-2">
                                    Telefone
                                </label>
                                <input id="user_phone" name="user_phone" type="tel"
                                    value="{{ old('user_phone') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="(11) 99999-9999">
                            </div>

                            <!-- Data de Nascimento -->
                            <div>
                                <label for="birth_date" class="block text-sm font-medium app-muted mb-2">
                                    Data de Nascimento
                                </label>
                                <input id="birth_date" name="birth_date" type="date"
                                    value="{{ old('birth_date') || '' }}"
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                            </div>

                            <!-- Password -->
                            <div>
                                <label for="password" class="block text-sm font-medium app-muted mb-2">
                                    Senha *
                                </label>
                                <input id="password" name="password" type="password" required
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="••••••••">
                            </div>

                            <!-- Confirm Password -->
                            <div>
                                <label for="password_confirmation" class="block text-sm font-medium app-muted mb-2">
                                    Confirmar Senha *
                                </label>
                                <input id="password_confirmation" name="password_confirmation" type="password" required
                                    class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                    placeholder="••••••••">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="flex items-center justify-end">
                    <button type="submit"
                        class="px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-accent-600 hover:bg-accent-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-500 transition duration-150">
                        Configurar Sistema
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Funções de formatação
        const formatters = {
            cnpj: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length <= 14) {
                    return numbers.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2}).*/, '$1.$2.$3/$4-$5');
                }
                return value;
            },
            cpf: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length <= 11) {
                    return numbers.replace(/^(\d{3})(\d{3})(\d{3})(\d{2}).*/, '$1.$2.$3-$4');
                }
                return value;
            },
            cep: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length <= 8) {
                    return numbers.replace(/^(\d{5})(\d{3}).*/, '$1-$2');
                }
                return value;
            },
            phone: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length === 11) {
                    return numbers.replace(/^(\d{2})(\d{5})(\d{4}).*/, '($1) $2-$3');
                } else if (numbers.length === 10) {
                    return numbers.replace(/^(\d{2})(\d{4})(\d{4}).*/, '($1) $2-$3');
                }
                return value;
            }
        };

        // Funções de validação
        const validators = {
            cnpj: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length !== 14) return { valid: false, message: 'CNPJ deve ter 14 dígitos' };
                
                // Validação básica de CNPJ
                if (/^(\d)\1+$/.test(numbers)) return { valid: false, message: 'CNPJ inválido' };
                
                let size = numbers.length - 2;
                let nums = numbers.substring(0, size);
                const digits = numbers.substring(size);
                let sum = 0;
                let pos = size - 7;
                
                for (let i = size; i >= 1; i--) {
                    sum += nums.charAt(size - i) * pos--;
                    if (pos < 2) pos = 9;
                }
                
                let result = sum % 11 < 2 ? 0 : 11 - sum % 11;
                if (result != digits.charAt(0)) return { valid: false, message: 'CNPJ inválido' };
                
                size = size + 1;
                nums = numbers.substring(0, size);
                sum = 0;
                pos = size - 7;
                
                for (let i = size; i >= 1; i--) {
                    sum += nums.charAt(size - i) * pos--;
                    if (pos < 2) pos = 9;
                }
                
                result = sum % 11 < 2 ? 0 : 11 - sum % 11;
                if (result != digits.charAt(1)) return { valid: false, message: 'CNPJ inválido' };
                
                return { valid: true, message: 'CNPJ válido' };
            },
            cpf: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (!numbers || numbers.length === 0) return { valid: true, message: '' }; // Campo opcional
                if (numbers.length !== 11) return { valid: false, message: 'CPF deve ter 11 dígitos' };
                
                // Validação básica de CPF
                if (/^(\d)\1+$/.test(numbers)) return { valid: false, message: 'CPF inválido' };
                
                let sum = 0;
                for (let i = 0; i < 9; i++) {
                    sum += parseInt(numbers.charAt(i)) * (10 - i);
                }
                let digit = 11 - (sum % 11);
                if (digit === 10 || digit === 11) digit = 0;
                if (digit !== parseInt(numbers.charAt(9))) return { valid: false, message: 'CPF inválido' };
                
                sum = 0;
                for (let i = 0; i < 10; i++) {
                    sum += parseInt(numbers.charAt(i)) * (11 - i);
                }
                digit = 11 - (sum % 11);
                if (digit === 10 || digit === 11) digit = 0;
                if (digit !== parseInt(numbers.charAt(10))) return { valid: false, message: 'CPF inválido' };
                
                return { valid: true, message: 'CPF válido' };
            },
            cep: (value) => {
                const numbers = value.replace(/\D/g, '');
                if (numbers.length !== 8) return { valid: false, message: 'CEP deve ter 8 dígitos' };
                return { valid: true, message: 'CEP válido' };
            },
            email: (value) => {
                if (!value) return { valid: false, message: 'Email é obrigatório' };
                const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!regex.test(value)) return { valid: false, message: 'Email inválido' };
                return { valid: true, message: 'Email válido' };
            },
            phone: (value) => {
                if (!value) return { valid: true, message: '' }; // Campo opcional
                const numbers = value.replace(/\D/g, '');
                if (numbers.length !== 10 && numbers.length !== 11) {
                    return { valid: false, message: 'Telefone deve ter 10 ou 11 dígitos' };
                }
                return { valid: true, message: 'Telefone válido' };
            },
            required: (value) => {
                if (!value || value.trim() === '') {
                    return { valid: false, message: 'Campo obrigatório' };
                }
                return { valid: true, message: '' };
            },
            password: (value) => {
                if (!value) return { valid: false, message: 'Senha é obrigatória' };
                if (value.length < 6) return { valid: false, message: 'Senha deve ter no mínimo 6 caracteres' };
                return { valid: true, message: 'Senha válida' };
            },
            passwordConfirmation: (value, originalPassword) => {
                if (!value) return { valid: false, message: 'Confirmação de senha é obrigatória' };
                if (value !== originalPassword) return { valid: false, message: 'As senhas não coincidem' };
                return { valid: true, message: 'Senhas coincidem' };
            }
        };

        // Função para mostrar feedback visual
        function showFeedback(input, validation) {
            // Remove feedback anterior
            const existingFeedback = input.parentElement.querySelector('.field-feedback');
            if (existingFeedback) {
                existingFeedback.remove();
            }

            // Atualiza classes do input
            input.classList.remove('border-red-500', 'border-green-500', 'focus:ring-red-500', 'focus:ring-green-500');
            
            if (validation.valid) {
                input.classList.add('border-green-500', 'focus:ring-green-500');
            } else if (validation.message) {
                input.classList.add('border-red-500', 'focus:ring-red-500');
            }

            // Adiciona mensagem de feedback se houver
            if (validation.message) {
                const feedback = document.createElement('div');
                feedback.className = `field-feedback text-xs mt-1 ${validation.valid ? 'text-green-600' : 'text-red-600'}`;
                feedback.textContent = validation.message;
                input.parentElement.appendChild(feedback);
            }
        }

        // Buscar endereço por CEP
        async function buscarCep(cep) {
            const numbers = cep.replace(/\D/g, '');
            if (numbers.length !== 8) return;

            const cepInput = document.getElementById('zip_code');
            const addressInput = document.getElementById('address');
            const neighborhoodInput = document.getElementById('neighborhood');
            const cityInput = document.getElementById('city');
            const stateInput = document.getElementById('state');

            try {
                const response = await fetch(`https://viacep.com.br/ws/${numbers}/json/`);
                const data = await response.json();

                if (!data.erro) {
                    if (data.logradouro) addressInput.value = data.logradouro;
                    if (data.bairro) neighborhoodInput.value = data.bairro;
                    if (data.localidade) cityInput.value = data.localidade;
                    if (data.uf) stateInput.value = data.uf;

                    showFeedback(cepInput, { valid: true, message: 'CEP encontrado' });
                    addressInput.focus();
                } else {
                    showFeedback(cepInput, { valid: false, message: 'CEP não encontrado' });
                }
            } catch (error) {
                showFeedback(cepInput, { valid: false, message: 'Erro ao buscar CEP' });
            }
        }

        // Configurar campos
        document.addEventListener('DOMContentLoaded', function() {
            // CNPJ
            const cnpjInput = document.getElementById('cnpj');
            cnpjInput.addEventListener('blur', function() {
                this.value = formatters.cnpj(this.value);
                const validation = validators.cnpj(this.value);
                showFeedback(this, validation);
            });

            // CPF
            const cpfInput = document.getElementById('cpf');
            cpfInput.addEventListener('blur', function() {
                if (this.value) {
                    this.value = formatters.cpf(this.value);
                    const validation = validators.cpf(this.value);
                    showFeedback(this, validation);
                }
            });

            // CEP
            const cepInput = document.getElementById('zip_code');
            cepInput.addEventListener('blur', function() {
                this.value = formatters.cep(this.value);
                const validation = validators.cep(this.value);
                showFeedback(this, validation);
                if (validation.valid) {
                    buscarCep(this.value);
                }
            });

            // Telefones
            const phoneInputs = ['empresa_phone', 'user_phone'];
            phoneInputs.forEach(id => {
                const input = document.getElementById(id);
                input.addEventListener('blur', function() {
                    if (this.value) {
                        this.value = formatters.phone(this.value);
                        const validation = validators.phone(this.value);
                        showFeedback(this, validation);
                    }
                });
            });

            // Emails
            const emailInputs = ['email', 'empresa_email'];
            emailInputs.forEach(id => {
                const input = document.getElementById(id);
                input.addEventListener('blur', function() {
                    if (this.value) {
                        const validation = validators.email(this.value);
                        showFeedback(this, validation);
                    }
                });
            });

            // Campos obrigatórios
            const requiredFields = ['razao_social', 'address', 'neighborhood', 'city', 'full_name'];
            requiredFields.forEach(id => {
                const input = document.getElementById(id);
                input.addEventListener('blur', function() {
                    const validation = validators.required(this.value);
                    showFeedback(this, validation);
                });
            });

            // Senha
            const passwordInput = document.getElementById('password');
            passwordInput.addEventListener('blur', function() {
                const validation = validators.password(this.value);
                showFeedback(this, validation);
            });

            // Confirmação de senha
            const passwordConfirmationInput = document.getElementById('password_confirmation');
            passwordConfirmationInput.addEventListener('blur', function() {
                const validation = validators.passwordConfirmation(this.value, passwordInput.value);
                showFeedback(this, validation);
            });

            // Revalidar confirmação quando senha principal mudar
            passwordInput.addEventListener('input', function() {
                if (passwordConfirmationInput.value) {
                    const validation = validators.passwordConfirmation(passwordConfirmationInput.value, this.value);
                    showFeedback(passwordConfirmationInput, validation);
                }
            });
        });
    </script>
</body>
</html>
