  <script>
    document.getElementById('toggleThemePreview').addEventListener('click', function() {
      const grid = document.getElementById('themePreviewGrid');
      const button = this;
      const isHidden = grid.classList.contains('hidden');
      
      if (isHidden) {
        grid.classList.remove('hidden');
        button.innerHTML = '<i class="fas fa-eye-slash"></i><span>Ocultar</span>';
      } else {
        grid.classList.add('hidden');
        button.innerHTML = '<i class="fas fa-eye"></i><span>Mostrar</span>';
      }
    });
  </script>

  <!-- Chart.js Initialization -->
  <script>
    // Mobile menu functionality
    document.addEventListener('DOMContentLoaded', function() {
      const mobileMenuButton = document.querySelector('[type="button"]');
      const sidebar = document.getElementById('sidebar');
      
      if (mobileMenuButton && sidebar) {
        // Create overlay
        const overlay = document.createElement('div');
        overlay.className = 'fixed inset-0 bg-industrial-600 bg-opacity-75 z-20 md:hidden hidden';
        overlay.id = 'sidebar-overlay';
        document.body.appendChild(overlay);

        // Create close button for mobile sidebar
        const closeButton = document.createElement('button');
        closeButton.className = 'absolute top-4 right-4 text-white hover:text-industrial-300 z-30 md:hidden';
        closeButton.id = 'close-sidebar';
        closeButton.innerHTML = '<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';
        sidebar.querySelector('.bg-industrial-800').appendChild(closeButton);

        // Toggle menu function
        function toggleMenu() {
          const isHidden = sidebar.classList.contains('hidden');
          
          if (isHidden) {
            // Open menu
            sidebar.classList.remove('hidden');
            sidebar.classList.add('flex');
            overlay.classList.remove('hidden');
          } else {
            // Close menu
            sidebar.classList.add('hidden');
            sidebar.classList.remove('flex');
            overlay.classList.add('hidden');
          }
        }

        // Event listeners
        mobileMenuButton.addEventListener('click', function() {
          if (window.innerWidth < 768) {
            toggleMenu();
          }
        });

        const closeBtn = document.getElementById('close-sidebar');
        if (closeBtn) {
          closeBtn.addEventListener('click', function() {
            if (window.innerWidth < 768) {
              toggleMenu();
            }
          });
        }

        overlay.addEventListener('click', function() {
          if (window.innerWidth < 768) {
            toggleMenu();
          }
        });

        // On window resize, ensure proper state
        window.addEventListener('resize', function() {
          if (window.innerWidth >= 768) {
            // Desktop: ensure sidebar is visible and overlay hidden
            sidebar.classList.remove('hidden');
            sidebar.classList.add('flex');
            overlay.classList.add('hidden');
          } else {
            // Mobile: ensure sidebar is hidden by default
            sidebar.classList.add('hidden');
            sidebar.classList.remove('flex');
            overlay.classList.add('hidden');
          }
        });
      }
    });

    // Add animation to cards on scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-slideIn');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.animate-slideIn').forEach(el => {
      observer.observe(el);
    });
  </script>

  <!-- Quick Actions Component -->
  @include('components/quick_actions')
