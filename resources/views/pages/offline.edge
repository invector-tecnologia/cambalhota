<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tavolo - Modo Offline</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    html { scroll-behavior: smooth; }
  </style>
</head>
<body class="bg-gradient-to-br from-amber-50 to-orange-50">
  <div class="min-h-screen flex items-center justify-center px-4">
    <div class="max-w-md w-full">
      <!-- Card -->
      <div class="bg-white rounded-2xl shadow-xl p-8 text-center border-l-4 border-yellow-500">
        <!-- Icon -->
        <div class="mb-6">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-yellow-100">
            <i class="fas fa-wifi-slash text-4xl text-yellow-600"></i>
          </div>
        </div>

        <!-- Content -->
        <h1 class="text-3xl font-bold text-slate-900 mb-2">Sem Conexão</h1>
        <p class="text-slate-600 mb-6">
          Parece que você ficou sem acesso à internet. Mas relaxa! 
          <strong>Seus dados estão sendo salvos localmente</strong> e serão sincronizados automaticamente 
          quando a conexão voltar.
        </p>

        <!-- Status Info -->
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-8">
          <div class="flex items-start gap-3">
            <i class="fas fa-lightbulb text-yellow-600 mt-1 flex-shrink-0"></i>
            <div class="text-left">
              <h3 class="font-semibold text-slate-900 mb-1">O que você pode fazer:</h3>
              <ul class="text-sm text-slate-700 space-y-1">
                <li>✓ Visualizar dados já carregados</li>
                <li>✓ Criar e editar dados localmente</li>
                <li>✓ Tudo será sincronizado automaticamente</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Status Monitor -->
        <div class="mb-8">
          <p class="text-sm text-slate-600 mb-3">Status de Sincronização:</p>
          <div class="flex items-center justify-center gap-2 text-sm font-medium">
            <div class="w-3 h-3 rounded-full bg-yellow-500 animate-pulse"></div>
            <span class="text-yellow-700">Aguardando conexão...</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="space-y-3">
          <button onclick="window.location.href='/'" class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium flex items-center justify-center gap-2">
            <i class="fas fa-arrow-left"></i>
            Voltar ao Dashboard
          </button>
          <button onclick="location.reload()" class="w-full px-6 py-3 bg-slate-100 text-slate-900 rounded-lg hover:bg-slate-200 transition font-medium flex items-center justify-center gap-2">
            <i class="fas fa-sync-alt"></i>
            Tentar Conectar Novamente
          </button>
        </div>

        <!-- Help Text -->
        <p class="text-xs text-slate-500 mt-8">
          Você pode continuar usando o sistema. A sincronização acontecerá automaticamente quando voltar online.
        </p>
      </div>

      <!-- Footer Info -->
      <div class="mt-8 text-center text-sm text-slate-600">
        <p>
          <i class="fas fa-info-circle mr-2"></i>
          Tavolo v6.0.0 - Sistema Robusto de Sincronização Offline
        </p>
      </div>
    </div>
  </div>

  <script>
    // Verificar periodicamente se voltou online
    window.addEventListener('online', () => {
      document.querySelector('.animate-pulse').classList.remove('animate-pulse');
      document.querySelector('.animate-pulse').classList.add('hidden');
      
      const message = document.querySelector('span');
      message.textContent = 'Conexão restaurada! Sincronizando...';
      message.parentElement.parentElement.classList.add('text-green-700');
      
      // Redirecionar após 2 segundos
      setTimeout(() => {
        window.location.href = '/';
      }, 2000);
    });

    // Se estiver online, redirecionar
    if (navigator.onLine) {
      window.location.href = '/';
    }
  </script>
</body>
</html>
