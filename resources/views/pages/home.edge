                      <circle cx="145" cy="105" r="8" fill="#10B981" opacity="0.2"/>
                      <text x="145" y="110" text-anchor="middle" font-size="10" fill="#10B981">$</text>
                      
                      <!-- Ícone de notificação -->
                      <circle cx="165" cy="105" r="8" fill="#F59E0B" opacity="0.2"/>
                      <circle cx="168" cy="102" r="2" fill="#F59E0B">
                        <animate attributeName="opacity" values="1;0;1" dur="2s" repeatCount="indefinite"/>
                      </circle>
                    </g>
                    
                    <!-- Partículas flutuantes -->
                    <circle cx="160" cy="50" r="2" fill="#0EA5E9" opacity="0.6">
                      <animate attributeName="cy" values="50;45;50" dur="2s" repeatCount="indefinite"/>
                    </circle>
                    <circle cx="170" cy="80" r="2" fill="#8B5CF6" opacity="0.6">
                      <animate attributeName="cy" values="80;75;80" dur="2.5s" repeatCount="indefinite"/>
                    </circle>
                  </svg>
                  
                  <h3 class="font-semibold text-industrial-900 mb-2">Dashboard Completo</h3>
                  <p class="app-muted text-sm">Acompanhe vendas, estoque e performance em tempo real</p>
