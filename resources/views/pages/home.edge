          <div>
            <h4 class="font-semibold mb-4">Contato</h4>
            <form action="{{ route('home.contact') }}" method="POST" class="space-y-3">
              {{ csrfField() }}
              <input
                type="text"
                name="nome_contato"
                class="w-full rounded-md border border-industrial-700 bg-industrial-800 px-3 py-2 text-sm text-white placeholder-industrial-400 focus:border-brand-500 focus:outline-none"
                placeholder="Seu nome"
                required
              />
              <input
                type="email"
                name="email_contato"
                class="w-full rounded-md border border-industrial-700 bg-industrial-800 px-3 py-2 text-sm text-white placeholder-industrial-400 focus:border-brand-500 focus:outline-none"
                placeholder="Seu e-mail"
                required
              />
              <input
                type="text"
                name="assunto"
                class="w-full rounded-md border border-industrial-700 bg-industrial-800 px-3 py-2 text-sm text-white placeholder-industrial-400 focus:border-brand-500 focus:outline-none"
                placeholder="Assunto"
                required
              />
              <textarea
                name="mensagem"
                rows="3"
                class="w-full rounded-md border border-industrial-700 bg-industrial-800 px-3 py-2 text-sm text-white placeholder-industrial-400 focus:border-brand-500 focus:outline-none"
                placeholder="Conte um pouco sobre sua operação"
