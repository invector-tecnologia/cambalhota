              <div class="bg-white rounded-lg p-8">
                <div class="bg-gradient-to-br from-brand-50 to-accent-50 rounded-lg p-8 text-center">
                  <!-- Ilustração SVG Artística -->
                  <svg viewBox="0 0 200 150" class="w-full h-32 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg">
                    <!-- Fundo com círculos decorativos -->
                    <circle cx="180" cy="20" r="15" fill="#E0F2FE" opacity="0.5"/>
                    <circle cx="20" cy="130" r="20" fill="#DDD6FE" opacity="0.5"/>
                    
                    <!-- Dashboard principal -->
                    <rect x="20" y="30" width="160" height="100" rx="8" fill="white" stroke="#0EA5E9" stroke-width="2"/>
                    
                    <!-- Gráfico de barras -->
                    <rect x="35" y="90" width="15" height="30" rx="2" fill="#0EA5E9" opacity="0.8">
                      <animate attributeName="height" values="30;40;30" dur="2s" repeatCount="indefinite"/>
                      <animate attributeName="y" values="90;80;90" dur="2s" repeatCount="indefinite"/>
                    </rect>
                    <rect x="55" y="75" width="15" height="45" rx="2" fill="#8B5CF6" opacity="0.8">
                      <animate attributeName="height" values="45;55;45" dur="2.5s" repeatCount="indefinite"/>
                      <animate attributeName="y" values="75;65;75" dur="2.5s" repeatCount="indefinite"/>
                    </rect>
                    <rect x="75" y="85" width="15" height="35" rx="2" fill="#0EA5E9" opacity="0.8">
                      <animate attributeName="height" values="35;45;35" dur="1.8s" repeatCount="indefinite"/>
                      <animate attributeName="y" values="85;75;85" dur="1.8s" repeatCount="indefinite"/>
                    </rect>
                    
                    <!-- Gráfico de pizza -->
                    <circle cx="140" cy="70" r="25" fill="none" stroke="#E0F2FE" stroke-width="8"/>
                    <circle cx="140" cy="70" r="25" fill="none" stroke="#0EA5E9" stroke-width="8" 
                            stroke-dasharray="78.5 157" transform="rotate(-90 140 70)">
                      <animateTransform attributeName="transform" type="rotate" 
                                      from="-90 140 70" to="270 140 70" dur="3s" repeatCount="indefinite"/>
                    </circle>
                    
                    <!-- Linha de tendência -->
                    <polyline points="30,55 50,45 70,50 90,40 110,45" 
                              fill="none" stroke="#8B5CF6" stroke-width="2" opacity="0.6"/>
                    <circle cx="30" cy="55" r="3" fill="#8B5CF6"/>
                    <circle cx="50" cy="45" r="3" fill="#8B5CF6"/>
                    <circle cx="70" cy="50" r="3" fill="#8B5CF6"/>
                    <circle cx="90" cy="40" r="3" fill="#8B5CF6"/>
                    <circle cx="110" cy="45" r="3" fill="#8B5CF6">
                      <animate attributeName="r" values="3;5;3" dur="1.5s" repeatCount="indefinite"/>
                    </circle>
                    
                    <!-- Ícones de funcionalidades -->
                    <g opacity="0.8">
