            <ul class="mt-4 space-y-2 text-industrial-300 text-sm">
              <li><i class="fas fa-envelope mr-2"></i> bernardo@invector.com.br</li>
              <li><i class="fas fa-phone mr-2"></i> (21) 979-022-806</li>
            </ul>
          </div>
        </div>
        
        <div class="border-t border-industrial-800 mt-12 pt-8 text-center text-industrial-300">
          <p>&copy; 2026 TAVOLO. Todos os direitos reservados.</p>
        </div>
      </div>
    </footer>

    <!-- Scripts -->
    <script>
      // Smooth scrolling para links internos
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });

      // Analytics (se necessário)
      // gtag('config', 'GA_MEASUREMENT_ID');
    </script>
