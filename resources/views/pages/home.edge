            </ul>
          </div>
          
          <div>
            <h4 class="font-semibold mb-4">Suporte</h4>
            <ul class="space-y-2">
              <li><a href="#" class="text-industrial-300 hover:text-white transition">Central de Ajuda</a></li>
              <li><a href="#" class="text-industrial-300 hover:text-white transition">Documentação</a></li>
              <li><a href="#" class="text-industrial-300 hover:text-white transition">Status do Sistema</a></li>
              <li><a href="#" class="text-industrial-300 hover:text-white transition">Contato</a></li>
            </ul>
