                        <td class="py-3 px-3 app-text font-semibold">{{ row.name }}</td>
                        <td class="py-3 px-3 capitalize app-text">
                          <span class="inline-block px-2 py-1 rounded text-xs @if(row.status === 'Ativo') bg-green-100 text-green-700 @else bg-red-100 text-red-700 @end font-semibold">{{ row.status }}</span>
                        </td>
                        <td class="py-3 px-3 app-text font-semibold">{{ formatCurrency(row.price || 0) }}</td>
                        <td class="py-3 px-3 app-muted text-xs">{{ row.date?.toFormat ? formatDateOnlyTimestamp(row.date) : row.date }}</td>
                      @elseif(modelType === 'suppliers')
                        <!-- Suppliers Row -->
                        <td class="py-3 px-3 app-text font-semibold">{{ row.name }}</td>
                        <td class="py-3 px-3 capitalize app-text">
                          <span class="inline-block px-2 py-1 rounded text-xs @if(row.status === 'Ativo') bg-green-100 text-green-700 @else bg-red-100 text-red-700 @end font-semibold">{{ row.status }}</span>
                        </td>
                        <td class="py-3 px-3 app-muted text-xs truncate">{{ row.email }}</td>
                        <td class="py-3 px-3 app-muted text-xs">{{ row.date?.toFormat ? formatDateOnlyTimestamp(row.date) : row.date }}</td>
                      @elseif(modelType === 'inventory')
                        <!-- Inventory Row -->
                        <td class="py-3 px-3 app-text font-semibold">{{ row.name }}</td>
                        <td class="py-3 px-3 app-text font-semibold @if(row.current <= row.minimum) text-red-600 @end">{{ row.current }}</td>
                        <td class="py-3 px-3 app-text">{{ row.minimum }}</td>
                        <td class="py-3 px-3 app-muted text-xs">{{ row.date?.toFormat ? formatDateTimestamp(row.date) : row.date }}</td>
                      @end
                    </tr>
                  @end
                </tbody>
              </table>
            </div>
            <div class="flex items-center justify-between mt-4 pt-4 app-border-t">
              <div class="flex gap-2">
                @if(pagination.currentPage > 1)
                  <a href="?page={{ pagination.currentPage - 1 }}&per_page={{ pagination.perPage }}&model={{ modelType }}&start_date={{ filters.startDate }}&end_date={{ filters.endDate }}" class="px-3 py-2 app-card app-border rounded text-sm app-text hover:app-accent-bg transition-colors font-semibold">
                    <i class="fas fa-chevron-left mr-1"></i> Anterior
                  </a>
                @end
                @if(pagination.currentPage < pagination.totalPages)
                  <a href="?page={{ pagination.currentPage + 1 }}&per_page={{ pagination.perPage }}&model={{ modelType }}&start_date={{ filters.startDate }}&end_date={{ filters.endDate }}" class="px-3 py-2 app-card app-border rounded text-sm app-text hover:app-accent-bg transition-colors font-semibold">
                    Próxima <i class="fas fa-chevron-right ml-1"></i>
                  </a>
                @end
              </div>
              <span class="text-sm app-muted">Mostrando {{ rows.length }} de {{ pagination.total }}</span>
            </div>
          </div>
        </div>
      </main>
  </div>

  <script>
    // Aguarda Chart.js estar disponível
    function initializeCharts() {
      // Parse dados do servidor (JSON strings injetados como raw)
      let chartData = {{{ charts }}};

      // Gráfico de métodos de pagamento / status
      const paymentCanvas = document.getElementById('paymentChart');
      if (paymentCanvas && chartData && chartData[0] && chartData[0].labels && chartData[0].data) {
        new Chart(paymentCanvas, {
          type: 'pie',
          data: {
            labels: chartData[0].labels,
            datasets: [{
              data: chartData[0].data,
              backgroundColor: ['#10b981', '#3b82f6', '#a855f7', '#f59e0b', '#ec4899', '#06b6d4']
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: { size: 12, weight: '600' }
                }
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return context.label + ': ' + context.parsed + ' transação(ões)';
                  }
                }
              }
            }
          }
        });
      }

      // Gráfico de linha
      const lineCanvas = document.getElementById('lineChart');
      if (lineCanvas && chartData && chartData[1] && chartData[1].labels && chartData[1].data) {
        new Chart(lineCanvas, {
          type: 'line',
          data: {
            labels: chartData[1].labels,
            datasets: [{
              label: 'Dados',
              data: chartData[1].data,
              borderColor: '#2563eb',
              backgroundColor: 'rgba(37, 99, 235, 0.1)',
              borderWidth: 2,
              tension: 0.3,
              fill: true,
              pointRadius: 5,
              pointBackgroundColor: '#2563eb',
              pointBorderColor: '#fff',
              pointBorderWidth: 2,
              pointHoverRadius: 7
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return new Intl.NumberFormat('pt-BR').format(value);
                  },
                  font: { size: 11 }
                }
              },
              x: {
                ticks: {
                  font: { size: 11 }
                }
              }
            },
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: { size: 12, weight: '600' }
                }
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return 'Valor: ' + new Intl.NumberFormat('pt-BR', {
                      minimumFractionDigits: 2,
                      maximumFractionDigits: 2
                    }).format(context.parsed.y);
                  }
                }
              }
            }
          }
        });
      }
    }

    // Verifica se Chart.js está disponível
    if (typeof Chart === 'undefined') {
      console.error('Chart.js não foi carregado');
    } else {
      // Aguarda o DOM estar pronto
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeCharts);
      } else {
        initializeCharts();
      }
    }
  </script>
</body>
</html>
