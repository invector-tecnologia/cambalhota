  <form id="deleteForm" action="{{ route('fiscal.config.page.destroy') }}" method="POST" class="hidden">
    <input type="hidden" name="_method" value="DELETE">
    {{ csrfField() }}
  </form>

  <div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
    <div class="w-full max-w-md rounded-xl bg-white shadow-xl ring-1 ring-industrial-100">
      <div class="border-b border-industrial-100 px-6 py-4">
        <h3 class="text-lg font-semibold text-industrial-900">Confirmar exclusão</h3>
        <p class="text-sm text-industrial-500">Essa ação remove a configuração fiscal atual.</p>
      </div>
      <div class="px-6 py-5 space-y-4 text-sm app-muted">
        <p>Tem certeza que deseja remover esta configuração?</p>
        <div class="flex items-center rounded-md bg-red-50 px-3 py-2 text-red-700">
          <i class="fas fa-triangle-exclamation mr-2"></i>
          <span>Sem uma configuração ativa, a emissão de NFC-e ficará indisponível.</span>
        </div>
      </div>
      <div class="flex justify-end gap-3 border-t border-industrial-100 px-6 py-4 bg-industrial-50">
        <button type="button" onclick="toggleDeleteModal(false)" class="rounded-md bg-white px-3 py-2 text-sm font-semibold app-muted shadow-sm ring-1 ring-inset ring-industrial-200 hover:bg-industrial-100">Cancelar</button>
        <button type="button" onclick="document.getElementById('deleteForm').submit()" class="rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500">Confirmar exclusão</button>
      </div>
    </div>
  </div>

  @include('components/quick_actions')

  <script>
    function toggleDeleteModal(show) {
      const modal = document.getElementById('deleteModal')
      if (show) {
        modal.classList.remove('hidden')
        modal.classList.add('flex')
      } else {
        modal.classList.add('hidden')
        modal.classList.remove('flex')
      }
    }

    function confirmDelete() {
      toggleDeleteModal(true)
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        toggleDeleteModal(false)
      }
    })
  </script>
</body>
</html>
