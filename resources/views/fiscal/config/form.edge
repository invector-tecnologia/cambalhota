  @include('components/quick_actions')

  <script>
    async function suggestNextNfeNumber() {
      const btn = document.getElementById('btn-suggest-nfe')
      const icon = document.getElementById('btn-suggest-icon')
      const text = document.getElementById('btn-suggest-text')
      const input = document.getElementById('next_nfe_number')
      const hint = document.getElementById('nfe-number-hint')

      btn.disabled = true
      icon.className = 'fas fa-spinner fa-spin mr-1.5'
      text.textContent = 'Buscando...'

      try {
        const res = await fetch('/api/fiscal/suggest-next-number', {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin',
        })
        const data = await res.json()

        if (data.error) {
          hint.textContent = 'Erro: ' + data.error
          hint.classList.add('text-red-600')
          hint.classList.remove('text-green-700', 'text-industrial-500')
          return
        }

        input.value = data.suggestedNumber
        hint.classList.remove('text-red-600', 'text-industrial-500')
        hint.classList.add('text-green-700')

        if (data.maxNumero > 0) {
          hint.textContent = 'Última nota emitida: nº ' + data.maxNumero + ' → próximo sugerido: ' + data.suggestedNumber
        } else {
          hint.textContent = 'Nenhuma nota emitida ainda. Sugerido: ' + data.suggestedNumber
        }
      } catch (err) {
        hint.textContent = 'Erro ao consultar: ' + err.message
        hint.classList.add('text-red-600')
        hint.classList.remove('text-green-700', 'text-industrial-500')
      } finally {
        btn.disabled = false
        icon.className = 'fas fa-magic mr-1.5'
        text.textContent = 'Preencher'
      }
    }
  </script>
</body>
</html>
