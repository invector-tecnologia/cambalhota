</div>

{{-- JavaScript para auto-detectar autorizador --}}
<script>
document.addEventListener('DOMContentLoaded', function() {
  const stateSelect = document.getElementById('state_override');
  const autorizadorDisplay = document.getElementById('autorizador-display');
  const empresaState = '{{ empresa.state || "SP" }}';
  
  // Mapeamento UF -> Autorizador (sincronizado com backend)
  const autorizadorMap = {
    // SVRS
    'AC': 'SVRS', 'AL': 'SVRS', 'AP': 'SVRS', 'DF': 'SVRS',
    'ES': 'SVRS', 'PB': 'SVRS', 'RJ': 'SVRS', 'RN': 'SVRS',
    'RO': 'SVRS', 'RR': 'SVRS', 'SC': 'SVRS', 'SE': 'SVRS', 'TO': 'SVRS',
    // SVAN
    'MA': 'SVAN',
    // SEFAZ PRÓPRIA
    'AM': 'SEFAZ-AM', 'BA': 'SEFAZ-BA', 'CE': 'SEFAZ-CE',
    'GO': 'SEFAZ-GO', 'MG': 'SEFAZ-MG', 'MS': 'SEFAZ-MS',
    'MT': 'SEFAZ-MT', 'PA': 'SEFAZ-PA', 'PE': 'SEFAZ-PE',
    'PI': 'SEFAZ-PI', 'PR': 'SEFAZ-PR', 'RS': 'SEFAZ-RS', 'SP': 'SEFAZ-SP'
  };
  
  function updateAutorizador() {
    const selectedUf = stateSelect.value || empresaState;
    const autorizador = autorizadorMap[selectedUf] || 'SVRS';
    autorizadorDisplay.value = autorizador;
    
    // Adicionar classe de destaque
    autorizadorDisplay.classList.remove('border-success', 'border-warning');
    autorizadorDisplay.classList.add(stateSelect.value ? 'border-warning' : 'border-success');
  }
  
  stateSelect.addEventListener('change', updateAutorizador);
  updateAutorizador(); // Executar ao carregar
});
</script>
@end
