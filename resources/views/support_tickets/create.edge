      <form method="POST" action="{{ route('supportTickets.store') }}" class="space-y-4 bg-white p-6 rounded-lg border border-industrial-100">
      {{ csrfField() }}
      <div>
        <label class="block text-sm font-medium mb-1">Assunto</label>
        <input type="text" name="assunto" required class="w-full rounded-md border-industrial-300 focus:border-red-700 focus:ring-red-700" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Categoria</label>
        <select name="categoria" class="w-full rounded-md border-industrial-300 focus:border-red-700 focus:ring-red-700">
          <option value="duvida">Dúvida</option>
          <option value="erro">Erro</option>
          <option value="financeiro">Financeiro</option>
          <option value="fiscal">Fiscal</option>
          <option value="outro">Outro</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Prioridade</label>
        <select name="prioridade" class="w-full rounded-md border-industrial-300 focus:border-red-700 focus:ring-red-700">
          <option value="baixa">Baixa</option>
          <option value="media" selected>Média</option>
          <option value="alta">Alta</option>
          <option value="urgente">Urgente</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Mensagem</label>
        <textarea name="mensagem" rows="8" required class="w-full rounded-md border-industrial-300 focus:border-red-700 focus:ring-red-700"></textarea>
      </div>
      <div class="flex justify-end gap-3">
        <a href="{{ route('supportTickets.index') }}" class="px-4 py-2 rounded-md border border-industrial-300 text-sm">Cancelar</a>
        <button type="submit" class="px-4 py-2 rounded-md bg-red-700 text-white text-sm font-semibold hover:bg-red-800">Enviar Ticket</button>
      </div>
      </form>
