            <a href="{{ route('dashboard.index') }}"
              class="inline-flex items-center gap-2 rounded-lg bg-industrial-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-industrial-400">
              <i class="fas fa-home mr-2"></i> Dashboard
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
        @if(flashMessages.has('success'))
          <div class="mb-6 rounded-lg bg-green-50 p-4 text-sm text-green-800 ring-1 ring-green-200">{{ flashMessages.get('success') }}</div>
        @end

        @if(flashMessages.has('error'))
          <div class="mb-6 rounded-lg bg-red-50 p-4 text-sm text-red-800 ring-1 ring-red-200">{{ flashMessages.get('error') }}</div>
        @end

        @if(unreadCount > 0)
          <div class="mb-6 rounded-lg bg-blue-50 p-4 text-sm text-blue-800 ring-1 ring-blue-200">
            Você possui {{ unreadCount }} resposta(s) novas do suporte.
          </div>
        @end

        <div class="bg-white shadow-sm rounded-xl ring-1 ring-industrial-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-industrial-100">
            <h2 class="text-lg font-semibold text-industrial-900">Lista de Tickets</h2>
          </div>

          @if(tickets.data && tickets.data.length > 0)
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-industrial-100">
                <thead class="bg-industrial-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Protocolo</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Assunto</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Atualizado</th>
                    <th class="relative px-6 py-3"><span class="sr-only">Ações</span></th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-industrial-100">
                  @each(ticket in tickets.data)
                    <tr class="hover:bg-industrial-50">
                      <td class="px-6 py-4 text-sm font-semibold text-industrial-900">{{ ticket.protocolo || ('SUP-' + ticket.id) }}</td>
                      <td class="px-6 py-4 text-sm text-industrial-900">{{ ticket.assunto }}</td>
                      <td class="px-6 py-4 text-sm">
                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold {{ ticket.status === 'resolvido' ? 'bg-green-50 text-green-700' : ticket.status === 'cancelado' ? 'bg-red-50 text-red-700' : 'bg-yellow-50 text-yellow-700' }}">
                          {{ ticket.status }}
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm app-muted">{{ ticket.updatedAt || '-' }}</td>
                      <td class="px-6 py-4 text-right text-sm font-medium">
                        <a href="{{ route('supportTickets.show', { id: ticket.id }) }}" class="text-accent-600 hover:text-accent-500">Abrir</a>
                      </td>
                    </tr>
                  @end
                </tbody>
              </table>
            </div>
          @else
            <div class="text-center py-12">
              <i class="fas fa-life-ring text-6xl text-industrial-200 mb-4"></i>
              <h3 class="mt-2 text-sm font-semibold text-industrial-900">Nenhum ticket encontrado</h3>
              <p class="mt-1 text-sm text-industrial-500">Abra um ticket para conversar com o suporte.</p>
              <div class="mt-6">
                <a href="{{ route('supportTickets.create') }}" class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-500">
                  <i class="fas fa-plus"></i>
                  Novo Ticket
                </a>
              </div>
            </div>
