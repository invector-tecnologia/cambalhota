<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-industrial-50">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ticket {{ ticket.protocolo || ('SUP-' + ticket.id) }}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="h-full font-sans text-industrial-900">
  <div class="min-h-full">
    <header class="app-bg app-border-b sticky top-0 z-20">
      <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <i class="fas fa-life-ring app-text text-xl"></i>
          <div>
            <h1 class="text-lg font-semibold app-text">Suporte</h1>
            <p class="text-xs app-muted">Conversa do ticket {{ ticket.protocolo || ('SUP-' + ticket.id) }}</p>
          </div>
        </div>
        <a href="{{ route('dashboard.index') }}"
          class="inline-flex items-center gap-2 rounded-lg bg-industrial-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-industrial-500">
          <i class="fas fa-home"></i> Dashboard
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-5xl py-8 px-4">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold">Ticket {{ ticket.protocolo || ('SUP-' + ticket.id) }}</h2>
        <a href="{{ route('supportTickets.index') }}" class="text-sm text-red-700 hover:text-red-800">Voltar</a>
      </div>

    @if(flashMessages.has('success'))
      <div class="mb-4 rounded-md bg-green-50 p-3 text-sm text-green-800">{{ flashMessages.get('success') }}</div>
    @end
    @if(flashMessages.has('error'))
      <div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">{{ flashMessages.get('error') }}</div>
    @end

    <div class="bg-white rounded-lg border border-industrial-100 p-4 mb-4">
      <p class="text-sm"><span class="font-semibold">Assunto:</span> {{ ticket.assunto }}</p>
      <p class="text-sm"><span class="font-semibold">Status:</span> {{ ticket.status }}</p>
      <p class="text-sm"><span class="font-semibold">Prioridade:</span> {{ ticket.prioridade }}</p>
    </div>

    <div class="bg-white rounded-lg border border-industrial-100 p-4 mb-4">
      <h2 class="text-sm font-semibold mb-3">Conversa</h2>
      <div class="space-y-3 max-h-[420px] overflow-y-auto">
        @if(mensagens && mensagens.length > 0)
          @each(msg in mensagens)
            <div class="rounded-md p-3 {{ msg.senderTipo === 'usuario' ? 'bg-blue-50 border border-blue-100' : msg.senderTipo === 'admin' ? 'bg-emerald-50 border border-emerald-100' : 'bg-industrial-50 border border-industrial-100' }}">
              <div class="text-xs mb-1 text-industrial-500">{{ msg.senderTipo }} • {{ msg.createdAt || '-' }}</div>
              <p class="text-sm whitespace-pre-wrap">{{ msg.mensagem }}</p>
            </div>
          @end
        @else
          <p class="text-sm text-industrial-500">Sem mensagens no ticket.</p>
        @end
      </div>
    </div>

    @if(ticket.status !== 'resolvido' && ticket.status !== 'fechado' && ticket.status !== 'cancelado')
      <form method="POST" action="{{ route('supportTickets.reply', { id: ticket.id }) }}" class="bg-white rounded-lg border border-industrial-100 p-4 mb-4">
        {{ csrfField() }}
        <label class="block text-sm font-medium mb-1">Responder</label>
        <textarea name="mensagem" rows="4" required class="w-full rounded-md border-industrial-300 focus:border-red-700 focus:ring-red-700"></textarea>
        <div class="mt-3 flex justify-end">
          <button type="submit" class="px-4 py-2 rounded-md bg-red-700 text-white text-sm font-semibold hover:bg-red-800">Enviar Resposta</button>
        </div>
      </form>

      <div class="flex flex-wrap gap-3">
        <form method="POST" action="{{ route('supportTickets.cancel', { id: ticket.id }) }}" onsubmit="return confirm('Cancelar este ticket?')">
          {{ csrfField() }}
          <button type="submit" class="px-4 py-2 rounded-md border border-red-300 text-red-700 text-sm">Cancelar Ticket</button>
        </form>

        @if(ticket.status === 'sugestao_solucao')
          <form method="POST" action="{{ route('supportTickets.confirmSolution', { id: ticket.id }) }}">
            {{ csrfField() }}
            <button type="submit" class="px-4 py-2 rounded-md bg-green-700 text-white text-sm">Confirmar Solução</button>
          </form>

          <form method="POST" action="{{ route('supportTickets.rejectSolution', { id: ticket.id }) }}">
            {{ csrfField() }}
            <button type="submit" class="px-4 py-2 rounded-md bg-yellow-600 text-white text-sm">Não Resolvido</button>
          </form>
        @end
      </div>
    @end
    </main>
  </div>
</body>
</html>
