<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrfToken }}">
  <title>Editar Usuário - Tavolo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="h-full font-sans text-industrial-900">
  <div class="min-h-full">
    <header class="bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <h1 class="text-xl font-semibold leading-6 text-industrial-900">Editar Usuário</h1>
          <div class="flex items-center space-x-4 ml-auto">
            <a href="{{ route('users.index') }}"
              class="inline-flex items-center rounded-md bg-industrial-800 px-3 py-2 text-sm font-semibold text-white  hover:bg-industrial-500">
              <i class="fas fa-arrow-left mr-2"></i> Usuários
            </a>
          </div>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg">
          <div class="p-6">
            <form action="{{ route('users.update', [user.id]) }}" method="POST">
              {{ csrfField() }}
              @!method('PUT')
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                  <label class="block text-sm font-medium app-muted">Nome *</label>
                  <input type="text" name="name"
                    class="mt-1 block w-full rounded-md border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm"
                    value="{{ user.name }}" required>
                </div>
                <div>
                  <label class="block text-sm font-medium app-muted">Email *</label>
                  <input type="email" name="email"
                    class="mt-1 block w-full rounded-md border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm"
                    value="{{ user.email }}" required>
                </div>
                <div>
                  <label class="block text-sm font-medium app-muted">Nova Senha (deixe em branco para
                    manter)</label>
                  <input type="password" name="password"
                    class="mt-1 block w-full rounded-md border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
                </div>
                <div>
                  <label class="block text-sm font-medium app-muted">Função</label>
                  <select name="role"
                    class="mt-1 block w-full rounded-md border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
                    <option value="waiter" {{ user.role==='waiter' ? 'selected' : '' }}>Garçom</option>
                    <option value="manager" {{ user.role==='manager' ? 'selected' : '' }}>Gerente</option>
                    <option value="admin" {{ user.role==='admin' ? 'selected' : '' }}>Admin</option>
                  </select>
                </div>
                <div class="md:col-span-2">
                  <div class="flex items-center">
                    <input type="checkbox" name="isActive"
                      class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500" {{ user.isActive
                      ? 'checked' : '' }}>
                    <label class="ml-2 block text-sm text-industrial-900">Ativo</label>
                  </div>
                </div>
                <div class="md:col-span-2">
                  <div class="flex justify-end space-x-3">
                    <a href="{{ route('users.index') }}"
                      class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold app-text ring-1 ring-inset ring-industrial-200 hover:bg-industrial-50">
                      <i class="fas fa-arrow-left mr-2"></i> Usuários
                    </a>
                    <button type="submit"
                      class="inline-flex items-center rounded-md bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">Salvar</button>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    const validators = {
      email: (value) => {
        if (!value) return { valid: false, message: 'Email é obrigatório' };
        const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!regex.test(value)) return { valid: false, message: 'Email inválido' };
        return { valid: true, message: 'Email válido' };
      },
      passwordOptional: (value) => {
        if (!value) return { valid: true, message: '' };
        if (value.length < 6) return { valid: false, message: 'Senha deve ter no mínimo 6 caracteres' };
        return { valid: true, message: 'Senha válida' };
      },
      required: (value) => {
        if (!value || value.trim() === '') {
          return { valid: false, message: 'Campo obrigatório' };
        }
        return { valid: true, message: '' };
      }
    };

    function showFeedback(input, validation) {
      const existingFeedback = input.parentElement.querySelector('.field-feedback');
      if (existingFeedback) existingFeedback.remove();

      input.classList.remove('border-red-500', 'border-green-500', 'focus:ring-red-500', 'focus:ring-green-500');
      
      if (validation.valid && validation.message) {
        input.classList.add('border-green-500', 'focus:ring-green-500');
      } else if (!validation.valid) {
        input.classList.add('border-red-500', 'focus:ring-red-500');
      }

      if (validation.message) {
        const feedback = document.createElement('div');
        feedback.className = `field-feedback text-xs mt-1 ${validation.valid ? 'text-green-600' : 'text-red-600'}`;
        feedback.textContent = validation.message;
        input.parentElement.appendChild(feedback);
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const emailInput = document.querySelector('[name="email"]');
      if (emailInput) {
        emailInput.addEventListener('blur', function() {
          const validation = validators.email(this.value);
          showFeedback(this, validation);
        });
      }

      const passwordInput = document.querySelector('[name="password"]');
      if (passwordInput) {
        passwordInput.addEventListener('blur', function() {
          if (this.value) {
            const validation = validators.passwordOptional(this.value);
            showFeedback(this, validation);
          }
        });
      }

      const nameInput = document.querySelector('[name="name"]');
      if (nameInput) {
        nameInput.addEventListener('blur', function() {
          const validation = validators.required(this.value);
          showFeedback(this, validation);
        });
      }
    });
  </script>
  @include('components/quick_actions')
</body>
</html>