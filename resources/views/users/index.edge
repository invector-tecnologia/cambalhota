</head>
<body class="h-full font-sans text-industrial-900">
  <div class="min-h-full">
    <header class="bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div>
            <h1 class="text-xl font-semibold leading-6 text-industrial-900">Usuários</h1>
          </div>
          <div class="flex items-center space-x-4 ml-auto">
            <a href="{{ route('users.create') }}"
              class="inline-flex items-center rounded-md bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
              <i class="fas fa-plus -ml-0.5 mr-1.5"></i> Novo Usuário
            </a>
            <a href="{{ route('dashboard.index') }}"
              class="inline-flex items-center rounded-md bg-industrial-800 px-3 py-2 text-sm font-semibold text-white  hover:bg-industrial-500">
              <i class="fas fa-home mr-2"></i> Dashboard
            </a>
          </div>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg">
          <div class="px-6 py-4 border-b border-industrial-100">
            <h2 class="text-lg font-medium text-industrial-900">Gerenciar Usuários</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-industrial-100">
              <thead class="bg-industrial-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-industrial-500 uppercase tracking-wider">Nome</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-industrial-500 uppercase tracking-wider">Email</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-industrial-500 uppercase tracking-wider">Função</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-industrial-500 uppercase tracking-wider">Status</th>
                  <th class="relative px-6 py-3"><span class="sr-only">Ações</span></th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-industrial-100">
                @each(user in users.data || [])
                <tr class="hover:bg-industrial-50">
                  <td class="px-6 py-4 text-sm font-medium text-industrial-900">{{ user.name }}</td>
                  <td class="px-6 py-4 text-sm text-industrial-500">{{ user.email }}</td>
                  <td class="px-6 py-4 text-sm text-industrial-500">{{ user.role }}</td>
                  <td class="px-6 py-4">
                    <span
                      class="inline-flex rounded-full px-2 py-1 text-xs font-semibold {{ user.isActive ? 'bg-green-100 text-green-800' : 'bg-industrial-100 app-muted' }}">
                      {{ user.isActive ? 'Ativo' : 'Inativo' }}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right text-sm font-medium">
                    <a href="{{ route('users.edit', [user.id]) }}" class="text-accent-600 hover:text-accent-900">
                      <i class="fas fa-edit"></i>
                    </a>
                  </td>
                </tr>
                @end
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
