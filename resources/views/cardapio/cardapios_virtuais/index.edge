        @if(cardapiosVirtuais.length > 0)
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @each(cardapioVirtual in cardapiosVirtuais)
              <div class="bg-white shadow-sm rounded-xl ring-1 ring-industrial-100 p-6">
                <div class="flex justify-between items-start mb-4">
                  <h3 class="text-lg font-semibold text-industrial-900">{{ cardapioVirtual.title }}</h3>
                  @if(cardapioVirtual.status === 'published')
                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-green-50 text-green-700">Publicado</span>
                  @else
                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-yellow-50 text-yellow-700">Rascunho</span>
                  @endif
                </div>
                
                @if(cardapioVirtual.description)
                  <p class="text-sm app-muted mb-4">{{ cardapioVirtual.description }}</p>
                @endif
                
                <div class="flex gap-2">
                  <a href="{{ route('cardapios_virtuais.show', {id: cardapioVirtual.id}) }}" class="flex-1 text-center rounded-lg bg-accent-600 px-3 py-2 text-sm font-semibold text-white hover:bg-accent-500">Gerenciar</a>
                  @if(cardapioVirtual.status === 'published')
                    <a href="{{ route('cardapios_virtuais.public', {slug: cardapioVirtual.slug}) }}" target="_blank" class="flex-1 text-center rounded-lg bg-industrial-800 px-3 py-2 text-sm font-semibold text-white hover:bg-industrial-700">Ver Público</a>
