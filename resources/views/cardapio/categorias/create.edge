    <script>
        // Funções de validação
        function showError(fieldId, message) {
            const errorElement = document.getElementById(`${fieldId}-error`);
            const inputElement = document.getElementById(fieldId);
            if (errorElement && inputElement) {
                errorElement.textContent = message;
                errorElement.classList.remove('hidden');
                inputElement.classList.add('border-red-500');
                inputElement.classList.remove('border-industrial-300');
            }
        }

        function clearError(fieldId) {
            const errorElement = document.getElementById(`${fieldId}-error`);
            const inputElement = document.getElementById(fieldId);
            if (errorElement && inputElement) {
                errorElement.textContent = '';
                errorElement.classList.add('hidden');
                inputElement.classList.remove('border-red-500');
                inputElement.classList.add('border-industrial-300');
            }
        }

        function validateName() {
            const nameInput = document.getElementById('name');
            const value = nameInput.value.trim();
            
            if (!value) {
                showError('name', 'O nome da categoria é obrigatório.');
                return false;
            }
            
            if (value.length < 2) {
                showError('name', 'O nome deve ter no mínimo 2 caracteres.');
                return false;
            }
            
            if (value.length > 100) {
                showError('name', 'O nome deve ter no máximo 100 caracteres.');
                return false;
            }
            
            clearError('name');
            return true;
        }

        function validateDescription() {
            const descInput = document.getElementById('description');
            const value = descInput.value.trim();
            
            if (value && value.length > 500) {
                showError('description', 'A descrição deve ter no máximo 500 caracteres.');
                return false;
            }
            
            clearError('description');
            return true;
        }

        function validateColor() {
            const colorInput = document.getElementById('color');
            const value = colorInput.value;
            
            if (!value || !/^#[0-9A-F]{6}$/i.test(value)) {
                showError('color', 'Selecione uma cor válida.');
                return false;
            }
            
            clearError('color');
            return true;
        }

        function validateSortOrder() {
            const sortInput = document.getElementById('sort_order');
            const value = sortInput.value;
            
            if (!value || isNaN(value)) {
                showError('sort_order', 'A ordem deve ser um número válido.');
                return false;
            }
            
            if (parseInt(value) < 0) {
                showError('sort_order', 'A ordem deve ser maior ou igual a 0.');
                return false;
            }
            
            clearError('sort_order');
            return true;
        }

        // Adicionar validações on blur
        document.getElementById('name').addEventListener('blur', validateName);
        document.getElementById('description').addEventListener('blur', validateDescription);
        document.getElementById('color').addEventListener('blur', validateColor);
        document.getElementById('sort_order').addEventListener('blur', validateSortOrder);

        // Color picker
        const colorInput = document.getElementById('color');
        const colorHex = document.getElementById('colorHex');
        
        if (colorInput && colorHex) {
            colorInput.addEventListener('input', function() {
                colorHex.textContent = this.value.toUpperCase();
            });
        }

        // Toggle time restriction fields
        const hasTimeRestriction = document.getElementById('hasTimeRestriction');
        const timeRestrictionFields = document.getElementById('timeRestrictionFields');
        
        if (hasTimeRestriction && timeRestrictionFields) {
            hasTimeRestriction.addEventListener('change', function() {
                if (this.checked) {
                    timeRestrictionFields.classList.remove('hidden');
                } else {
                    timeRestrictionFields.classList.add('hidden');
                    document.getElementById('available_from').value = '';
                    document.getElementById('available_until').value = '';
                }
            });
        }

        // Form validation
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                console.log('🔍 Validando formulário de categoria...');
                
                let isValid = true;
                
                // Validar todos os campos
                if (!validateName()) isValid = false;
                if (!validateDescription()) isValid = false;
                if (!validateColor()) isValid = false;
                if (!validateSortOrder()) isValid = false;

                if (hasTimeRestriction && hasTimeRestriction.checked) {
                    const startTime = document.getElementById('available_from').value;
                    const endTime = document.getElementById('available_until').value;
                    
                    if (startTime && endTime && startTime >= endTime) {
                        e.preventDefault();
                        alert('O horário de início deve ser anterior ao horário de fim.');
                        document.getElementById('available_from').focus();
                        isValid = false;
                    }
                }
                
                if (!isValid) {
                    e.preventDefault();
                    console.log('❌ Validação falhou, formulário não enviado');
                    return;
                }
                
                console.log('✅ Validação passou, enviando formulário...');
            });
        }
    </script>
    @include('components/quick_actions')
</body>
</html>
