                    <th class="relative px-6 py-3"><span class="sr-only">Ções</span></th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-industrial-100">
                  @each(categoria in categorias)
                    <tr class="hover:bg-industrial-50">
                      <td class="px-6 py-4 text-sm font-semibold text-industrial-900">
                        {{ categoria.sortOrder || 0 }}
                      </td>
                      <td class="px-6 py-4">
                        <div>
                          <div class="text-sm font-semibold text-industrial-900">{{ categoria.name }}</div>
                          @if(categoria.description)
                            <div class="text-sm app-muted">{{ categoria.description }}</div>
                          @end
                        </div>
                      </td>
                      <td class="px-6 py-4 text-sm app-muted">
                        @if(categoria.availableFrom && categoria.availableUntil)
                          {{ categoria.availableFrom }} - {{ categoria.availableUntil }}
                        @else
                          Sempre disponível
                        @end
                      </td>
                      <td class="px-6 py-4">
                        <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold
                          {{ categoria.active ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' }}">
                          {{ categoria.active ? 'Ativo' : 'Inativo' }}
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm app-muted">
                        {{ categoria.createdAt.toFormat('dd/MM/yyyy HH:mm') }}
                      </td>
                      <td class="px-6 py-4 text-right text-sm font-medium">
                        <div class="inline-flex gap-3">
                          <a href="{{ route('cardapio_categorias.show', [categoria.id]) }}" class="text-accent-600 hover:text-accent-500">Ver</a>
                          <a href="{{ route('cardapio_categorias.edit', [categoria.id]) }}" class="app-muted hover:text-industrial-500">Editar</a>
                          <form action="{{ route('cardapio_categorias.toggleActive', [categoria.id]) }}" method="POST" class="inline">
                            {{ csrfField() }}
                            <button type="submit" class="text-yellow-600 hover:text-yellow-500">
                              {{ categoria.active ? 'Desativar' : 'Ativar' }}
                            </button>
                          </form>
                          <form action="{{ route('cardapio_categorias.destroy', [categoria.id]) }}" method="POST" class="inline" 
                                onsubmit="return confirm('Tem certeza que deseja excluir esta categoria?')">
                            {{ csrfField() }}
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="text-red-600 hover:text-red-500">Excluir</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  @endeach
                </tbody>
              </table>
