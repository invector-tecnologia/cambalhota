          @if(categorias.length === 0)
            <div class="text-center py-12">
              <i class="fas fa-folder-open text-6xl text-industrial-200 mb-4"></i>
              <h3 class="mt-2 text-sm font-semibold text-industrial-900">Nenhuma categoria cadastrada</h3>
