                          </label>
                          <input 
                            type="text" 
                            name="cofins_rate" 
                            id="cofins_rate"
                            value="{{ old('cofins_rate') || '3,00' }}"
                            data-mask="decimal"
                            class="w-full px-2 py-2 text-sm border border-industrial-300 rounded focus:ring-1 focus:ring-accent-500 bg-white"
                          >
                          <p class="mt-1 text-xs text-industrial-600">
                            💡 Padrão: 3,00%
                          </p>
                        </div>
                      </div>
                    </div>

                    <!-- CEST (opcional) -->
                    <div>
                      <label for="cest" class="block text-sm font-bold text-industrial-900 mb-2">
                        CEST - Código Especificador ST (opcional)
                      </label>
                      <input 
                        type="text" 
                        name="cest" 
                        id="cest"
                        maxlength="7"
                        pattern="[0-9]{7}"
                        value="{{ old('cest') || '' }}"
                        class="w-full px-3 py-2 border border-industrial-300 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white"
