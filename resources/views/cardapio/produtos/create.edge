                    <!-- Helper Links -->
                    <div class="bg-blue-100 border-2 border-blue-300 rounded-lg p-4">
                      <h4 class="text-sm font-bold text-blue-900 mb-3">
                        <i class="fas fa-info-circle mr-1"></i> Precisa de ajuda?
                      </h4>
                      <div class="text-xs text-blue-800 space-y-2">
                        <p>
                          <strong>📚 Consultar tabelas oficiais:</strong>
