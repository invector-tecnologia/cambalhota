<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrfToken }}">
    <title>Novo Produto - Cardápio - Tavolo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @vite(['resources/css/app.css'])
</head>
<body class="h-full font-sans text-industrial-900">
    <!-- Cabeçalho -->
    <header class="bg-white shadow">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center gap-3">
                <div class="flex">
                    <h1 class="text-xl font-semibold leading-6 text-industrial-900">Novo Produto do Cardápio</h1>
                </div>
                <div class="flex items-center space-x-4 ml-auto">
                    <a href="{{ route('cardapio_produtos.index') }}"
                        class="inline-flex items-center rounded-md bg-industrial-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-industrial-500">
                        <i class="fas fa-list mr-2"></i> Lista de Produtos
                    </a>
                </div>
            </div>
        </div>
    </header>
    <!-- Main Content -->
    <main class="max-w-6xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Page Header -->
        <div class="mb-8">
            <div class="flex items-center space-x-3 mb-4">
                <a href="/cardapio/produtos" class="text-industrial-400 hover:app-muted">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <h1 class="text-3xl font-bold text-industrial-900">
                    Novo Produto
                </h1>
            </div>
            <p class="app-muted">
                Cadastre um novo produto para o cardápio
            </p>
        </div>

        <!-- Form -->
        <div class="bg-white  rounded-lg overflow-hidden">
            <form action="{{ route('cardapio_produtos.store') }}" method="POST" enctype="multipart/form-data" class="space-y-8 p-6">
                {{ csrfField() }}
                
                <!-- Seção: Informações Básicas -->
                <div>
                    <h3 class="text-lg font-medium app-strong mb-4 app-border pb-2">Informações Básicas</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Nome -->
                        <div class="md:col-span-2">
                            <label for="name" class="block text-sm font-medium app-muted mb-2">
                                Nome *
                            </label>
                            <input 
                                type="text" 
                                name="name" 
                                id="name" 
                                required 
                                maxlength="200"
                                value="{{ old('name') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                            <p id="name-error" class="mt-2 text-sm text-red-600 hidden"></p>
                        </div>

                        <!-- Categoria -->
                        <div>
                            <label for="cardapio_categoria_id" class="block text-sm font-medium app-muted mb-2">
                                Categoria *
                            </label>
                            <select 
                                name="cardapio_categoria_id" 
                                id="cardapio_categoria_id" 
                                required
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                                <option value="">Selecione...</option>
                                @each(categoria in categorias)
                                    <option value="{{ categoria.id }}" {{ request.input('cardapio_categoria_id') == categoria.id.toString() ? 'selected' : '' }}>
                                        {{ categoria.name }}
                                    </option>
                                @end
                            </select>
                            <p id="cardapio_categoria_id-error" class="mt-2 text-sm text-red-600 hidden"></p>
                        </div>

                        <!-- Ordem de Exibição -->
                        <div>
                            <label for="sort_order" class="block text-sm font-medium app-muted mb-2">
                                Ordem de Exibição
                            </label>
                            <input 
                                type="number" 
                                name="sort_order" 
                                id="sort_order" 
                                min="0" 
                                value="{{ old('sort_order') || '0' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                            <p id="sort_order-error" class="mt-2 text-sm text-red-600 hidden"></p>
                        </div>

                        <!-- Descrição -->
                        <div class="md:col-span-2">
                            <label for="description" class="block text-sm font-medium app-muted mb-2">
                                Descrição
                            </label>
                            <textarea 
                                name="description" 
                                id="description" 
                                rows="3"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >{{ old('description') || '' }}</textarea>
                        </div>

                        <!-- Upload de Imagem -->
                        <div>
                            <label for="image" class="block text-sm font-medium app-muted mb-2">
                                Imagem do Produto
                            </label>
                            <input 
                                type="file" 
                                name="image" 
                                id="image"
                                accept="image/jpeg,image/jpg,image/png,image/webp,image/gif"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-accent-50 file:text-accent-700 hover:file:bg-accent-100"
                            >
                            <p class="mt-1 text-sm text-industrial-500">Formatos aceitos: JPG, PNG, WEBP, GIF (máx. 5MB)</p>
                        </div>

                        <!-- URL da Imagem (opcional) -->
                        <div>
                            <label for="image_url" class="block text-sm font-medium app-muted mb-2">
                                URL da Imagem (opcional)
                            </label>
                            <input 
                                type="url" 
                                name="image_url" 
                                id="image_url"
                                value="{{ old('image_url') || '' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                placeholder="https://exemplo.com/imagem.jpg"
                            >
                            <p class="mt-1 text-sm text-industrial-500">Use apenas se não fizer upload acima</p>
                        </div>

                        <!-- Tempo de Preparo -->
                        <div>
                            <label for="preparation_time" class="block text-sm font-medium app-muted mb-2">
                                Tempo de Preparo (min)
                            </label>
                            <input 
                                type="number" 
                                name="preparation_time" 
                                id="preparation_time" 
                                min="0" 
                                value="{{ old('preparation_time') || '0' }}"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                        </div>

                        <!-- Requer Preparo na Cozinha -->
                        <div>
                            <label class="flex items-center space-x-2">
                                <input 
                                    type="checkbox" 
                                    name="requires_preparation" 
                                    value="true"
                                    {{ old('requires_preparation') ? 'checked' : '' }}
                                    class="rounded border-industrial-300 text-accent-600 focus:ring-accent-500"
                                >
                                <span class="text-sm font-medium app-muted">Requer Preparo na Cozinha</span>
                            </label>
                            <p class="mt-1 text-xs text-industrial-500">Marque se este produto precisa ser preparado (Ex: bebidas não precisam)</p>
                        </div>
                    </div>
                </div>

                <!-- Seção: Ingredientes -->
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-lg font-medium text-industrial-900">Ingredientes</h3>
                            <p class="text-sm text-industrial-500">Adicione os ingredientes que compõem este item</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                        <div>
                            <label for="ingredient_insumo_id" class="block text-sm font-medium app-muted mb-2">Insumo</label>
                            <select id="ingredient_insumo_id" class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                                <option value="">Selecione um insumo</option>
                                @each(insumo in insumos)
                                    <option value="{{ insumo.id }}" data-unit="{{ insumo.unit }}" data-price="{{ insumo.purchasePrice }}">{{ insumo.name }} ({{ insumo.unit }})</option>
                                @end
                            </select>
                        </div>
                        <div>
                            <label for="ingredient_quantity" class="block text-sm font-medium app-muted mb-2">Quantidade</label>
                            <input type="text" id="ingredient_quantity" class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500" placeholder="0,00" />
                        </div>
                        <div>
                            <label for="ingredient_unit" class="block text-sm font-medium app-muted mb-2">Unidade</label>
                            <input type="text" id="ingredient_unit" readonly class="w-full px-3 py-2 app-border rounded-lg bg-industrial-50" />
                        </div>
                        <div class="flex items-end">
                            <button type="button" onclick="addIngredientToList()" class="w-full px-4 py-2 bg-accent-600 text-white rounded-lg hover:bg-accent-700 font-medium">
                                <i class="fas fa-plus mr-2"></i>Adicionar
                            </button>
                        </div>
                    </div>

                    <!-- Ingredientes adicionados aparecerão aqui -->
                    <div id="ingredients-list" class="space-y-2 mb-4">
                        <p class="text-sm text-industrial-500 text-center py-4">Nenhum ingrediente adicionado</p>
                    </div>
                </div>

                <!-- Seção: Preços e Custos -->
                <div>
                    <h3 class="text-lg font-medium app-strong mb-4 app-border pb-2">Preços e Custos</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Preço de Custo -->
                        <div>
                            <label for="cost_price" class="block text-sm font-medium app-muted mb-2">
                                Preço de Custo *
                            </label>
                            <div class="relative">                                
                                <input 
                                    type="text" 
                                    name="cost_price" 
                                    id="cost_price" 
                                    required
                                    value="{{ old('cost_price') || '0,00' }}"
                                    data-mask="currency"
                                    class="w-full pl-20 pr-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                >
                            </div>
                            <div id="ingredients-cost-info" class="mt-2 hidden">
                                <div class="flex items-start gap-2 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                                    <i class="fas fa-info-circle text-blue-600 mt-0.5"></i>
                                    <div class="text-sm">
                                        <p class="font-medium text-blue-900">Custo dos Ingredientes: <span id="ingredients-cost-value" class="font-bold"></span></p>
                                        <p class="text-blue-700 text-xs mt-1">O sistema usará o maior valor entre o custo digitado e o custo dos ingredientes.</p>
                                    </div>
                                </div>
                            </div>
                            <div id="cost-price-warning" class="mt-2 hidden">
                                <div class="flex items-start gap-2 p-3 bg-yellow-50 border border-yellow-300 rounded-lg">
                                    <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5"></i>
                                    <div class="text-sm">
                                        <p class="font-medium text-yellow-900">Atenção: Custo dos ingredientes maior!</p>
                                        <p class="text-yellow-700 text-xs mt-1">O valor digitado (R$ <span id="typed-cost"></span>) é menor que o custo dos ingredientes (R$ <span id="calculated-cost"></span>). O sistema salvará R$ <span id="final-cost"></span>.</p>
                                        <p class="text-yellow-700 text-xs mt-1 font-semibold">💡 Verifique se os preços dos insumos estão corretos!</p>
                                    </div>
                                </div>
                            </div>
                            <p id="cost_price-error" class="mt-2 text-sm text-red-600 hidden"></p>
                        </div>

                        <!-- Markup -->
                        <div>
                            <label for="markup_percentage" class="block text-sm font-medium app-muted mb-2">
                                Markup (%)
                            </label>
                            <input 
                                type="text" 
                                name="markup_percentage" 
                                id="markup_percentage" 
                                value="{{ old('markup_percentage') || '0,00' }}"
                                data-mask="decimal"
                                class="w-full px-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                        </div>

                        <!-- Preço de Venda -->
                        <div>
                            <label for="sale_price" class="block text-sm font-medium app-muted mb-2">
                                Preço de Venda (calculado automaticamente)
                            </label>
                            <div class="relative">                                
                                <input 
                                    type="text" 
                                    name="sale_price" 
                                    id="sale_price" 
                                    readonly 
                                    value="{{ old('sale_price') || '0,00' }}"
                                    data-mask="currency"
                                    class="w-full pl-20 pr-3 py-2 app-border rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                                >
                            </div>
                            <p class="mt-2 text-xs text-industrial-500">O preço de venda é calculado com base no preço de custo e no markup.</p>
                            <p id="sale_price-error" class="mt-2 text-sm text-red-600 hidden"></p>
                        </div>
                    </div>
                </div>

                <!-- Seção: Informações Fiscais (NFC-e) - OBRIGATÓRIO -->
                <div class="border-2 border-accent-200 bg-accent-50 rounded-xl p-6">
                  <div class="flex items-start gap-3 mb-6">
                    <i class="fas fa-file-invoice text-accent-600 text-3xl mt-1"></i>
                    <div class="flex-1">
                      <h3 class="text-xl font-bold text-industrial-900 mb-2">
                        <i class="fas fa-exclamation-circle mr-2 text-accent-500"></i>Dados Fiscais (obrigatórios para emissão de NFC-e)
                      </h3>
                      <p class="text-sm text-industrial-700 font-medium">
                        ⚠️ Sem estes dados, não será possível emitir nota fiscal para este produto
                      </p>
                    </div>
                  </div>
                  
                  <div class="space-y-6">
                    <!-- Linha 1: NCM e CFOP -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <!-- NCM -->
                      <div>
                        <label for="ncm" class="block text-sm font-bold text-industrial-900 mb-2">
                          NCM - Nomenclatura Comum Mercosul *
                        </label>
                        <input 
                          type="text" 
                          name="ncm" 
                          id="ncm" 
                          required
                          maxlength="8"
                          pattern="[0-9]{8}"
                          value="{{ old('ncm') || '' }}"
                          class="w-full px-3 py-2 border border-industrial-300 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white"
                          placeholder="19059090"
                        >
                        <p class="mt-2 text-xs text-industrial-700 bg-industrial-50 p-2 rounded border border-industrial-200">
                          💡 <strong>Exemplos:</strong><br>
                          • Pizza/Pão: <code class="font-mono bg-white px-1">19059090</code><br>
                          • Hambúrguer: <code class="font-mono bg-white px-1">16025000</code><br>
                          • Refrigerante: <code class="font-mono bg-white px-1">22021000</code><br>
                          • Água: <code class="font-mono bg-white px-1">22011000</code><br>
                          • Cerveja: <code class="font-mono bg-white px-1">22030000</code>
                        </p>
                        <a href="https://www.gov.br/receitafederal/pt-br/assuntos/aduana-e-comercio-exterior/manuais/ncm" 
                           target="_blank" 
                           class="inline-block mt-1 text-xs text-blue-700 hover:text-blue-900 underline font-semibold">
                          📚 Consultar tabela NCM oficial
                        </a>
                      </div>

                      <!-- CFOP -->
                      <div>
                        <label for="cfop" class="block text-sm font-bold text-industrial-900 mb-2">
                          CFOP - Código Fiscal de Operações *
                        </label>
                        <select 
                          name="cfop" 
                          id="cfop" 
                          required
                          class="w-full px-3 py-2 border border-industrial-300 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white"
                        >
                          <option value="">Selecione...</option>
                          <option value="5102" {{ old('cfop') === '5102' ? 'selected' : '' }}>
                            5102 - Venda dentro do estado
                          </option>
                          <option value="5405" {{ old('cfop') === '5405' ? 'selected' : '' }}>
                            5405 - Venda de produção própria (restaurante) ⭐
                          </option>
                          <option value="6102" {{ old('cfop') === '6102' ? 'selected' : '' }}>
                            6102 - Venda fora do estado
                          </option>
                        </select>
                        <p class="mt-2 text-xs text-industrial-700 bg-industrial-50 p-2 rounded border border-industrial-200">
                          💡 <strong>Restaurantes geralmente usam 5405</strong> (produção própria)
                        </p>
                      </div>
                    </div>

                    <!-- Linha 2: CSOSN e Unidade -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <!-- CSOSN -->
                      <div>
                        <label for="csosn" class="block text-sm font-bold text-industrial-900 mb-2">
                          CSOSN - Situação Tributária (Simples Nacional) *
                        </label>
                        <select 
                          name="csosn" 
                          id="csosn" 
                          required
                          class="w-full px-3 py-2 border border-industrial-300 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white"
                        >
                          <option value="">Selecione...</option>
                          <option value="102" {{ old('csosn') === '102' ? 'selected' : '' }}>
                            102 - Tributada sem crédito ⭐
                          </option>
                          <option value="103" {{ old('csosn') === '103' ? 'selected' : '' }}>
                            103 - Isenção do ICMS
                          </option>
                          <option value="400" {{ old('csosn') === '400' ? 'selected' : '' }}>
                            400 - Não tributada
                          </option>
                          <option value="900" {{ old('csosn') === '900' ? 'selected' : '' }}>
                            900 - Outros
                          </option>
                        </select>
                        <p class="mt-2 text-xs text-industrial-700 bg-industrial-50 p-2 rounded border border-industrial-200">
                          💡 <strong>Maioria usa 102</strong> - Tributada sem crédito
                        </p>
                      </div>

                      <!-- Unidade Comercial -->
                      <div>
                        <label for="unit" class="block text-sm font-bold text-industrial-900 mb-2">
                          Unidade Comercial *
                        </label>
                        <select 
                          name="unit" 
                          id="unit" 
                          required
                          class="w-full px-3 py-2 border border-industrial-300 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white"
                        >
                          <option value="">Selecione...</option>
                          <option value="UN" {{ old('unit') === 'UN' ? 'selected' : '' }}>
                            UN - Unidade ⭐
                          </option>
                          <option value="KG" {{ old('unit') === 'KG' ? 'selected' : '' }}>
                            KG - Quilograma
                          </option>
                          <option value="LT" {{ old('unit') === 'LT' ? 'selected' : '' }}>
                            LT - Litro
                          </option>
                          <option value="PC" {{ old('unit') === 'PC' ? 'selected' : '' }}>
                            PC - Peça
                          </option>
                          <option value="CX" {{ old('unit') === 'CX' ? 'selected' : '' }}>
                            CX - Caixa
                          </option>
                        </select>
                        <p class="mt-2 text-xs text-industrial-700 bg-industrial-50 p-2 rounded border border-industrial-200">
                          💡 <strong>Maioria usa UN</strong> (unidade)
                        </p>
                      </div>
                    </div>

                    <!-- Linha 3: Alíquotas -->
                    <div>
                      <h4 class="text-sm font-bold text-industrial-900 mb-3">Alíquotas de Impostos</h4>
                      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <div>
                          <label for="icms_rate" class="block text-xs font-semibold text-industrial-900 mb-1">
                            ICMS (%)
