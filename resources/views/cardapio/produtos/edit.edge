                </div>
                <div>
                  <label for="fat" class="block text-sm font-medium app-muted">Gorduras (g)</label>
                  <input type="number" name="fat" id="fat" step="0.1" min="0" value="{{ produto.fat || '' }}" class="mt-1 block w-full rounded-lg border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
