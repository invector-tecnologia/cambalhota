                    </p>
                  </div>

                  <div>
                    <label for="pis_rate" class="block text-xs font-semibold text-industrial-900 mb-1">
                      PIS (%)
                    </label>
                    <input 
                      type="text" 
                      name="pis_rate" 
                      id="pis_rate"
                      value="{{ formatNumber(produto.pisRate || 0.65, 2) }}"
                      data-mask="decimal"
                      class="w-full px-2 py-2 text-sm border border-industrial-300 rounded focus:ring-1 focus:ring-accent-500 bg-white"
                    >
                    <p class="mt-1 text-xs text-industrial-600">
                      💡 Padrão: 0,65%
                    </p>
                  </div>

                  <div>
                    <label for="cofins_rate" class="block text-xs font-semibold text-industrial-900 mb-1">
                      COFINS (%)
                    </label>
                    <input 
                      type="text" 
                      name="cofins_rate" 
                      id="cofins_rate"
                      value="{{ formatNumber(produto.cofinsRate || 3.0, 2) }}"
                      data-mask="decimal"
                      class="w-full px-2 py-2 text-sm border border-industrial-300 rounded focus:ring-1 focus:ring-accent-500 bg-white"
                    >
                    <p class="mt-1 text-xs text-industrial-600">
                      💡 Padrão: 3,00%
                    </p>
                  </div>
                </div>
              </div>

              <!-- CEST (opcional) -->
              <div>
                <label for="cest" class="block text-sm font-bold text-industrial-900 mb-2">
                  CEST - Código Especificador ST (opcional)
                </label>
                <input 
                  type="text" 
                  name="cest" 
                  id="cest"
                  maxlength="7"
                  pattern="[0-9]{7}"
                  value="{{ produto.cest || '' }}"
                  class="w-full px-3 py-2 border border-industrial-300 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white"
                  placeholder="0100100"
                >
                <p class="mt-1 text-xs text-industrial-600">
                  Obrigatório apenas para produtos sujeitos à Substituição Tributária
                </p>
              </div>

              <!-- Helper Links -->
              <div class="bg-blue-100 border-2 border-blue-300 rounded-lg p-4">
                <h4 class="text-sm font-bold text-blue-900 mb-3">
                  <i class="fas fa-info-circle mr-1"></i> Precisa de ajuda?
                </h4>
                <div class="text-xs text-blue-800 space-y-2">
                  <p>
                    <strong>📚 Consultar tabelas oficiais:</strong>
                  </p>
                  <ul class="list-disc list-inside space-y-1 ml-2">
                    <li>
                      <a href="https://www.gov.br/receitafederal/pt-br/assuntos/aduana-e-comercio-exterior/manuais/ncm" 
                         target="_blank" 
                         class="underline font-semibold hover:text-blue-600">
                        Tabela NCM (Receita Federal)
                      </a>
                    </li>
                    <li>
                      <a href="https://www.confaz.fazenda.gov.br/legislacao/codigo-fiscal-de-operacoes-e-prestacoes" 
                         target="_blank" 
                         class="underline font-semibold hover:text-blue-600">
