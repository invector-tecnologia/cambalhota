          <!-- Características Adicionais -->
          <div class="bg-white shadow rounded-lg">
            <div class="px-6 py-4 border-b border-industrial-200"><h2 class="text-lg font-medium text-industrial-900">Características Adicionais</h2></div>
            <div class="p-6 space-y-6">
              <div>
                <label for="tags" class="block text-sm font-medium app-muted">Tags</label>
                <input type="text" name="tags" id="tags" value="{{ produto.tags ? produto.tags.join(', ') : '' }}" class="mt-1 block w-full rounded-lg border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm" placeholder="Ex: novo, promoção, destaque (separados por vírgula)">
                <p class="mt-1 text-sm text-industrial-500">Separe por vírgula</p>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-end space-x-4">
            <a href="{{ route('cardapio_produtos.show', { id: produto.id }) }}" class="inline-flex items-center rounded-lg bg-white px-4 py-2 text-sm font-semibold app-muted  ring-1 ring-inset ring-industrial-300 hover:bg-industrial-50">Cancelar</a>
            <button type="submit" class="inline-flex items-center rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white  hover:bg-accent-500">Salvar Alterações</button>
          </div>
        </form>
      </div>
    </main>
  </div>
  <script>
    // DEBUG: Ver valores que vieram do servidor
    console.log('🔍 [Backend Values]', {
      costPrice: {{ produto.costPrice }},
      salePrice: {{ produto.salePrice }},
      markupPercentage: {{ produto.markupPercentage }}
    });
    
    // DEBUG: Log no submit do formulário
    const form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', function(e) {
        const costPriceInput = document.getElementById('cost_price');
        const salePriceInput = document.getElementById('sale_price');
        const markupInput = document.getElementById('markup_percentage');
        
        console.log('🔍 [Form Submit] Valores a enviar:', {
          cost_price: costPriceInput?.value,
          sale_price: salePriceInput?.value,
          markup_percentage: markupInput?.value
        });
      });
    }
    
    // Conversão BR -> número e atualização automática do preço de venda
    function parseBrazilianNumber(value) {
      if (!value) return 0;
      const normalized = String(value).replace(/\./g, '').replace(',', '.');
      return parseFloat(normalized) || 0;
    }

    function updateSalePriceFromMarkup() {
      const costInput = document.getElementById('cost_price');
      const markupInput = document.getElementById('markup_percentage');
      const saleInput = document.getElementById('sale_price');
      if (!costInput || !markupInput || !saleInput) return;

      const cost = parseBrazilianNumber(costInput.value);
      const markup = parseBrazilianNumber(markupInput.value);
      const sale = cost * (1 + (markup / 100));
      saleInput.value = sale.toFixed(2).replace('.', ',');
    }
    
    // Calcular custo total dos ingredientes e mostrar avisos
    function updateIngredientsCostWarning() {
      const costInput = document.getElementById('cost_price');
      const infoDiv = document.getElementById('ingredients-cost-info');
      const warningDiv = document.getElementById('cost-price-warning');
      
      if (!costInput || !infoDiv || !warningDiv) return;
      
      // Calcular custo dos ingredientes existentes
      let ingredientsCost = 0;
      @each(ingrediente in produto.ingredientes)
        ingredientsCost += {{ ingrediente.totalCost || 0 }};
      @end
      
      const typedCost = parseBrazilianNumber(costInput.value);
      
      // Se tem ingredientes, mostrar info
      if (ingredientsCost > 0) {
        infoDiv.classList.remove('hidden');
        document.getElementById('ingredients-cost-value').textContent = 
          'R$ ' + ingredientsCost.toFixed(2).replace('.', ',');
        
        // Se custo digitado é menor que ingredientes, mostrar aviso
        if (typedCost > 0 && typedCost < ingredientsCost) {
          warningDiv.classList.remove('hidden');
          document.getElementById('typed-cost').textContent = typedCost.toFixed(2).replace('.', ',');
          document.getElementById('calculated-cost').textContent = ingredientsCost.toFixed(2).replace('.', ',');
          document.getElementById('final-cost').textContent = ingredientsCost.toFixed(2).replace('.', ',');
        } else {
          warningDiv.classList.add('hidden');
        }
      } else {
        infoDiv.classList.add('hidden');
        warningDiv.classList.add('hidden');
      }
    }

    const costInputAuto = document.getElementById('cost_price');
    const markupInputAuto = document.getElementById('markup_percentage');
    if (costInputAuto) {
      costInputAuto.addEventListener('input', updateSalePriceFromMarkup);
      costInputAuto.addEventListener('blur', updateSalePriceFromMarkup);
      costInputAuto.addEventListener('change', updateSalePriceFromMarkup);
      costInputAuto.addEventListener('input', updateIngredientsCostWarning);
      costInputAuto.addEventListener('blur', updateIngredientsCostWarning);
    }
    if (markupInputAuto) {
      markupInputAuto.addEventListener('input', updateSalePriceFromMarkup);
      markupInputAuto.addEventListener('blur', updateSalePriceFromMarkup);
      markupInputAuto.addEventListener('change', updateSalePriceFromMarkup);
    }
    updateSalePriceFromMarkup();
    updateIngredientsCostWarning(); // Inicializar avisos
    
    // Funções de validação
    function showError(fieldId, message) {
        const errorElement = document.getElementById(`${fieldId}-error`);
        const inputElement = document.getElementById(fieldId);
        if (errorElement && inputElement) {
            errorElement.textContent = message;
            errorElement.classList.remove('hidden');
            inputElement.classList.add('border-red-500');
            inputElement.classList.remove('border-industrial-300');
        }
    }

    function clearError(fieldId) {
        const errorElement = document.getElementById(`${fieldId}-error`);
        const inputElement = document.getElementById(fieldId);
        if (errorElement && inputElement) {
            errorElement.textContent = '';
            errorElement.classList.add('hidden');
            inputElement.classList.remove('border-red-500');
            inputElement.classList.add('border-industrial-300');
        }
    }

    function validateName() {
        const nameInput = document.getElementById('name');
        const value = nameInput.value.trim();
        
        if (!value) {
            showError('name', 'O nome do produto é obrigatório.');
            return false;
        }
        
        if (value.length < 2) {
            showError('name', 'O nome deve ter no mínimo 2 caracteres.');
            return false;
        }
        
        if (value.length > 200) {
            showError('name', 'O nome deve ter no máximo 200 caracteres.');
            return false;
        }
        
        clearError('name');
        return true;
    }

    function validateCategoria() {
        const categoriaSelect = document.getElementById('cardapio_categoria_id');
        const value = categoriaSelect.value;
        
        if (!value) {
            showError('cardapio_categoria_id', 'A categoria é obrigatória.');
            return false;
        }
        
        clearError('cardapio_categoria_id');
        return true;
    }

    function validateSalePrice() {
        const salePriceInput = document.getElementById('sale_price');
        const value = salePriceInput.value.trim();
        
        if (!value) {
            showError('sale_price', 'O preço de venda é obrigatório.');
            return false;
        }
        
        // Converter valor formatado (0,00) para número
        const numValue = parseFloat(value.replace(/\./g, '').replace(',', '.'));
        
        if (isNaN(numValue) || numValue < 0) {
            showError('sale_price', 'O preço de venda deve ser um número maior ou igual a 0.');
            return false;
        }
        
        clearError('sale_price');
        return true;
    }

    function validateCostPrice() {
        const costPriceInput = document.getElementById('cost_price');
        const value = costPriceInput.value.trim();
        
        if (value) {
            // Converter valor formatado (0,00) para número
            const numValue = parseFloat(value.replace(/\./g, '').replace(',', '.'));
            
            if (isNaN(numValue) || numValue < 0) {
                showError('cost_price', 'O preço de custo deve ser um número maior ou igual a 0.');
                return false;
            }
        }
        
        clearError('cost_price');
        return true;
    }

    function validateSortOrder() {
        const sortInput = document.getElementById('sort_order');
        const value = sortInput.value;
        
        if (value && (isNaN(value) || parseInt(value) < 0)) {
            showError('sort_order', 'A ordem deve ser um número maior ou igual a 0.');
            return false;
        }
        
        clearError('sort_order');
        return true;
    }

    // Adicionar validações on blur (com verificação de existência)
    const nameField = document.getElementById('name');
    const categoriaField = document.getElementById('cardapio_categoria_id');
    const salePriceField = document.getElementById('sale_price');
    const costPriceField = document.getElementById('cost_price');
    const sortField = document.getElementById('sort_order');
    
    if (nameField) nameField.addEventListener('blur', validateName);
    if (categoriaField) categoriaField.addEventListener('blur', validateCategoria);
    if (salePriceField) salePriceField.addEventListener('blur', validateSalePrice);
    if (costPriceField) costPriceField.addEventListener('blur', validateCostPrice);
    if (sortField) sortField.addEventListener('blur', validateSortOrder);

    // Validação do formulário no submit
    const formElement = document.querySelector('form');
    if (formElement) {
        formElement.addEventListener('submit', function(e) {
            console.log('🔍 Validando formulário de edição de produto...');
            
            let isValid = true;
            
            // Validar todos os campos
            if (!validateName()) isValid = false;
            if (!validateCategoria()) isValid = false;
            if (!validateSalePrice()) isValid = false;
            if (!validateCostPrice()) isValid = false;
            if (!validateSortOrder()) isValid = false;
            
            if (!isValid) {
                e.preventDefault();
                console.log('❌ Validação falhou, formulário não enviado');
                return;
            }
            
            // Converter campos numéricos de formato brasileiro para padrão antes de enviar
            const costPriceInput = document.getElementById('cost_price');
            const salePriceInput = document.getElementById('sale_price');
            const markupInput = document.getElementById('markup_percentage');
            
            if (costPriceInput && costPriceInput.value) {
                const parsed = parseBrazilianNumber(costPriceInput.value);
                if (!isNaN(parsed)) {
                    // Enviar como string em formato brasileiro (1,50 e não 1.50)
                    costPriceInput.value = parsed.toFixed(2).replace('.', ',');
                    console.log('✅ cost_price convertido:', costPriceInput.value);
                }
            }
            
            if (salePriceInput && salePriceInput.value) {
                const parsed = parseBrazilianNumber(salePriceInput.value);
                if (!isNaN(parsed)) {
                    // Enviar como string em formato brasileiro (1,50 e não 1.50)
                    salePriceInput.value = parsed.toFixed(2).replace('.', ',');
                    console.log('✅ sale_price convertido:', salePriceInput.value);
                }
            }
            
            if (markupInput && markupInput.value) {
                const parsed = parseBrazilianNumber(markupInput.value);
                if (!isNaN(parsed)) {
                    // Enviar como string em formato brasileiro (1,50 e não 1.50)
                    markupInput.value = parsed.toFixed(2).replace('.', ',');
                    console.log('✅ markup_percentage convertido:', markupInput.value);
                }
            }
            
            console.log('✅ Validação passou, enviando formulário...');
        });
    }

    // Atualizar unidade quando produto é selecionado
    const insumoSelect = document.getElementById('insumo_id');
    const ingredientUnitInput = document.getElementById('ingredient_unit');
    
    if (insumoSelect && ingredientUnitInput) {
      insumoSelect.addEventListener('change', function() {
        const selected = this.options[this.selectedIndex];
        const unit = selected.getAttribute('data-unit') || '';
        ingredientUnitInput.value = unit;
      });
    }

    // Adicionar ingrediente via AJAX
    window.addIngredient = async function() {
      console.log('✅ addIngredient foi chamada');
      const productId = document.getElementById('insumo_id').value;
      const quantity = document.getElementById('quantity').value;
      const unit = document.getElementById('ingredient_unit').value;

      if (!productId || !quantity) {
        alert('Selecione um produto e informe a quantidade');
        return;
      }

      // Converter número no formato brasileiro (1,5) para americano (1.5)
      function parseBrazilianNumber(value) {
        if (!value) return 0;
        const str = String(value).trim();
        // Se for um número puro (sem vírgula nem ponto), retornar como está
        if (!isNaN(parseFloat(str))) {
          return parseFloat(str);
        }
        // Se houver formatação brasileira (1.234,56), converter
        const normalized = str.replace(/\./g, '').replace(',', '.');
        return parseFloat(normalized) || 0;
      }

      try {
        const parsedQuantity = parseBrazilianNumber(quantity);
        console.log('📝 Quantidade digitada:', quantity, '| Convertida:', parsedQuantity, '| Tipo:', typeof parsedQuantity);
        const response = await fetch('{{ route("cardapio_produtos.addIngredient", { id: produto.id }) }}', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
          },
          body: JSON.stringify({
            insumo_id: parseInt(productId),
            quantity: parsedQuantity,
            unit: unit
          })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const error = await response.json();
          alert(error.message || 'Erro ao adicionar ingrediente');
        }
      } catch (error) {
        alert('Erro ao adicionar ingrediente');
      }
    }

    // Remover ingrediente via AJAX
    async function removeIngredient(ingredientId) {
      if (!confirm('Tem certeza que deseja remover este ingrediente?')) return;

      try {
        const response = await fetch('{{ route("cardapio_produtos.removeIngredient", { itemId: produto.id, ingredientId: ":id" }) }}'.replace(':id', ingredientId), {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || ''
          }
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Erro ao remover ingrediente');
        }
      } catch (error) {
        alert('Erro ao remover ingrediente');
      }
    }
    
    // DEBUG: Confirmar que o script executou completamente
    console.log('✅ Script de edit.edge carregado completamente');
    console.log('✅ window.addIngredient existe?', typeof window.addIngredient);
  </script>
  @include('components/quick_actions')
</body>
</html>
