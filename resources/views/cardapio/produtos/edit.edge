          <!-- Disponibilidade e Horários -->
          <div class="bg-white shadow rounded-lg">
            <div class="px-6 py-4 border-b border-industrial-200"><h2 class="text-lg font-medium text-industrial-900">Disponibilidade e Horários</h2></div>
            <div class="p-6 space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-start">                  
                  <div class="flex h-5 items-center">
                    <input type="checkbox" name="available" id="available" value="true" {{ produto.available ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="available" class="font-medium app-muted">Disponível para Pedidos</label>
                  </div>
                </div>
                <div class="flex items-start">                  
                  <div class="flex h-5 items-center">
                    <input type="checkbox" name="active" id="active" value="true" {{ produto.active ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="active" class="font-medium app-muted">Ativo no Cardápio</label>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="available_from" class="block text-sm font-medium app-muted">Disponível a partir de</label>
                  <input type="time" name="available_from" id="available_from" value="{{ produto.availableFrom || '' }}" class="mt-1 block w-full rounded-lg border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
                </div>
                <div>
                  <label for="available_until" class="block text-sm font-medium app-muted">Disponível até</label>
                  <input type="time" name="available_until" id="available_until" value="{{ produto.availableUntil || '' }}" class="mt-1 block w-full rounded-lg border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium app-muted mb-2">Dias Disponíveis</label>
                <div class="grid grid-cols-7 gap-2">
                  <div class="flex items-start">
                    <div class="flex h-5 items-center">
                      <input type="checkbox" name="available_days[]" id="day_0" value="0" {{ produto.availableDays && produto.availableDays.includes(0) ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                    </div>
                    <div class="ml-2 text-sm">
                      <label for="day_0" class="font-medium app-muted">Dom</label>
                    </div>
                  </div>
                  <div class="flex items-start">
                    <div class="flex h-5 items-center">
                      <input type="checkbox" name="available_days[]" id="day_1" value="1" {{ produto.availableDays && produto.availableDays.includes(1) ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                    </div>
                    <div class="ml-2 text-sm">
                      <label for="day_1" class="font-medium app-muted">Seg</label>
                    </div>
                  </div>
                  <div class="flex items-start">
                    <div class="flex h-5 items-center">
                      <input type="checkbox" name="available_days[]" id="day_2" value="2" {{ produto.availableDays && produto.availableDays.includes(2) ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                    </div>
                    <div class="ml-2 text-sm">
                      <label for="day_2" class="font-medium app-muted">Ter</label>
                    </div>
                  </div>
                  <div class="flex items-start">
                    <div class="flex h-5 items-center">
                      <input type="checkbox" name="available_days[]" id="day_3" value="3" {{ produto.availableDays && produto.availableDays.includes(3) ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                    </div>
                    <div class="ml-2 text-sm">
                      <label for="day_3" class="font-medium app-muted">Qua</label>
                    </div>
                  </div>
                  <div class="flex items-start">
                    <div class="flex h-5 items-center">
                      <input type="checkbox" name="available_days[]" id="day_4" value="4" {{ produto.availableDays && produto.availableDays.includes(4) ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                    </div>
                    <div class="ml-2 text-sm">
                      <label for="day_4" class="font-medium app-muted">Qui</label>
                    </div>
                  </div>
                  <div class="flex items-start">
                    <div class="flex h-5 items-center">
                      <input type="checkbox" name="available_days[]" id="day_5" value="5" {{ produto.availableDays && produto.availableDays.includes(5) ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                    </div>
                    <div class="ml-2 text-sm">
                      <label for="day_5" class="font-medium app-muted">Sex</label>
                    </div>
                  </div>
                  <div class="flex items-start">
                    <div class="flex h-5 items-center">
                      <input type="checkbox" name="available_days[]" id="day_6" value="6" {{ produto.availableDays && produto.availableDays.includes(6) ? 'checked' : '' }} class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                    </div>
                    <div class="ml-2 text-sm">
