    <!-- Modal de Confirmação de Exclusão -->
    <div id="deleteModal" class="hidden fixed inset-0 bg-industrial-500 bg-opacity-75 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg-xl max-w-md w-full mx-4">
            <div class="px-6 py-4 border-b border-industrial-200">
                <h5 class="text-lg font-semibold">Confirmar Exclusão</h5>
            </div>
            <div class="px-6 py-4">
                <p>Tem certeza que deseja excluir a comanda <strong>{{ comanda.number }}</strong>?</p>
                <p class="text-red-600 text-sm mt-2">Esta ação não pode ser desfeita.</p>
            </div>
            <div class="px-6 py-4 bg-industrial-50 flex justify-end gap-3 rounded-b-lg">
                <button 
                    type="button"
                    class="inline-flex items-center px-4 py-2 app-border text-sm font-medium rounded-lg app-muted bg-white hover:bg-industrial-50"
                    onclick="document.getElementById('deleteModal').classList.add('hidden')"
                >
                    Cancelar
                </button>
                <form action="{{ route('comandas.destroy', [comanda.id]) }}" method="POST" class="inline">
                    {{ csrfField() }}
                    @!method('DELETE')
                    <button 
                        type="submit"
                        class="inline-flex items-center px-4 py-2 bg-accent-600 text-white text-sm font-medium rounded-lg hover:bg-accent-700"
                    >
                        Excluir
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        function confirmarExclusao() {
            document.getElementById('deleteModal').classList.remove('hidden');
        }
    </script>
