    <header class="bg-white ">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center gap-3">
                <div class="h-10 w-10 rounded-full bg-accent-500/10 text-accent-600 flex items-center justify-center">
                    <i class="fas fa-ticket"></i>
                </div>
                <div>
                    <h1 class="text-lg font-semibold">Nova Comanda</h1>
                    <p class="text-sm text-industrial-500">Crie comandas e associe a mesas</p>
                </div>
                <div class="flex items-center gap-2 ml-auto">
                    <a 
                        href="{{ route('comandas.index') }}" 
