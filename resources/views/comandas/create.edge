    <main class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <div class="flex items-center gap-3 mb-4">
                <a href="{{ route('comandas.index') }}" class="text-industrial-500 hover:app-muted">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </a>
                <h1 class="text-3xl font-bold text-industrial-900">Nova Comanda</h1>
            </div>
            <p class="app-muted ml-8">
                Cadastre uma nova comanda para atendimento
            </p>
        </div>

        <div class="bg-white  rounded-xl overflow-hidden ring-1 ring-industrial-100">
            <form action="{{ route('comandas.store') }}" method="POST" class="space-y-8 p-6">
                {{ csrfField() }}
                
                <!-- Seção: Informações Básicas -->
                <div>
                    <h3 class="text-lg font-semibold app-strong mb-4 app-border pb-2">Informações Básicas</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="mesaId" class="block text-sm font-medium app-muted mb-2">Mesa (Opcional)</label>
                            <select 
                                id="mesaId" 
                                name="mesaId" 
                                class="w-full px-3 py-2 app-border rounded-lg  focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                                <option value="">Sem mesa</option>
                                @each(mesa in mesas)
                                    <option value="{{ mesa.id }}" {{ (old('mesaId') || selectedMesaId) == mesa.id ? 'selected' : '' }}>
                                        Mesa {{ mesa.number }} {{ mesa.name ? '- ' + mesa.name : '' }}
                                    </option>
                                @end
                            </select>
                            <p class="mt-1 text-sm text-industrial-500">Agrupe esta comanda a uma mesa</p>
                        </div>
                        <div>
                            <label for="name" class="block text-sm font-medium app-muted mb-2">Nome / Descrição</label>
                            <input 
                                type="text"
                                id="name" 
                                name="name" 
                                value="{{ old('name') || ''}}" 
                                maxlength="100"
                                placeholder="Ex: Cliente VIP, Aniversário"
                                class="w-full px-3 py-2 app-border rounded-lg  focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                            >
                            <p class="mt-1 text-sm text-industrial-500">Descrição opcional para identificar a comanda</p>
                        </div>
                    </div>
                </div>

                <!-- Seção: Status e Configurações -->
                <div>
                    <h3 class="text-lg font-semibold app-strong mb-4 app-border pb-2">Status e Configurações</h3>
                    <div class="space-y-6">
                        <div class="flex items-center h-5">                            
                            <input 
                                type="checkbox" 
                                id="active" 
                                name="active" 
                                value="true" 
                                checked
                                class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500"
                            >
                            <div class="ml-3">
                                <label class="text-sm font-medium app-muted" for="active">Comanda ativa</label>
                                <p class="text-sm text-industrial-500">Comandas inativas não aparecem para uso no sistema</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Seção: Observações -->
                <div>
                    <h3 class="text-lg font-semibold app-strong mb-4 app-border pb-2">Observações</h3>
                    <textarea
                        id="notes" 
                        name="notes" 
                        rows="3"
                        placeholder="Informações adicionais sobre a comanda..."
                        class="w-full px-3 py-2 app-border rounded-lg  focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                    >{{ old('notes') || '' }}</textarea>
                </div>

                <!-- Botões -->
                <div class="border-t border-industrial-100 pt-6">
                    <div class="flex items-center justify-end gap-3">
                        <a 
                            href="{{ route('comandas.index') }}" 
                            class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-semibold app-muted  ring-1 ring-inset ring-industrial-200 hover:bg-industrial-50"
                        >
                            <i class="fas fa-times"></i>
                            Cancelar
                        </a>
                        <button 
                            type="submit" 
                            class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white  hover:bg-accent-500"
                        >
                            <i class="fas fa-save"></i>
                            Criar Comanda
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Dicas -->
        <div class="mt-6 bg-blue-50 border-l-4 border-blue-500 rounded-lg">
            <div class="p-6">
                <h3 class="text-blue-800 font-semibold mb-3">
                    <i class="fas fa-lightbulb mr-2"></i> Dicas
                </h3>
                <ul class="text-sm text-blue-700 space-y-1 list-disc list-inside">
                    <li>O número da comanda é gerado automaticamente de forma sequencial</li>
                    <li>Use o campo nome para identificar o cliente ou evento</li>
                    <li>Associe a comanda a uma mesa se necessário</li>
                    <li>Comandas inativas não aparecem para uso no sistema</li>
                </ul>
            </div>
        </div>
    </main>

    <script>
        // Auto-focus no campo número
        const numberField = document.getElementById('number');
        if (numberField) {
            numberField.focus();
        }
    </script>
</body>
