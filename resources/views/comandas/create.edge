                        <i class="fas fa-list mr-2"></i>
                        Lista de Comandas
                    </a>
                    <a href="javascript:history.back()" id="backButton"
                        class="inline-flex items-center gap-2 rounded-lg bg-industrial-800 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-industrial-700">
                        <i class="fas fa-arrow-left"></i> Voltar
                    </a>
                    
                    <script>
                        if (history.length <= 1) {
                            document.getElementById('backButton').classList.add('hidden');
