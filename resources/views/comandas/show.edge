                      @end
                    </dd>
                  </div>
                  <div>
                    <dt class="text-sm font-medium text-industrial-500">Tempo de Permanência</dt>
                    <dd class="mt-1 text-sm text-industrial-900">
                      <span class="font-semibold" id="tempo-permanencia"></span>
                      <script>
                        (function() {
                          const created = new Date('{{ comanda.createdAt.toISO() }}');
                          const now = new Date();
                          const diffMs = now - created;
                          const minutes = Math.floor(diffMs / 60000);
                          const hours = Math.floor(minutes / 60);
                          const days = Math.floor(hours / 24);
                          const remainingHours = hours % 24;
                          const remainingMinutes = minutes % 60;
                          
                          let display = '';
                          if (days > 0) {
                            display = days + 'd ' + remainingHours + 'h ' + remainingMinutes + 'm';
                          } else if (hours > 0) {
                            display = hours + 'h ' + remainingMinutes + 'm';
                          } else {
                            display = minutes + ' minutos';
                          }
                          document.getElementById('tempo-permanencia').textContent = display;
                        })();
                      </script>
                    </dd>
                  </div>
                </dl>
              </div>
