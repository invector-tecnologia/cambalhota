                  @each(paidPedido in paidPedidos)
                  <div class="bg-industrial-50 border border-industrial-100 rounded-lg overflow-hidden">
                    <div class="px-4 py-3 border-b border-industrial-100 flex justify-between items-center">
                      <div>
                        <h6 class="font-semibold app-muted">
                          Pedido #{{ paidPedido.orderNumber }}
                          <span class="inline-flex rounded-full px-2 py-1 text-xs bg-green-100 text-green-800">
                            <i class="fas fa-check-circle mr-1"></i> Pago
                          </span>
                        </h6>
                        <p class="text-xs text-industrial-500 mt-1">
                          Pago em: {{{ formatDateTimestamp(paidPedido.paidAt) }}}
                        </p>
                      </div>
                      <div>
                        <a href="{{ route('pedidos.show', [paidPedido.id]) }}"
                          class="inline-flex items-center px-3 py-1.5 app-border text-sm font-medium rounded-md app-muted bg-white hover:bg-industrial-50">
                          <i class="fas fa-eye mr-1"></i> Ver Pedido
                        </a>
                      </div>
                    </div>
                    <div class="px-4 py-4">
                      @if(paidPedido.items && paidPedido.items.length > 0)
                      <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-industrial-100 text-sm">
                          <thead class="bg-industrial-50">
                            <tr>
                              <th class="px-3 py-2 text-left text-xs font-medium text-industrial-500 uppercase">Item</th>
                              <th class="px-3 py-2 text-center text-xs font-medium text-industrial-500 uppercase">Qtd</th>
                              <th class="px-3 py-2 text-right text-xs font-medium text-industrial-500 uppercase">Valor Unit.
                              </th>
                              <th class="px-3 py-2 text-right text-xs font-medium text-industrial-500 uppercase">Subtotal</th>
                            </tr>
                          </thead>
                          <tbody class="bg-white divide-y divide-industrial-100">
                            @each(item in paidPedido.items)
                            <tr>
                              <td class="px-3 py-2">
                                {{ item.menuItem ? item.menuItem.name : item.itemName }}
                                @if(item.notes)
                                <br><span class="text-xs text-industrial-500">{{ item.notes }}</span>
                                @end
                              </td>
                              <td class="px-3 py-2 text-center">{{ item.quantity }}</td>
                              <td class="px-3 py-2 text-right">{{ formatCurrency(item.unitPrice) }}</td>
                              <td class="px-3 py-2 text-right">{{ formatCurrency(item.subtotal) }}</td>
                            </tr>
                            @end
                          </tbody>
                          <tfoot class="bg-industrial-50">
                            <tr>
                              <td colspan="3" class="px-3 py-2 text-right font-medium app-muted">Subtotal:</td>
                              <td class="px-3 py-2 text-right font-medium app-muted">{{ formatCurrency(paidPedido.subtotal) }}</td>
                            </tr>
                            <tr>
                              <td colspan="3" class="px-3 py-2 text-right text-sm app-muted">Desconto:</td>
                              <td class="px-3 py-2 text-right text-sm text-red-600">- {{ formatCurrency(paidPedido.discount) }}</td>
                            </tr>
                            <tr>
                              <td colspan="3" class="px-3 py-2 text-right text-sm app-muted">Taxa de Serviço:</td>
                              <td class="px-3 py-2 text-right text-sm app-muted">+ {{ formatCurrency(paidPedido.serviceCharge) }}</td>
                            </tr>
                            <tr class="font-semibold">
                              <td colspan="3" class="px-3 py-2 text-right app-muted">Total:</td>
                              <td class="px-3 py-2 text-right app-muted">
                                {{ formatCurrency(paidPedido.total) }}</td>
                            </tr>
                          </tfoot>
                        </table>
                      </div>
                      @else
                      <p class="text-industrial-500 text-sm">Nenhum item no pedido</p>
                      @end
                    </div>
                  </div>
                  @end
                </div>
              </div>
            </div>
            @end
          </div>
        </div>
      </div>
    </main>
  </div>

  <style>
    @media print {
      header, .no-print {
        display: none !important;
      }
    }
  </style>

  <!-- Modal Fechar e Pagar (CPF opcional + escolher emissão NF-e) -->
  <div id="closePayModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg">
      <div class="flex items-center justify-between p-6 border-b border-industrial-100">
        <h3 class="text-lg font-semibold text-industrial-900">Fechar Comanda e Registrar Venda</h3>
        <button id="closeClosePayModal" class="text-industrial-400 hover:app-muted text-2xl leading-none">✕</button>
      </div>
      <form id="closePayForm" action="{{ route('comandas.closeAndPay', [comanda.id]) }}" method="POST">
        {{ csrfField() }}
        <div class="p-6 space-y-4">
          <div>
            <label for="paymentMethodModal" class="block text-sm font-medium app-muted">Método de Pagamento</label>
            <select id="paymentMethodModal" name="paymentMethod" required class="mt-1 block w-full rounded-md border-industrial-300 focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
              <option value="card">Cartão</option>
              <option value="cash">Dinheiro</option>
              <option value="pix">PIX</option>
              <option value="split">Misto</option>
            </select>
          </div>
          <div>
            <label for="discountModal" class="block text-sm font-medium app-muted">Desconto (%)</label>
            <input type="number" id="discountModal" name="discount" step="0.01" min="0" max="100" placeholder="0" class="mt-1 block w-full rounded-md border-industrial-300 focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
            <p class="mt-1 text-xs text-industrial-500">Informe o percentual de desconto (ex: 10 para 10%)</p>
          </div>
          <div>
            <label for="cpfModal" class="block text-sm font-medium app-muted">CPF do Cliente (opcional)</label>
            <input type="text" id="cpfModal" name="cpf" placeholder="000.000.000-00" class="mt-1 block w-full rounded-md border-industrial-300 focus:border-accent-500 focus:ring-accent-500 sm:text-sm" />
            <p id="cpfHint" class="mt-1 text-xs text-industrial-500">Preencha somente se desejar emitir NF-e com CPF do consumidor.</p>
          </div>
          <input type="hidden" id="emitNfceInput" name="emitNfce" value="false" />
        </div>
        <div class="flex items-center justify-between p-6 border-t border-industrial-100 bg-industrial-50">
          <button type="button" id="onlyCloseSaleBtn" class="inline-flex items-center px-4 py-2 app-border app-muted text-sm font-semibold rounded-md bg-white hover:bg-industrial-50">
            <i class="fas fa-check mr-2"></i> Apenas Fechar Venda
          </button>
          <button type="button" id="emitNfceBtn" class="inline-flex items-center px-4 py-2 bg-accent-600 text-white text-sm font-semibold rounded-md hover:bg-accent-500">
            <i class="fas fa-file-invoice mr-2"></i>
            <span id="emitNfceLabel">Emitir NF-e e Fechar Venda</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de Impressão -->
  <div id="printModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl h-[90vh] flex flex-col" style="width: 90mm;">
      <!-- Header da Modal -->
      <div class="flex items-center justify-between p-6 border-b border-industrial-100">
        <h3 class="text-lg font-semibold text-industrial-900">Nota de Consumo - Comanda {{ comanda.number }}</h3>
        <button id="closeModal" class="text-industrial-400 hover:app-muted text-2xl leading-none">
          ✕
        </button>
      </div>
      
      <!-- Conteúdo da Modal (iframe) -->
      <div class="flex-1 overflow-auto">
        <iframe id="printFrame" 
          src="{{ route('comandas.print', [comanda.id]).replace(/https?:\/\/[^/]+/, '') }}"
          class="w-full h-full border-0"></iframe>
      </div>
      
      <!-- Footer da Modal -->
      <div class="flex items-center justify-between p-6 border-t border-industrial-100 bg-industrial-50">
        <button id="printFromModal"
                class="inline-flex items-center px-4 py-2 bg-accent-600 text-white text-sm font-semibold rounded-md hover:bg-accent-500">
          <i class="fas fa-print mr-2"></i> Imprimir
        </button>
        <button id="closeModalBtn"
                class="inline-flex items-center px-4 py-2 app-border app-muted text-sm font-semibold rounded-md bg-white hover:bg-industrial-50">
          <i class="fas fa-times mr-2"></i> Fechar
        </button>
      </div>
    </div>
  </div>

  <script>
    const printModalBtn = document.getElementById('printModalBtn')
    const printModal = document.getElementById('printModal')
    const closeModal = document.getElementById('closeModal')
    const closeModalBtn = document.getElementById('closeModalBtn')
    const printFromModal = document.getElementById('printFromModal')
    const printFrame = document.getElementById('printFrame')
    const printUrl = "{{ route('comandas.print', [comanda.id]).replace(/https?:\/\/[^/]+/, '') }}"

    // Abrir modal de impressão
    if (printModalBtn && printModal) {
      printModalBtn.addEventListener('click', () => {
        if (printFrame && printUrl) {
          printFrame.src = printUrl
        }
        printModal.classList.remove('hidden')
      })
    }

    // Fechar modal (botão X)
    if (closeModal && printModal) {
      closeModal.addEventListener('click', () => {
        printModal.classList.add('hidden')
      })
    }

    // Fechar modal (botão Fechar)
    if (closeModalBtn && printModal) {
      closeModalBtn.addEventListener('click', () => {
        printModal.classList.add('hidden')
      })
    }

    // Fechar modal ao clicar fora
    if (printModal) {
      printModal.addEventListener('click', (e) => {
        if (e.target === printModal) {
          printModal.classList.add('hidden')
        }
      })
    }

    // Imprimir conteúdo do iframe
    if (printFromModal && printFrame) {
      printFromModal.addEventListener('click', () => {
        try {
          printFrame.contentWindow.print()
        } catch (error) {
          console.error('Erro ao imprimir:', error)
        }
      })
    }

    // ============================================================================
    // CONTROLE DE STATUS DA MESA - Botões Rápidos + Auto-atualização
    // ============================================================================
    
    // Estado global
    let isUpdatingStatus = false
    let autoUpdateInterval = null
    const MESA_ID = {{ comanda.mesa ? comanda.mesa.id : 'null' }}
    const CSRF_TOKEN = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || 
                       document.querySelector('input[name="_csrf"]')?.value || ''

    // Função para atualizar status via botão rápido
    window.quickUpdateMesaStatus = async function(newStatus) {
      if (isUpdatingStatus) return
      if (!MESA_ID) {
        showStatusFeedback('Nenhuma mesa associada', 'error')
        return
      }

      isUpdatingStatus = true
      showStatusFeedback('Atualizando...', 'info')
      
      try {
        const formData = new FormData()
        formData.append('_csrf', CSRF_TOKEN)
        formData.append('status', newStatus)

        const response = await fetch(`/mesas/${MESA_ID}/status`, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })

        if (response.ok) {
          updateStatusUI(newStatus)
          showStatusFeedback('Status atualizado!', 'success')
          
          // Recarregar após 1s para pegar flash messages e dados atualizados
          setTimeout(() => window.location.reload(), 1000)
        } else {
          const errorText = await response.text()
          console.error('Erro ao atualizar:', errorText)
          showStatusFeedback('Erro ao atualizar status', 'error')
        }
      } catch (error) {
        console.error('Erro na requisição:', error)
        showStatusFeedback('Erro de conexão', 'error')
      } finally {
        isUpdatingStatus = false
      }
    }

    // Atualiza a UI sem recarregar
    function updateStatusUI(newStatus) {
      const badge = document.getElementById('mesaStatusBadge')
      const text = document.getElementById('mesaStatusText')
      const buttons = document.querySelectorAll('.quick-status-btn')

      if (!badge || !text) return

      // Mapas de configuração
      const statusConfig = {
        available: {
          text: 'Livre',
          classes: 'bg-green-100 text-green-800',
          borderClass: 'border-green-500 bg-green-50 text-green-700'
        },
        occupied: {
          text: 'Ocupada',
          classes: 'bg-amber-100 text-amber-800',
          borderClass: 'border-amber-500 bg-amber-50 text-amber-700'
        },
        reserved: {
          text: 'Reservada',
          classes: 'bg-blue-100 text-blue-800',
          borderClass: 'border-blue-500 bg-blue-50 text-blue-700'
        },
        maintenance: {
          text: 'Manutenção',
          classes: 'bg-industrial-100 app-muted',
          borderClass: 'border-industrial-500 bg-industrial-50 app-muted'
        }
      }

      const config = statusConfig[newStatus]
      if (!config) return

      // Atualiza badge
      badge.className = `inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${config.classes}`
      badge.setAttribute('data-current-status', newStatus)
      text.textContent = config.text

      // Atualiza botões
      buttons.forEach((btn, index) => {
        const btnStatus = ['available', 'occupied', 'reserved', 'maintenance'][index]
        const btnConfig = statusConfig[btnStatus]
        
        if (btnStatus === newStatus) {
          btn.className = `quick-status-btn inline-flex justify-center items-center px-3 py-2 border-2 ${btnConfig.borderClass} text-sm font-medium rounded-md transition-all`
        } else {
          btn.className = `quick-status-btn inline-flex justify-center items-center px-3 py-2 border-2 border-industrial-200 bg-white app-muted hover:border-${btnStatus === 'available' ? 'green' : btnStatus === 'occupied' ? 'amber' : btnStatus === 'reserved' ? 'blue' : 'industrial'}-300 hover:bg-${btnStatus === 'available' ? 'green' : btnStatus === 'occupied' ? 'amber' : btnStatus === 'reserved' ? 'blue' : 'industrial'}-50 text-sm font-medium rounded-md transition-all`
        }
      })
    }

    // Mostra feedback visual
    function showStatusFeedback(message, type = 'info') {
      const feedback = document.getElementById('statusFeedback')
      if (!feedback) return

      const typeClasses = {
        success: 'bg-green-100 text-green-800 border-green-300',
        error: 'bg-red-100 text-red-800 border-red-300',
        info: 'bg-blue-100 text-blue-800 border-blue-300'
      }

      feedback.className = `mt-2 p-2 rounded-md text-xs border ${typeClasses[type] || typeClasses.info}`
      feedback.textContent = message
      feedback.classList.remove('hidden')

      if (type !== 'error') {
        setTimeout(() => {
          feedback.classList.add('hidden')
        }, 3000)
      }
    }

    // Auto-atualização via polling (a cada 30s verifica se status mudou)
    async function checkMesaStatusUpdate() {
      if (!MESA_ID || isUpdatingStatus) return

      try {
        const indicator = document.getElementById('autoUpdateIndicator')
        if (indicator) indicator.classList.remove('hidden')

        const response = await fetch(`/api/mesas/${MESA_ID}/status`, {
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })

        if (response.ok) {
          const data = await response.json()
          const currentStatus = document.getElementById('mesaStatusBadge')?.getAttribute('data-current-status')
          
          if (data.status && data.status !== currentStatus) {
            console.log(`Status da mesa mudou: ${currentStatus} → ${data.status}`)
            updateStatusUI(data.status)
            showStatusFeedback('Status atualizado automaticamente', 'info')
          }
        }
      } catch (error) {
        console.warn('Erro ao verificar status:', error)
      } finally {
        const indicator = document.getElementById('autoUpdateIndicator')
        if (indicator) indicator.classList.add('hidden')
      }
    }

    // Inicia polling se há mesa associada
    @if(comanda.mesa)
    if (MESA_ID) {
      // Primeira verificação após 10s
      setTimeout(checkMesaStatusUpdate, 10000)
      
      // Verificações periódicas a cada 30s
      autoUpdateInterval = setInterval(checkMesaStatusUpdate, 30000)
      
      // Limpa ao sair da página
      window.addEventListener('beforeunload', () => {
        if (autoUpdateInterval) clearInterval(autoUpdateInterval)
      })
    }
    @end

    // ============================================================================
    // FIM - Controle de Status da Mesa
    // ============================================================================

    // Lógica da modal de Fechar e Pagar
    const openClosePayModal = document.getElementById('openClosePayModal')
    const closePayModal = document.getElementById('closePayModal')
    const closeClosePayModal = document.getElementById('closeClosePayModal')
    const onlyCloseSaleBtn = document.getElementById('onlyCloseSaleBtn')
    const emitNfceBtn = document.getElementById('emitNfceBtn')
    const emitNfceLabel = document.getElementById('emitNfceLabel')
    const emitNfceInput = document.getElementById('emitNfceInput')
    const closePayForm = document.getElementById('closePayForm')
    const cpfInput = document.getElementById('cpfModal')

    if (openClosePayModal && closePayModal) {
      openClosePayModal.addEventListener('click', () => {
        closePayModal.classList.remove('hidden')
      })
    }

    if (closeClosePayModal && closePayModal) {
      closeClosePayModal.addEventListener('click', () => {
        closePayModal.classList.add('hidden')
      })
    }

    if (closePayModal) {
      closePayModal.addEventListener('click', (e) => {
        if (e.target === closePayModal) {
          closePayModal.classList.add('hidden')
        }
      })
    }

    if (onlyCloseSaleBtn && emitNfceInput && closePayForm) {
      onlyCloseSaleBtn.addEventListener('click', () => {
        emitNfceInput.value = 'false'
        closePayForm.submit()
      })
    }

    if (emitNfceBtn && emitNfceInput && closePayForm) {
      emitNfceBtn.addEventListener('click', () => {
        emitNfceInput.value = 'true'
        emitNfceBtn.setAttribute('disabled', 'disabled')
        emitNfceBtn.classList.add('opacity-60', 'cursor-not-allowed')
        if (emitNfceLabel) {
          emitNfceLabel.textContent = 'Emitindo NF-e...'
        }
        closePayForm.submit()
      })
    }

    // Máscara leve de CPF
    if (cpfInput) {
      cpfInput.addEventListener('input', (e) => {
        const el = e.target
        let v = (el.value || '').replace(/\D/g, '').slice(0, 11)
        if (v.length > 9) el.value = v.replace(/(\d{3})(\d{3})(\d{3})(\d{0,2})/, '$1.$2.$3-$4')
        else if (v.length > 6) el.value = v.replace(/(\d{3})(\d{3})(\d{0,3})/, '$1.$2.$3')
        else if (v.length > 3) el.value = v.replace(/(\d{3})(\d{0,3})/, '$1.$2')
        else el.value = v
      })
    }

    // Validação leve dos dígitos verificadores de CPF (não bloqueante)
    function isValidCpfDigits(raw) {
      const cpf = raw.replace(/\D/g, '')
      if (!cpf || cpf.length !== 11) return false
      if (/^(\d)\1{10}$/.test(cpf)) return false
      let sum = 0
      for (let i = 0; i < 9; i++) sum += Number(cpf[i]) * (10 - i)
      let dv1 = (sum * 10) % 11
      if (dv1 === 10) dv1 = 0
      if (dv1 !== Number(cpf[9])) return false
      sum = 0
      for (let i = 0; i < 10; i++) sum += Number(cpf[i]) * (11 - i)
      let dv2 = (sum * 10) % 11
      if (dv2 === 10) dv2 = 0
      return dv2 === Number(cpf[10])
    }

    if (cpfInput) {
      cpfInput.addEventListener('blur', () => {
        const hint = document.getElementById('cpfHint')
        const val = cpfInput.value || ''
        const onlyDigits = val.replace(/\D/g, '')
        if (onlyDigits.length === 0) {
          if (hint) {
            hint.textContent = 'Preencha somente se desejar emitir NF-e com CPF do consumidor.'
            hint.classList.remove('text-red-600')
            hint.classList.add('text-industrial-500')
          }
          return
        }
        if (isValidCpfDigits(val)) {
          if (hint) {
            hint.textContent = 'CPF válido (opcional).'
            hint.classList.remove('text-red-600')
            hint.classList.add('text-industrial-500')
          }
        } else {
          if (hint) {
            hint.textContent = 'CPF parece inválido. Você pode continuar mesmo assim.'
            hint.classList.remove('text-industrial-500')
            hint.classList.add('text-red-600')
          }
        }
      })
    }
  </script>

  @include('components/quick_actions')
</body>
</html>