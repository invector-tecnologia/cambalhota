<!DOCTYPE html>
<html>
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Nota de Consumo - Comanda {{ comanda.number }}</title>
    <style>
        /* Estilos para impressoras térmicas de 80mm */
        @page {
            size: 80mm auto;
            margin: 0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            line-height: 1.4;
            color: #000;
            background: #fff;
            width: 80mm;
            padding: 5mm;
            margin: 0 auto; /* Centraliza horizontalmente dentro do iframe */
            font-weight: bold;
        }

        .receipt {
            width: 100%;
            margin: 0 auto; /* Centraliza o conteúdo dentro da largura fixa */
        }

        /* Header com Logo */
        .header {
            text-align: center;
            border-bottom: 2px solid #000;
            padding-bottom: 8px;
            margin-bottom: 8px;
        }

        .logo {
            max-width: 60mm;
            max-height: 25mm;
            margin: 0 auto 8px;
            display: block;
        }

        .empresa-nome {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 2px;
        }

        .empresa-info {
            font-size: 10px;
            line-height: 1.3;
        }

        /* Seção de informações */
        .info-section {
            margin-bottom: 8px;
            font-size: 11px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
        }

        .info-label {
            font-weight: bold;
        }

        /* Separadores */
        .separator {
            border-top: 2px solid #000;
            margin: 8px 0;
        }

        .separator-dashed {
            border-top: 1px dashed #000;
            margin: 6px 0;
        }

        /* Títulos de seção */
        .section-title {
            font-weight: bold;
            font-size: 12px;
            margin-bottom: 4px;
            text-align: center;
        }

        /* Itens da venda */
        .items-section {
            margin: 8px 0;
        }

        .item {
            margin-bottom: 6px;
        }

        .item-name {
            font-weight: bold;
            margin-bottom: 2px;
        }

        .item-details {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            font-weight: bold;
        }

        /* Total */
        .total-section {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 2px solid #000;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 4px;
            font-size: 11px;
        }

        .total-final {
            font-size: 14px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            margin-top: 6px;
            padding-top: 6px;
            border-top: 1px solid #000;
        }

        /* Rodapé */
        .footer {
            margin-top: 12px;
            padding-top: 8px;
            border-top: 2px solid #000;
            text-align: center;
            font-size: 10px;
        }

        .footer-message {
            margin-bottom: 6px;
            line-height: 1.4;
        }

        .footer-info {
            font-size: 9px;
            color: #666;
            margin-top: 6px;
        }

        /* Impressão */
        @media print {
            body {
                width: 80mm;
            }

            .no-print {
                display: none !important;
            }
        }

        

        .doc-type {
            font-size: 13px;
            font-weight: bold;
            text-align: center;
            margin: 8px 0;
            padding: 6px;
            background: #f0f0f0;
            border: 1px solid #000;
        }
    </style>
</head>
<body>    
    <div class="receipt">
        <!-- Header com Logo e Informações da Empresa -->
        <div class="header">
            @if(empresa.logoUrl)
                <img src="{{ empresa.logoUrl }}" alt="Logo" class="logo">
            @end
            
            <div class="empresa-nome">{{ empresa.razaoSocial }}</div>
            
            @if(empresa.tradeName)
                <div class="empresa-info">{{ empresa.tradeName }}</div>
            @end
            
            @if(empresa.documentType === 'cpf')
                <div class="empresa-info">CPF: {{ empresa.formattedDocument }}</div>
            @else
                <div class="empresa-info">CNPJ: {{ empresa.formattedDocument }}</div>
            @end
            <div class="empresa-info">{{ empresa.address }}, {{ empresa.addressNumber || 'S/N' }}</div>
            
            @if(empresa.addressComplement)
                <div class="empresa-info">{{ empresa.addressComplement }}</div>
            @end
            
            <div class="empresa-info">
                {{ empresa.neighborhood }} - {{ empresa.city }}/{{ empresa.state }}
            </div>
            <div class="empresa-info">CEP: {{ empresa.zipCode }}</div>
            
            @if(empresa.phone)
                <div class="empresa-info">Tel: {{ empresa.phone }}</div>
            @end
            
            @if(empresa.email)
                <div class="empresa-info">{{ empresa.email }}</div>
            @end
        </div>

        <!-- Tipo de Documento -->
        <div class="doc-type">
            NOTA DE CONSUMO
        </div>

        <!-- Informações da Comanda -->
        <div class="info-section">
            <div class="info-row">
                <span class="info-label">COMANDA Nº:</span>
                <span>{{ comanda.number }}</span>
            </div>
            @if(comanda.name)
                <div class="info-row">
                    <span class="info-label">NOME:</span>
                    <span>{{ comanda.name }}</span>
                </div>
            @end
            @if(comanda.mesa)
                <div class="info-row">
                    <span class="info-label">MESA:</span>
                    <span>{{ comanda.mesa.name || comanda.mesa.number }}</span>
                </div>
            @end
            <div class="info-row">
                <span class="info-label">DATA/HORA:</span>
                <span data-now="datetime"></span>
            </div>
        </div>

        <!-- Itens Consumidos -->
        <div class="separator"></div>
        <div class="section-title">ITENS CONSUMIDOS</div>
        <div class="separator-dashed"></div>

        <div class="items-section">
            @if(comanda.allItems && comanda.allItems.length > 0)
                @each(item in comanda.allItems)
                    <div class="item">
                        <div class="item-name">{{ item.itemName }}</div>
                        <div class="item-details">
                            <span>
                                {{ item.quantity }} x 
                                R$ {{ Number(item.unitPrice || 0).toFixed(2).replace('.', ',') }}
                            </span>
                            <span>
                                R$ {{ Number(item.subtotal || 0).toFixed(2).replace('.', ',') }}
                            </span>
                        </div>
                        @if(item.notes)
                            <div style="font-size: 10px; margin-top: 2px; color: #666;">
                                Obs: {{ item.notes }}
                            </div>
                        @end
                    </div>
                @end
            @else
                <div class="item">
                    <div class="item-name" style="text-align: center; color: #666;">
                        Nenhum item consumido
                    </div>
                </div>
            @end
        </div>

        <!-- Total -->
        <div class="total-section">
            <div class="total-row">
                <span>SUBTOTAL:</span>
                <span>R$ {{ Number(comanda.totalComanda + comanda.totalDiscount - comanda.totalServiceCharge || 0).toFixed(2).replace('.', ',') }}</span>
            </div>
            
            <div class="total-row" style="color: green;">
                <span>DESCONTO:</span>
                <span>- R$ {{ Number(comanda.totalDiscount || 0).toFixed(2).replace('.', ',') }}</span>
            </div>
            
            <div class="total-row" style="color: red;">
                <span>TAXAS:</span>
                <span>+ R$ {{ Number(comanda.totalServiceCharge || 0).toFixed(2).replace('.', ',') }}</span>
            </div>
            
            <div class="total-final">
                <span>TOTAL A PAGAR:</span>
                <span>R$ {{ Number(comanda.totalComanda || 0).toFixed(2).replace('.', ',') }}</span>
            </div>

            @if(comanda.notes)
                <div class="separator-dashed"></div>
                <div style="font-size: 10px; margin-top: 6px;">
                    <strong>OBSERVAÇÕES:</strong><br>
                    {{ comanda.notes }}
                </div>
            @end
        </div>

        <!-- Rodapé com Mensagem Personalizada -->
        <div class="footer">
            @if(empresa.notaFiscalFooterMessage)
                <div class="footer-message">
                    {{ empresa.notaFiscalFooterMessage }}
                </div>
            @end

            <div class="footer-info">
                Este documento não tem valor fiscal
            </div>
            <div class="footer-info">
                Nota de Consumo - Emitida em <span data-now="datetime"></span>
            </div>
            @if(empresa.website)
                <div class="footer-info">
                    {{ empresa.website }}
                </div>
            @end
        </div>
    </div>

    <script>
        window.onafterprint = function() {
            // Mantém a janela aberta; modal controla fechamento se necessário
        };
    </script>
    <script>
        (function () {
            const dateTimeFormatter = new Intl.DateTimeFormat('pt-BR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            })

            document.querySelectorAll('[data-now="datetime"]').forEach((el) => {
                el.textContent = dateTimeFormatter.format(new Date())
            })
        })()
    </script>
</body>
</html>
