    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
        <!-- Filtros -->
        <div class="bg-white  rounded-xl ring-1 ring-industrial-100 mb-6">
          <div class="px-6 py-4 border-b border-industrial-100">
            <h2 class="text-lg font-semibold text-industrial-900">Filtros</h2>
          </div>
          <div class="p-6">
            <form method="GET" action="{{ route('comandas.index') }}" class="grid grid-cols-1 gap-4 md:grid-cols-4">
              <div>
                <label for="search" class="block text-sm font-medium app-muted mb-2">Buscar</label>
                <input type="text" name="search" id="search" value="{{ filters.search || '' }}"
                  placeholder="Número ou nome..."
                  class="w-full px-4 py-2 app-border rounded-lg  focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
              </div>
              <div>
                <label for="mesa_id" class="block text-sm font-medium app-muted mb-2">Mesa</label>
                <select name="mesa_id" id="mesa_id"
                  class="w-full px-4 py-2 app-border rounded-lg  focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                  <option value="">Todas</option>
                  @each(mesa in mesas)
                  <option value="{{ mesa.id }}" {{ filters.mesaId == mesa.id ? 'selected' : '' }}>
                    Mesa {{ mesa.number }} {{ mesa.name ? '- ' + mesa.name : '' }}
                  </option>
                  @end
                </select>
              </div>
              <div>
                <label for="inactive_from" class="block text-sm font-medium app-muted mb-2">Inativadas desde</label>
                <input type="date" name="inactive_from" id="inactive_from" value="{{ filters.inactiveFrom || '' }}"
                  class="w-full px-4 py-2 app-border rounded-lg  focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
              </div>
              <div class="flex items-end gap-2">
                <button type="submit"
                  class="flex-1 inline-flex justify-center items-center gap-2 rounded-lg bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
                  <i class="fas fa-search"></i> Filtrar
                </button>
                @if(filters.search || filters.mesaId || filters.inactiveFrom)
                <a href="{{ route('comandas.index') }}"
                  class="inline-flex items-center rounded-lg bg-industrial-100 px-3 py-2 text-sm font-semibold app-muted  hover:bg-industrial-200">
                  <i class="fas fa-times"></i>
                </a>
                @endif
              </div>
            </form>
          </div>
        </div>

        <!-- Separar comandas ativas de inativas -->
