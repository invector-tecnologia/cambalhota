            <p class="mt-1 text-sm text-industrial-500">Comece criando uma nova comanda para o estabelecimento.</p>
            <div class="mt-6">
              <a href="{{ route('comandas.create') }}"
                class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
                <i class="fas fa-plus"></i>
                Nova Comanda
