            </div>
          </div>
        </div>
        @else
        @if(activeComandasList.length > 0)
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-industrial-900 mb-4 flex items-center gap-2">
            <i class="fas fa-check-circle text-green-600"></i>
            Comandas Ativas
          </h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @each(comanda in activeComandasList)
            <div
              class="comanda-card bg-white overflow-hidden  rounded-xl ring-1 ring-industrial-100 border-l-4 border-accent-500">
              <div class="p-5">
                <div class="flex items-center justify-between">
                  <div class="flex-1 min-w-0">
                    <h3 class="text-xl font-bold text-industrial-900 truncate">{{ comanda.name || 'Comanda ' + comanda.number
                      }}</h3>
                    <p class="text-sm text-industrial-500">Nº {{ comanda.number }}</p>
                  </div>
                </div>

                @if(comanda.mesa)
                <div class="mt-3 flex items-center text-sm app-muted">
                  <i class="fas fa-chair mr-2"></i>
                  <span class="text-base font-semibold app-muted">Mesa {{ comanda.mesa.number }}</span>
                </div>
                @end

                @if(comanda.notes)
                <p class="mt-3 text-sm app-muted truncate">{{ comanda.notes }}</p>
                @end

                <div class="mt-4 flex items-center gap-2">
                  <a href="{{ route('comandas.show', [comanda.id]) }}"
                    class="inline-flex items-center px-3 py-2 app-border  text-sm font-semibold rounded-lg text-accent-700 bg-white hover:bg-accent-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-500">
                    <i class="fas fa-eye"></i>
                  </a>

                  <a href="{{ route('comandas.edit', [comanda.id]) }}"
                    class="inline-flex items-center px-3 py-2 app-border  text-sm font-semibold rounded-lg app-muted bg-white hover:bg-industrial-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-industrial-500">
                    <i class="fas fa-edit"></i>
                  </a>

                  <button type="button" onclick="confirmarExclusao({{ comanda.id }})"
                    class="inline-flex items-center px-3 py-2 app-border  text-sm font-semibold rounded-lg text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
            </div>
            @end
          </div>
        </div>
