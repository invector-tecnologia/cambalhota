  <style>
    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }

    .comanda-card {
      transition: all 0.3s ease;
    }

    .comanda-card:hover {
      transform: translateY(-2px);
