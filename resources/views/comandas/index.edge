        <!-- Tabela de Comandas Inativas -->
        @if(inactiveComandasList.length > 0)
        <div class="mt-8">
          <h2 class="text-lg font-semibold text-industrial-900 mb-4 flex items-center gap-2">
            <i class="fas fa-times-circle text-red-600"></i>
            Comandas Inativas
            @if(!filters.inactiveFrom)
            <span class="text-sm font-normal app-muted">(últimas 12 horas)</span>
            @endif
          </h2>
          <div class="bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-industrial-100">
                <thead class="bg-industrial-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                      Número
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                      Nome
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                      Mesa
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                      Observações
                    </th>
                    <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                      Ações
                    </th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-industrial-100">
                  @each(comanda in inactiveComandasList)
                  <tr class="hover:bg-industrial-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm font-semibold text-industrial-900">{{ comanda.number }}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-industrial-900">{{ comanda.name || '-' }}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm app-muted">{{ comanda.mesa ? 'Mesa ' + comanda.mesa.number : '-' }}</div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-sm app-muted truncate max-w-xs">{{ comanda.notes || '-' }}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="flex items-center justify-end gap-3">
                        <a href="{{ route('comandas.show', [comanda.id]) }}" class="text-accent-600 hover:text-accent-500"
                          title="Ver detalhes">
                          <i class="fas fa-eye"></i>
                        </a>
                        <a href="{{ route('comandas.edit', [comanda.id]) }}" class="app-muted hover:text-industrial-500"
                          title="Editar">
                          <i class="fas fa-edit"></i>
                        </a>
                        <button type="button" onclick="confirmarExclusao({{ comanda.id }})" class="text-red-600 hover:text-red-500"
                          title="Excluir">
                          <i class="fas fa-trash"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                  @end
                </tbody>
              </table>
            </div>
          </div>
        </div>
        @endif

        <!-- Paginação -->
        @if(comandas.meta.lastPage > 1)
        <div class="mt-6 flex items-center justify-center">
          <nav class="relative z-0 inline-flex rounded-lg  gap-2" aria-label="Pagination">
            @each(page in Array.from({length: comandas.meta.lastPage}, (_, i) => i + 1))
            <a href="{{ route('comandas.index', {}, {qs: {...filters, page}}) }}"
              class="relative inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold {{ comandas.meta.currentPage === page ? 'bg-accent-600 text-white' : 'bg-white app-border app-muted hover:bg-industrial-50' }}">
              {{ page }}
            </a>
            @end
          </nav>
        </div>
        @endif
        @endif
      </div>
    </main>
  </div>

  <!-- Modal de Confirmação de Exclusão -->
  <div id="deleteModal" class="hidden fixed z-10 inset-0 overflow-y-auto" aria-labelledby="modal-title" role="dialog"
    aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-industrial-900 bg-opacity-75 transition-opacity" aria-hidden="true"
        onclick="fecharModal()"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
      <div
        class="inline-block align-bottom bg-white rounded-xl text-left overflow-hidden-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div
              class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
              <i class="fas fa-exclamation-triangle text-red-600"></i>
            </div>
            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
              <h3 class="text-lg leading-6 font-semibold text-industrial-900" id="modal-title">Confirmar Exclusão</h3>
              <div class="mt-2">
                <p class="text-sm app-muted">Tem certeza que deseja excluir esta comanda?</p>
                <p class="text-sm text-red-600 mt-1 font-semibold">Esta ação não pode ser desfeita.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-industrial-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
          <form id="deleteForm" method="POST">
            {{ csrfField() }}
            <input type="hidden" name="_method" value="DELETE">  
            <button type="submit"
              class="w-full inline-flex justify-center rounded-lg  px-4 py-2 bg-accent-600 text-base font-semibold text-white hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
              Excluir
            </button>
          </form>
          <button type="button" onclick="fecharModal()"
            class="mt-3 w-full inline-flex justify-center rounded-lg app-border  px-4 py-2 bg-white text-base font-semibold app-muted hover:bg-industrial-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
            Cancelar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function confirmarExclusao(comandaId) {
      const modal = document.getElementById('deleteModal');
      const form = document.getElementById('deleteForm');
      form.action = `/comandas/${comandaId}/deletar`;
      modal.classList.remove('hidden');
    }

    function fecharModal() {
      document.getElementById('deleteModal').classList.add('hidden');
    }
  </script>
  @include('components/quick_actions')
</body>
</html>