          <div>
            <p class="text-sm font-semibold text-industrial-900">Pré-visualização de Impressão</p>
            <p class="text-xs text-industrial-500">Caixa #{{ currentRegister.id }}</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button id="printFromModalCurrent" class="inline-flex items-center bg-accent-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-accent-500">
            <i class="fas fa-print mr-2"></i> Imprimir
          </button>
          <button id="closeModalCurrent" class="inline-flex items-center bg-white app-muted ring-1 ring-industrial-200 px-3 py-2 rounded-lg text-sm font-semibold hover:bg-industrial-50">
            <i class="fas fa-times mr-2"></i> Fechar
          </button>
        </div>
      </div>
      <div class="flex-1 overflow-hidden">
        <iframe id="printFrameCurrent" class="w-full h-full" title="Pré-visualização de impressão"></iframe>
      </div>
    </div>
  </div>
  @endif

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const printModalBtn = document.getElementById('printModalBtnCurrent')
      const printModal = document.getElementById('printModalCurrent')
      const closeModal = document.getElementById('closeModalCurrent')
      const printFromModal = document.getElementById('printFromModalCurrent')
      const printFrame = document.getElementById('printFrameCurrent')
      const printUrl = "{{ currentRegister ? '/financeiro/caixa/' + currentRegister.id + '/imprimir' : '' }}"

      if (printModalBtn && printModal) {
        printModalBtn.addEventListener('click', () => {
          if (printFrame && printUrl) {
            printFrame.src = printUrl
          }
          printModal.classList.remove('hidden')
        })
      }

      closeModal?.addEventListener('click', () => {
        printModal.classList.add('hidden')
      })

      printModal?.addEventListener('click', (e) => {
        if (e.target === printModal) {
          printModal.classList.add('hidden')
        }
      })

      if (printFromModal && printFrame) {
        printFromModal.addEventListener('click', () => {
          setTimeout(() => {
            try {
              printFrame.contentWindow.print()
            } catch (error) {
              console.error('Erro ao imprimir:', error)
              window.print()
            }
          }, 500)
        })
      }

      // Auto-atualização do caixa
      @if(currentRegister)
      const autoUpdateIndicator = document.getElementById('autoUpdateIndicator')
      const lastUpdateText = document.getElementById('lastUpdateText')
      const updateInterval = 30000 // 30 segundos

      function formatCurrency(value) {
        return new Intl.NumberFormat('pt-BR', {
          style: 'currency',
          currency: 'BRL'
        }).format(value)
      }

      const timeFormatter = new Intl.DateTimeFormat('pt-BR', {
        hour: '2-digit',
        minute: '2-digit'
      })
      const timeWithSecondsFormatter = new Intl.DateTimeFormat('pt-BR', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      })

      function formatTime(date) {
        if (!date) return '--:--'
        try {
          const dateObj = typeof date === 'string' ? new Date(date) : date
          return timeFormatter.format(dateObj)
        } catch (error) {
          console.error('Erro ao formatar horário:', error)
          return '--:--'
        }
      }

      function getPaymentMethodBadgeClass(method) {
        if (method === 'cash') return 'bg-green-100 text-green-800'
        if (method === 'card') return 'bg-blue-100 text-blue-800'
        return 'bg-purple-100 text-purple-800'
      }

      function getPaymentMethodLabel(method) {
        if (method === 'cash') return '💵 Dinheiro'
        if (method === 'card') return '💳 Cartão'
        return '📱 PIX'
      }

      async function updateCaixaData() {
        try {
          if (lastUpdateText) {
            lastUpdateText.textContent = 'Atualizando...'
          }

          const response = await fetch('/api/financeiro/caixa/atual/dados')
          const data = await response.json()

          if (!data.hasRegister) {
            window.location.reload()
            return
          }

          // Atualizar cards de estatísticas
          const stats = data.stats
          const register = data.register

          // Total de Vendas
          const salesCard = document.querySelector('[style*="animation-delay: 0.3s"] .text-2xl')
          if (salesCard) salesCard.textContent = formatCurrency(stats.sales)
          
          const transactionsText = document.querySelector('[style*="animation-delay: 0.3s"] .text-xs')
          if (transactionsText) transactionsText.innerHTML = '<i class="fas fa-receipt mr-1"></i> ' + stats.transactions + ' transações'

          // Lucro
          const profitCard = document.querySelector('[style*="animation-delay: 0.4s"] .text-2xl')
          if (profitCard) profitCard.textContent = formatCurrency(stats.profit)
          
          const marginText = document.querySelector('[style*="animation-delay: 0.4s"] .text-xs')
          if (marginText) marginText.innerHTML = '<i class="fas fa-percentage mr-1"></i> Margem: ' + stats.margin.toFixed(1) + '%'

          // Vendas por método de pagamento
          const cashCard = document.querySelector('[style*="animation-delay: 0.5s"] .text-3xl')
          if (cashCard) cashCard.textContent = formatCurrency(register.cashSales || 0)
          
          const expectedText = document.querySelector('[style*="animation-delay: 0.5s"] .text-green-600')
          if (expectedText) expectedText.textContent = formatCurrency(stats.expected)

          const cardCard = document.querySelector('[style*="animation-delay: 0.6s"] .text-3xl')
          if (cardCard) cardCard.textContent = formatCurrency(register.cardSales || 0)

          const pixCard = document.querySelector('[style*="animation-delay: 0.7s"] .text-3xl')
          if (pixCard) pixCard.textContent = formatCurrency(register.pixSales || 0)

          // Métricas adicionais
          const costCard = document.querySelector('[style*="animation-delay: 0.8s"] .financial-cost')
          if (costCard) costCard.textContent = formatCurrency(stats.cost)

          const transCard = document.querySelector('[style*="animation-delay: 0.9s"] .text-2xl')
          if (transCard) transCard.textContent = stats.transactions

          const ticketCard = document.querySelector('[style*="animation-delay: 1s"] .text-2xl')
          if (ticketCard) ticketCard.textContent = formatCurrency(stats.averageTicket)

          // Atualizar tabela de vendas
          const tbody = document.querySelector('tbody.bg-white')
          if (tbody && data.sales && data.sales.length > 0) {
            tbody.innerHTML = data.sales.map(sale => `
              <tr class="hover:bg-industrial-50 transition">
                <td class="px-4 py-3 text-sm text-industrial-900">
                  <span data-timestamp="${sale.saleDate}">${formatTime(sale.saleDate)}</span>
                </td>
                <td class="px-4 py-3 text-sm text-industrial-900">
                  ${sale.tableNumber || '-'}
                </td>
                <td class="px-4 py-3 text-sm">
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${getPaymentMethodBadgeClass(sale.paymentMethod)}">
                    ${getPaymentMethodLabel(sale.paymentMethod)}
                  </span>
                </td>
                <td class="px-4 py-3 text-sm text-right font-semibold text-industrial-900">
                  ${formatCurrency(parseFloat(sale.total))}
                </td>
                <td class="px-4 py-3 text-right text-sm">
                  <a href="/financeiro/vendas/${sale.id}" class="text-accent-600 hover:text-accent-700">
                    <i class="fas fa-eye"></i>
                  </a>
                </td>
              </tr>
            `).join('')
          }

          // Atualizar contador de vendas
          const salesCountText = document.querySelector('[style*="animation-delay: 1.2s"] .text-sm.font-normal')
          if (salesCountText) salesCountText.textContent = data.sales.length + ' vendas'

          if (lastUpdateText) {
            const now = new Date()
            lastUpdateText.textContent = 'Atualizado às ' + timeWithSecondsFormatter.format(now)
          }
        } catch (error) {
          console.error('Erro ao atualizar dados do caixa:', error)
          if (lastUpdateText) {
            lastUpdateText.textContent = 'Erro na atualização'
          }
        }
      }

      // Atualizar a cada 30 segundos
      setInterval(updateCaixaData, updateInterval)
      
      // Primeira atualização após 5 segundos
      setTimeout(updateCaixaData, 5000)
      @endif
    })
  </script>

  @include('components/quick_actions')
</body>
</html>
