  <style>
    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .stat-card {
      animation: slideIn 0.5s ease-out forwards;
    }
    .stat-card:hover {
      transform: translateY(-4px);
      transition: transform 0.3s ease;
    }
    @media print {
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
