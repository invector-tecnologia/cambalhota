<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Movimento de Caixa - Tavolo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
  <style>
    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .stat-card {
      animation: slideIn 0.5s ease-out forwards;
    }
    .stat-card:hover {
      transform: translateY(-4px);
      transition: transform 0.3s ease;
    }
    @media print {
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="h-full font-sans text-industrial-900">
  <div class="min-h-full">
    <header class="bg-white  no-print">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div class="bg-accent-500/10 rounded-xl p-2">
            <i class="fas fa-chart-line text-accent-600 text-xl"></i>
          </div>
          <h1 class="text-2xl font-bold leading-6 text-industrial-900">Movimento de Caixa</h1>
          <div class="flex items-center space-x-3 ml-auto">
            <button onclick="exportToCSV()" class="inline-flex items-center rounded-lg bg-industrial-800 px-4 py-2 text-sm font-semibold text-white hover:bg-industrial-700 transition">
              <i class="fas fa-file-csv mr-2"></i>
              Exportar CSV
            </button>
            <button onclick="window.print()" class="inline-flex items-center rounded-lg bg-white ring-1 ring-industrial-200 px-4 py-2 text-sm font-semibold app-muted hover:bg-industrial-50 transition">
              <i class="fas fa-print mr-2"></i>
              Imprimir
            </button>
            <a href="{{ route('cashRegisters.current') }}" class="inline-flex items-center rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white hover:bg-accent-700 transition">
              <i class="fas fa-cash-register mr-2"></i>
              Caixa Atual
            </a>
            <a href="{{ route('cashRegisters.index') }}" class="inline-flex items-center rounded-lg bg-white ring-1 ring-industrial-200 px-4 py-2 text-sm font-semibold app-muted hover:bg-industrial-50 transition">
              <i class="fas fa-list mr-2"></i> Lista de Reg. de Caixas
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-8 px-4 sm:px-6 lg:px-8">
        
        <!-- Filtros -->
        <div class="stat-card bg-white ring-1 ring-industrial-100 rounded-xl overflow-hidden mb-8 no-print" style="animation-delay: 0.1s">
          <div class="px-6 py-4 border-b border-industrial-100 bg-industrial-50">
            <h2 class="text-lg font-bold text-industrial-900 flex items-center">
              <i class="fas fa-filter text-accent-600 mr-2"></i>
              Filtros de Período
            </h2>
          </div>
          <div class="p-6">
            <form action="{{ route('cashRegisters.movement') }}" method="GET" class="grid grid-cols-1 md:grid-cols-5 gap-4">
              <div class="md:col-span-2">
                <label for="date_from" class="block text-sm font-semibold app-muted mb-2">
                  <i class="far fa-calendar-alt text-accent-600 mr-2"></i>
                  Data Inicial
                </label>
                <input 
                  type="date" 
                  name="date_from" 
                  id="date_from" 
                  value="{{ filters.dateFrom }}"
                  class="block w-full px-4 py-2.5 ring-1 ring-industrial-200 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition"
                >
              </div>

              <div class="md:col-span-2">
                <label for="date_to" class="block text-sm font-semibold app-muted mb-2">
                  <i class="far fa-calendar-check text-accent-600 mr-2"></i>
                  Data Final
                </label>
                <input 
                  type="date" 
                  name="date_to" 
                  id="date_to" 
                  value="{{ filters.dateTo }}"
                  class="block w-full px-4 py-2.5 ring-1 ring-industrial-200 rounded-lg focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition"
                >
              </div>

              <div class="flex items-end space-x-2">
                <button type="submit" class="flex-1 inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-accent-500 to-accent-700 px-4 py-2.5 text-sm font-semibold text-white hover:from-accent-600 hover:to-accent-700 transition">
                  <i class="fas fa-search mr-2"></i>
                  Filtrar
                </button>
                <a href="{{ route('cashRegisters.movement') }}" class="inline-flex items-center justify-center rounded-lg ring-1 ring-industrial-200 bg-white px-4 py-2.5 text-sm font-semibold app-muted hover:bg-industrial-50 transition">
                  <i class="fas fa-redo mr-2"></i>
                  Limpar
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Resumo do Período -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <!-- Total de Vendas -->
          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden" style="animation-delay: 0.2s">
            <div class="bg-gradient-to-r bg-accent-600 px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-accent-100 text-sm font-medium">Total de Vendas</p>
                  <p class="text-white text-2xl font-bold mt-1">{{ formatCurrency(totals.totalSales) }}</p>
                </div>
                <div class="bg-accent-500/10 rounded-lg p-3">
                  <i class="fas fa-dollar-sign text-white text-2xl"></i>
                </div>
              </div>
            </div>
            <div class="px-6 py-3 bg-accent-50">
              <p class="text-xs text-accent-600 font-medium">
                <i class="fas fa-calendar-alt mr-1"></i>
                No período selecionado
              </p>
            </div>
          </div>

          <!-- Lucro -->
          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden" style="animation-delay: 0.3s">
            <div class="bg-gradient-to-r from-emerald-500 to-emerald-600 px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-emerald-100 text-sm font-medium">Lucro Total</p>
                  <p class="text-white text-2xl font-bold mt-1">{{ formatCurrency(totals.totalProfit) }}</p>
                </div>
                <div class="bg-accent-500/10 rounded-lg p-3">
                  <i class="fas fa-chart-line text-white text-2xl"></i>
                </div>
              </div>
            </div>
            <div class="px-6 py-3 bg-emerald-50">
              <p class="text-xs text-emerald-700 font-medium">
                <i class="fas fa-percentage mr-1"></i>
                Margem: {{ (typeof totals.profitMargin === 'number' ? totals.profitMargin : 0).toFixed(1) }}%
              </p>
            </div>
          </div>

          <!-- Transações -->
          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden" style="animation-delay: 0.4s">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-blue-100 text-sm font-medium">Transações</p>
                  <p class="text-white text-2xl font-bold mt-1">{{ totals.totalTransactions }}</p>
                </div>
                <div class="bg-accent-500/10 rounded-lg p-3">
                  <i class="fas fa-receipt text-white text-2xl"></i>
                </div>
              </div>
            </div>
            <div class="px-6 py-3 bg-blue-50">
              <p class="text-xs text-blue-700 font-medium">
                <i class="fas fa-shopping-cart mr-1"></i>
                Vendas realizadas
              </p>
            </div>
          </div>

          <!-- Ticket Médio -->
          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden" style="animation-delay: 0.5s">
            <div class="bg-gradient-to-r from-accent-500 to-accent-700 px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-purple-100 text-sm font-medium">Ticket Médio</p>
                  <p class="text-white text-2xl font-bold mt-1">{{ formatCurrency(totals.averageTicket) }}</p>
                </div>
                <div class="bg-accent-500/10 rounded-lg p-3">
                  <i class="fas fa-calculator text-white text-2xl"></i>
                </div>
              </div>
            </div>
            <div class="px-6 py-3 bg-purple-50">
              <p class="text-xs text-purple-700 font-medium">
                <i class="fas fa-chart-bar mr-1"></i>
                Por transação
              </p>
            </div>
          </div>
        </div>

        <!-- Vendas por Método de Pagamento -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 p-6" style="animation-delay: 0.6s">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-industrial-900 flex items-center">
                <i class="fas fa-money-bill-wave text-green-600 mr-2"></i>
                Dinheiro
              </h3>
              <span class="text-2xl">💵</span>
            </div>
            <p class="text-3xl font-bold text-industrial-900 mb-2">{{ formatCurrency(totals.cashSales) }}</p>
            <div class="flex items-center justify-between text-sm">
              <span class="app-muted">% do total:</span>
              <span class="font-semibold text-green-600">{{ totals.totalSales > 0 ? ((totals.cashSales / totals.totalSales) * 100).toFixed(1) : 0 }}%</span>
            </div>
          </div>

          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 p-6" style="animation-delay: 0.7s">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-industrial-900 flex items-center">
                <i class="fas fa-credit-card text-blue-600 mr-2"></i>
                Cartão
              </h3>
              <span class="text-2xl">💳</span>
            </div>
            <p class="text-3xl font-bold text-industrial-900 mb-2">{{ formatCurrency(totals.cardSales) }}</p>
            <div class="flex items-center justify-between text-sm">
              <span class="app-muted">% do total:</span>
              <span class="font-semibold text-blue-600">{{ totals.totalSales > 0 ? ((totals.cardSales / totals.totalSales) * 100).toFixed(1) : 0 }}%</span>
            </div>
          </div>

          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 p-6" style="animation-delay: 0.8s">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-industrial-900 flex items-center">
                <i class="fas fa-qrcode text-accent-600 mr-2"></i>
                PIX
              </h3>
              <span class="text-2xl">📱</span>
            </div>
            <p class="text-3xl font-bold text-industrial-900 mb-2">{{ formatCurrency(totals.pixSales) }}</p>
            <div class="flex items-center justify-between text-sm">
              <span class="app-muted">% do total:</span>
              <span class="font-semibold text-accent-600">{{ totals.totalSales > 0 ? ((totals.pixSales / totals.totalSales) * 100).toFixed(1) : 0 }}%</span>
            </div>
          </div>
        </div>

        <!-- Gráficos -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
          <!-- Evolução das Vendas -->
          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden" style="animation-delay: 0.9s">
            <div class="px-6 py-4 border-b border-industrial-100 bg-industrial-50">
              <h3 class="text-lg font-bold text-industrial-900 flex items-center">
                <i class="fas fa-chart-area text-accent-600 mr-2"></i>
                Evolução de Vendas e Lucro
              </h3>
            </div>
            <div class="p-6">
              <canvas id="evolutionChart" style="max-height: 300px;"></canvas>
            </div>
          </div>

          <!-- Métodos de Pagamento -->
          <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden" style="animation-delay: 1s">
            <div class="px-6 py-4 border-b border-industrial-100 bg-gradient-to-r from-green-50 to-emerald-50">
              <h3 class="text-lg font-bold text-industrial-900 flex items-center">
                <i class="fas fa-chart-pie text-green-600 mr-2"></i>
                Distribuição por Método
              </h3>
            </div>
            <div class="p-6">
              <canvas id="paymentChart" style="max-height: 300px;"></canvas>
            </div>
          </div>
        </div>

        <!-- Tabela de Registros -->
        <div class="stat-card bg-white rounded-xl ring-1 ring-industrial-100 overflow-hidden" style="animation-delay: 1.1s">
          <div class="px-6 py-4 border-b border-industrial-100 bg-industrial-50">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-bold text-industrial-900 flex items-center">
                <i class="fas fa-table app-muted mr-2"></i>
                Registros do Período
              </h3>
              <span class="text-sm app-muted">{{ registros.length }} registros</span>
            </div>
          </div>
          <div class="overflow-x-auto">
            @if(registros && registros.length > 0)
            <table class="min-w-full divide-y divide-industrial-100" id="dataTable">
              <thead class="bg-industrial-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="far fa-calendar mr-1"></i> Data
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="fas fa-user mr-1"></i> Responsável
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="fas fa-dollar-sign mr-1"></i> Vendas
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="fas fa-chart-line mr-1"></i> Lucro
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="fas fa-percentage mr-1"></i> Margem
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="fas fa-receipt mr-1"></i> Transações
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="fas fa-flag mr-1"></i> Status
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-medium app-muted uppercase tracking-wider">
                    <i class="fas fa-eye mr-1"></i> Ação
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-industrial-100">
                @each(registro in registros)
                <tr class="hover:bg-industrial-50 transition">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-industrial-900">
                    {{{ formatDateOnlyTimestamp(registro.registerDate) }}}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm app-muted">
                    {{ registro.user ? registro.user.fullName : 'N/A' }}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold text-industrial-900">
                    {{ formatCurrency(registro.regSales) }}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold text-green-600">
                    {{ formatCurrency(registro.regProfit) }}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ registro.regMargin >= 30 ? 'bg-green-100 text-green-800' : registro.regMargin >= 20 ? 'bg-blue-100 text-blue-800' : registro.regMargin >= 10 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' }}">
                      {{ registro.regMargin.toFixed(1) }}%
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                      {{ registro.totalTransactions }}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold {{ registro.status === 'open' ? 'bg-green-100 text-green-800' : 'bg-industrial-100 app-muted' }}">
                      {{ registro.status === 'open' ? 'Aberto' : 'Fechado' }}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                    <a href="{{ route('cashRegisters.show', [registro.id]) }}" class="text-accent-600 hover:text-accent-700 font-medium">
                      <i class="fas fa-eye"></i>
                    </a>
                  </td>
                </tr>
                @end
              </tbody>
              <tfoot class="bg-industrial-50 border-t-2 border-industrial-300">
                <tr class="font-bold">
                  <td colspan="2" class="px-6 py-4 text-sm text-industrial-900">
                    <i class="fas fa-calculator mr-2"></i> TOTAIS
                  </td>
                  <td class="px-6 py-4 text-sm text-accent-600 text-right">
                    {{ formatCurrency(totals.totalSales) }}
                  </td>
                  <td class="px-6 py-4 text-sm text-green-600 text-right">
                    {{ formatCurrency(totals.totalProfit) }}
                  </td>
                  <td class="px-6 py-4 text-right">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold {{ totals.profitMargin >= 30 ? 'bg-green-100 text-green-800' : totals.profitMargin >= 20 ? 'bg-blue-100 text-blue-800' : totals.profitMargin >= 10 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' }}">
                      {{ (typeof totals.profitMargin === 'number' ? totals.profitMargin : 0).toFixed(1) }}%
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-blue-100 text-blue-800">
                      {{ totals.totalTransactions }}
                    </span>
                  </td>
                  <td colspan="2"></td>
                </tr>
              </tfoot>
            </table>
            @else
            <div class="px-6 py-12 text-center">
              <i class="fas fa-inbox text-industrial-300 text-5xl mb-4"></i>
              <p class="app-muted text-lg font-medium">Nenhum registro encontrado</p>
              <p class="text-industrial-400 text-sm mt-2">Ajuste os filtros para visualizar resultados</p>
            </div>
            @endif
          </div>
        </div>

      </div>
    </main>
  </div>

  <script>
    // Dados dos registros
    const registros = @json(registros);

    const labelDateFormatter = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: '2-digit' })
    const csvDateFormatter = new Intl.DateTimeFormat('pt-BR')
    const currencyFormatter = new Intl.NumberFormat('pt-BR', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    })

    // Preparar dados para gráficos
    const labels = registros.map(r => labelDateFormatter.format(new Date(r.registerDate)));
    const salesData = registros.map(r => parseFloat(r.totalSales || 0));
    const profitData = registros.map(r => parseFloat(r.totalProfit || 0));

    // Gráfico de Evolução (Linha)
    const ctx1 = document.getElementById('evolutionChart');
    new Chart(ctx1, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Vendas',
            data: salesData,
            borderColor: 'rgb(99, 102, 241)',
            backgroundColor: 'rgba(99, 102, 241, 0.1)',
            tension: 0.4,
            fill: true,
            borderWidth: 3,
            pointRadius: 4,
            pointHoverRadius: 6
          },
          {
            label: 'Lucro',
            data: profitData,
            borderColor: 'rgb(16, 185, 129)',
            backgroundColor: 'rgba(16, 185, 129, 0.1)',
            tension: 0.4,
            fill: true,
            borderWidth: 3,
            pointRadius: 4,
            pointHoverRadius: 6
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            position: 'top',
            labels: {
              padding: 15,
              font: {
                size: 12,
                weight: 'bold'
              },
              usePointStyle: true
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 12,
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': R$ ' + currencyFormatter.format(context.parsed.y);
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) {
                return 'R$ ' + new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 0 }).format(value);
              }
            },
            grid: {
              color: 'rgba(0, 0, 0, 0.05)'
            }
          },
          x: {
            grid: {
              display: false
            }
          }
        }
      }
    });

    // Gráfico de Métodos de Pagamento (Doughnut)
    const ctx2 = document.getElementById('paymentChart');
    new Chart(ctx2, {
      type: 'doughnut',
      data: {
        labels: ['Dinheiro 💵', 'Cartão 💳', 'PIX 📱'],
        datasets: [{
          data: [{{ totals.cashSales || 0 }}, {{ totals.cardSales || 0 }}, {{ totals.pixSales || 0 }}],
          backgroundColor: [
            'rgba(34, 197, 94, 0.8)',
            'rgba(59, 130, 246, 0.8)',
            'rgba(168, 85, 247, 0.8)'
          ],
          borderColor: [
            'rgb(34, 197, 94)',
            'rgb(59, 130, 246)',
            'rgb(168, 85, 247)'
          ],
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 15,
              font: {
                size: 12,
                weight: 'bold'
              },
              usePointStyle: true
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 12,
            callbacks: {
              label: function(context) {
                const label = context.label || '';
                const value = context.parsed || 0;
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                return label + ': R$ ' + value.toFixed(2) + ' (' + percentage + '%)';
              }
            }
          }
        }
      }
    });

    // Função de exportação CSV
    function exportToCSV() {
      const data = @json(registros);
      
      let csv = 'Data,Responsável,Vendas,Lucro,Margem %,Transações,Status\n';
      
      data.forEach(row => {
        const sales = parseFloat(row.totalSales || 0);
        const profit = parseFloat(row.totalProfit || 0);
        const margin = sales > 0 ? (profit / sales) * 100 : 0;
        const userName = row.user ? row.user.fullName : 'N/A';
        
        csv += `${csvDateFormatter.format(new Date(row.registerDate))},${userName},${sales.toFixed(2)},${profit.toFixed(2)},${margin.toFixed(2)},${row.totalTransactions},${row.status === 'open' ? 'Aberto' : 'Fechado'}\n`;
      });
      
      // Adicionar totais
      csv += `\nTOTAL,,${(typeof totals.totalSales === 'number' ? totals.totalSales : 0).toFixed(2)},${(typeof totals.totalProfit === 'number' ? totals.totalProfit : 0).toFixed(2)},${(typeof totals.profitMargin === 'number' ? totals.profitMargin : 0).toFixed(2)},${totals.totalTransactions},\n`;
      
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      
      link.setAttribute('href', url);
      link.setAttribute('download', `movimento_caixa_${new Date().toISOString().split('T')[0]}.csv`);
      link.style.visibility = 'hidden';
      
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  </script>
  @include('components/quick_actions')
</body>
</html>