<!DOCTYPE html>
<html>
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Relatório de Caixa - {{ registro.registerDate }}</title>
    <style>
        /* Estilos para impressoras térmicas de 80mm */
        @page {
            size: 80mm auto;
            margin: 0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            line-height: 1.4;
            color: #000;
            background: #fff;
            width: 80mm;
            padding: 5mm;
            margin: 0 auto;
            font-weight: bold;
        }

        .receipt {
            width: 100%;
            margin: 0 auto;
        }

        /* Header com Logo */
        .header {
            text-align: center;
            border-bottom: 2px solid #000;
            padding-bottom: 8px;
            margin-bottom: 8px;
        }

        .logo {
            max-width: 60mm;
            max-height: 25mm;
            margin: 0 auto 8px;
            display: block;
        }

        .empresa-nome {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 2px;
        }

        .empresa-info {
            font-size: 10px;
            line-height: 1.3;
        }

        /* Seção de informações */
        .info-section {
            margin-bottom: 8px;
            font-size: 11px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
        }

        .info-label {
            font-weight: bold;
        }

        /* Separadores */
        .separator {
            border-top: 2px solid #000;
            margin: 8px 0;
        }

        .separator-dashed {
            border-top: 1px dashed #000;
            margin: 6px 0;
        }

        /* Títulos de seção */
        .section-title {
            font-weight: bold;
            font-size: 12px;
            margin-bottom: 4px;
            text-align: center;
        }

        /* Dados */
        .data-row {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            margin-bottom: 3px;
        }

        .data-label {
            font-weight: bold;
        }

        .data-value {
            text-align: right;
        }

        /* Tabela de métodos de pagamento */
        .table-header {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            font-weight: bold;
            margin-bottom: 3px;
            padding-bottom: 2px;
            border-bottom: 1px dashed #000;
        }

        .table-row {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            margin-bottom: 2px;
        }

        .col-method {
            flex: 1;
        }

        .col-qty {
            flex: 0 0 25px;
            text-align: center;
        }

        .col-value {
            flex: 0 0 30px;
            text-align: right;
        }

        /* Total */
        .total-section {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 2px solid #000;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 4px;
            font-size: 11px;
        }

        .total-final {
            font-size: 14px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            margin-top: 6px;
            padding-top: 6px;
            border-top: 1px solid #000;
        }

        /* Rodapé */
        .footer {
            margin-top: 12px;
            padding-top: 8px;
            border-top: 2px solid #000;
            text-align: center;
            font-size: 10px;
        }

        .footer-message {
            margin-bottom: 6px;
            line-height: 1.4;
        }

        .footer-info {
            font-size: 9px;
            color: #666;
            margin-top: 6px;
        }

        /* Impressão */
        @media print {
            body {
                width: 80mm;
            }

            .no-print {
                display: none !important;
            }
        }

        
    </style>
</head>
<body>
    

    <div class="receipt">
        <!-- Header -->
        <div class="header">
            @if(empresa.logo)
            <img src="{{ empresa.logo }}" alt="Logo" class="logo">
            @endif
            <div class="empresa-nome">{{ empresa.razaoSocial }}</div>
            <div class="empresa-info">
                CNPJ: {{ empresa.formattedCnpj }}<br>
                IE: {{ empresa.stateRegistration }}<br>
                {{ empresa.fullAddress }}
            </div>
        </div>

        <!-- Informações do Caixa -->
        <div class="section-title">RELATÓRIO DE CAIXA</div>
        <div class="separator-dashed"></div>

        <div class="info-section">
            <div class="info-row">
                <span class="info-label">Data:</span>
                <span data-timestamp="{{ registro.registerDate.toISO() }}" data-timestamp-format="date"></span>
            </div>
            <div class="info-row">
                <span class="info-label">Operador:</span>
                <span>{{ registro.user.name }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Status:</span>
                <span>{{ registro.status === 'open' ? 'ABERTO' : 'FECHADO' }}</span>
            </div>
        </div>

        <div class="separator"></div>

        <!-- Conferência de Caixa -->
        <div class="section-title">CONFERÊNCIA DE CAIXA</div>
        <div class="separator-dashed"></div>

        <div class="data-row">
            <span class="data-label">Saldo Inicial:</span>
            <span class="data-value">R$ {{ Number(registro.openingBalance || 0).toFixed(2) }}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Vendas (Dinheiro):</span>
            <span class="data-value">R$ {{ Number(registro.cashSales || 0).toFixed(2) }}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Saldo Esperado:</span>
            <span class="data-value">R$ {{ (Number(registro.openingBalance || 0) + Number(registro.cashSales || 0)).toFixed(2) }}</span>
        </div>
        <div class="separator-dashed"></div>
        <div class="data-row">
            <span class="data-label">Saldo Informado:</span>
            <span class="data-value">R$ {{ Number(registro.closingBalance || 0).toFixed(2) }}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Diferença:</span>
            <span class="data-value">R$ {{ (Number(registro.closingBalance || 0) - (Number(registro.openingBalance || 0) + Number(registro.cashSales || 0))).toFixed(2) }}</span>
        </div>

        <div class="separator"></div>

        <!-- Resumo de Vendas -->
        <div class="section-title">RESUMO DE VENDAS</div>
        <div class="separator-dashed"></div>

        <div class="data-row">
            <span class="data-label">Total em Vendas:</span>
            <span class="data-value">R$ {{ Number(totalSales || 0).toFixed(2) }}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Qtd. Transações:</span>
            <span class="data-value">{{ transactions || 0 }}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Ticket Médio:</span>
            <span class="data-value">R$ {{ Number(averageTicket || 0).toFixed(2) }}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Lucro Total:</span>
            <span class="data-value">R$ {{ Number(profit || 0).toFixed(2) }}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Margem:</span>
            <span class="data-value">{{ Number(margin || 0).toFixed(2) }}%</span>
        </div>

        <div class="separator"></div>

        <!-- Vendas por Método de Pagamento -->
        <div class="section-title">VENDAS POR MÉTODO</div>
        <div class="separator-dashed"></div>

        <div class="table-header">
            <span class="col-method">Método</span>
            <span class="col-qty">Qtd</span>
            <span class="col-value">Valor</span>
        </div>

        @each(stat in paymentStats)
        <div class="table-row">
            <span class="col-method">{{ stat.paymentMethod === 'cash' ? 'Dinheiro' : stat.paymentMethod === 'card' ? 'Cartão' : stat.paymentMethod === 'pix' ? 'Pix' : stat.paymentMethod === 'split' ? 'Misto' : stat.paymentMethod }}</span>
            <span class="col-qty">{{ stat.trans }}</span>
            <span class="col-value">R$ {{ Number(stat.total || 0).toFixed(2) }}</span>
        </div>
        @endeach

        <div class="separator"></div>

        <!-- Total Final -->
        <div class="total-section">
            <div class="total-final">
                <span>TOTAL GERAL</span>
                <span>R$ {{ Number(totalSales || 0).toFixed(2) }}</span>
            </div>
        </div>

        <!-- Rodapé -->
        <div class="footer">
            <div class="footer-message">
                Obrigado pela preferência!
            </div>
            <div class="footer-info">
                Emitido em <span data-now="datetime"></span>
            </div>
        </div>
    </div>
    <script>
        (function () {
            const dateTimeFormatter = new Intl.DateTimeFormat('pt-BR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            })

            document.querySelectorAll('[data-now="datetime"]').forEach((el) => {
                el.textContent = dateTimeFormatter.format(new Date())
            })

            const dateFormatter = new Intl.DateTimeFormat('pt-BR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            })

            document.querySelectorAll('[data-timestamp-format]').forEach((el) => {
                const ts = el.getAttribute('data-timestamp')
                const format = el.getAttribute('data-timestamp-format')
                if (!ts) return

                const date = new Date(ts)
                if (isNaN(date.getTime())) return

                if (format === 'date') {
                    el.textContent = dateFormatter.format(date)
                }
            })
        })()
    </script>
</body>
</html>
