  @vite(['resources/css/app.css', 'resources/js/app.js'])
  <style>
    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .stat-card {
      animation: slideIn 0.5s ease-out forwards;
    }
    .stat-card:hover {
      transform: translateY(-4px);
      transition: transform 0.3s ease;
    }
  </style>
</head>
<body class="h-full font-sans text-industrial-900">
  <div class="min-h-full">
    <header class="bg-white shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-accent-500/10 text-accent-600 flex items-center justify-center">
            <i class="fas fa-cash-register"></i>
          </div>
          <h1 class="text-lg font-semibold leading-6 text-industrial-900">Histórico de Caixa</h1>
          <div class="flex items-center gap-2 ml-auto">
            <a href="{{ route('cashRegisters.movement') }}" class="inline-flex items-center gap-2 rounded-lg bg-industrial-800 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-industrial-700">
              <i class="fas fa-chart-line mr-2"></i>
              Movimento
            </a>
            <a href="{{ route('cashRegisters.current') }}" class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-500">
              <i class="fas fa-cash-register mr-2"></i>
              Caixa Atual
            </a>
            <a href="{{ route('dashboard.index') }}"
              class="inline-flex items-center gap-2 rounded-lg bg-industrial-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-industrial-400">
              <i class="fas fa-home mr-2"></i> Dashboard
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-8 px-4 sm:px-6 lg:px-8">
        
        <!-- Filtros -->
        <div class="stat-card bg-white shadow-sm rounded-xl overflow-hidden mb-8 ring-1 ring-industrial-100" style="animation-delay: 0.1s">
          <div class="px-6 py-4 border-b border-industrial-100 bg-industrial-50">
            <h2 class="text-lg font-semibold text-industrial-900 flex items-center">
              <i class="fas fa-filter text-accent-600 mr-2"></i>
              Filtros
            </h2>
          </div>
          <div class="p-6">
            <form action="{{ route('cashRegisters.index') }}" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div>
                <label for="status" class="block text-sm font-semibold app-muted mb-2">
                  <i class="fas fa-flag text-accent-600 mr-2"></i>
                  Status
                </label>
                <select 
                  name="status" 
                  id="status" 
                  class="block w-full px-4 py-2.5 app-border rounded-lg shadow-sm focus:ring-accent-500 focus:border-accent-500 transition"
                >
                  <option value="">Todos</option>
                  <option value="open" {{ filters.status === 'open' ? 'selected' : '' }}>Abertos</option>
                  <option value="closed" {{ filters.status === 'closed' ? 'selected' : '' }}>Fechados</option>
                </select>
              </div>

              <div>
                <label for="month" class="block text-sm font-semibold app-muted mb-2">
                  <i class="far fa-calendar-alt text-accent-600 mr-2"></i>
                  Mês
                </label>
                <input 
                  type="month" 
                  name="month" 
                  id="month" 
                  value="{{ filters.month }}"
                  class="block w-full px-4 py-2.5 app-border rounded-lg shadow-sm focus:ring-accent-500 focus:border-accent-500 transition"
                >
              </div>

              <div class="flex items-end space-x-2 md:col-span-2">
                <button type="submit" class="flex-1 inline-flex items-center justify-center rounded-lg bg-accent-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-accent-500 transition">
                  <i class="fas fa-search mr-2"></i>
                  Filtrar
                </button>
                <a href="{{ route('cashRegisters.index') }}" class="inline-flex items-center justify-center rounded-lg app-border bg-white px-4 py-2.5 text-sm font-semibold app-muted hover:bg-industrial-50 transition">
                  <i class="fas fa-redo mr-2"></i>
                  Limpar
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Tabela de Registros -->
        <div class="stat-card bg-white shadow-sm rounded-xl overflow-hidden ring-1 ring-industrial-100" style="animation-delay: 0.2s">
          <div class="px-6 py-4 border-b border-industrial-100 bg-industrial-50">
            <h2 class="text-lg font-semibold text-industrial-900 flex items-center justify-between">
              <span>
                <i class="fas fa-list app-muted mr-2"></i>
                Registros de Caixa
              </span>
              @if(registros.data && registros.data.length > 0)
              <span class="text-sm font-normal app-muted">
                {{ registros.data.length }} de {{ registros.meta.total }} registros
              </span>
              @endif
            </h2>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-industrial-100">
              <thead class="bg-industrial-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="far fa-calendar-alt mr-1"></i> Data
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="fas fa-user mr-1"></i> Responsável
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="fas fa-wallet mr-1"></i> Abertura
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="fas fa-lock mr-1"></i> Fechamento
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="fas fa-dollar-sign mr-1"></i> Total Vendas
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="fas fa-chart-line mr-1"></i> Lucro
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="fas fa-flag mr-1"></i> Status
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                    <i class="fas fa-cog mr-1"></i> Ação
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-industrial-100">
                @if(registros.data && registros.data.length > 0)
                @each(registro in registros.data)
                <tr class="hover:bg-industrial-50 transition">
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-industrial-900">
                    {{{ formatDateOnlyTimestamp(registro.registerDate) }}}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm app-muted">
                    <div class="flex items-center">
                      <div class="bg-accent-500/10 rounded-full p-2 mr-2">
                        <i class="fas fa-user text-accent-600 text-xs"></i>
                      </div>
                      {{ registro.user ? registro.user.fullName : 'N/A' }}
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-semibold text-industrial-900">
                    {{ formatCurrency(parseFloat(registro.openingBalance || 0)) }}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-semibold text-industrial-900">
                    {{ registro.closingBalance ? formatCurrency(parseFloat(registro.closingBalance)) : '—' }}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-bold text-accent-600">
                    {{ formatCurrency(parseFloat(registro.totalSales || 0)) }}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-bold text-green-600">
                    {{ formatCurrency(parseFloat(registro.totalProfit || 0)) }}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold {{ registro.status === 'open' ? 'bg-green-50 text-green-700' : 'bg-industrial-50 app-muted' }}">
                      <i class="fas {{ registro.status === 'open' ? 'fa-lock-open' : 'fa-lock' }} mr-1"></i>
                      {{ registro.status === 'open' ? 'ABERTO' : 'FECHADO' }}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                    <a href="{{ route('cashRegisters.show', [registro.id]) }}" class="inline-flex items-center text-accent-600 hover:text-accent-500 font-semibold transition">
                      <i class="fas fa-eye mr-1"></i>
                      Ver
                    </a>
                  </td>
                </tr>
                @end
                @else
                <tr>
                  <td colspan="8" class="px-6 py-12 text-center">
                    <i class="fas fa-inbox text-industrial-300 text-5xl mb-4"></i>
                    <p class="app-muted text-lg font-medium">Nenhum registro de caixa encontrado</p>
                    <p class="text-industrial-500 text-sm mt-2">Ajuste os filtros ou abra um novo caixa</p>
                  </td>
                </tr>
                @endif
              </tbody>
            </table>
          </div>

          <!-- Paginação -->
          @if(registros.data && registros.data.length > 0 && registros.meta.lastPage > 1)
          <div class="px-6 py-4 border-t border-industrial-100 bg-industrial-50">
            <div class="flex items-center justify-between">
              <div class="text-sm app-muted">
                Mostrando <span class="font-medium">{{ registros.meta.from }}</span> a <span class="font-medium">{{ registros.meta.to }}</span> de <span class="font-medium">{{ registros.meta.total }}</span> registros
              </div>
              <div class="flex items-center space-x-2">
                @if(registros.meta.currentPage > 1)
                <a href="{{ route('cashRegisters.index', { page: registros.meta.currentPage - 1, status: filters.status, month: filters.month }) }}" class="inline-flex items-center px-3 py-2 app-border rounded-lg text-sm font-semibold app-muted bg-white hover:bg-industrial-50 transition">
                  <i class="fas fa-chevron-left mr-1"></i>
                  Anterior
                </a>
                @endif
                
                <span class="inline-flex items-center px-4 py-2 text-sm font-semibold text-industrial-900">
                  Página {{ registros.meta.currentPage }} de {{ registros.meta.lastPage }}
                </span>

                @if(registros.meta.currentPage < registros.meta.lastPage)
                <a href="{{ route('cashRegisters.index', { page: registros.meta.currentPage + 1, status: filters.status, month: filters.month }) }}" class="inline-flex items-center px-3 py-2 app-border rounded-lg text-sm font-semibold app-muted bg-white hover:bg-industrial-50 transition">
                  Próxima
                  <i class="fas fa-chevron-right ml-1"></i>
                </a>
                @endif
              </div>
            </div>
          </div>
          @endif
        </div>

      </div>
    </main>
  </div>
  @include('components/quick_actions')
</body>
</html>
