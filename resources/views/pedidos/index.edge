                      <strong class="text-industrial-900">#{{ pedido.orderNumber }}</strong>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm app-muted">
                      @if(pedido.comanda)
                      <i class="fas fa-table text-industrial-400"></i> <span class="ml-1">{{ pedido.comanda.name || 'Comanda '
                        + pedido.comanda.number }}</span>
                      @elseif(pedido.customerName)
                      <i class="fas fa-user text-industrial-400"></i> <span class="ml-1">{{ pedido.customerName }}</span>
                      @else
                      <span class="text-industrial-500">-</span>
                      @end
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      @if(pedido.type === 'dine_in')
                      <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold bg-accent-50 text-accent-700">Local</span>
                      @elseif(pedido.type === 'takeout')
                      <span
                        class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold bg-yellow-50 text-yellow-700">Retirada</span>
                      @else
                      <span
                        class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold bg-industrial-100 app-muted">Delivery</span>
                      @end
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span
                        class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold {{ pedido.status === 'pending' ? 'bg-yellow-50 text-yellow-700' : pedido.status === 'confirmed' ? 'bg-accent-50 text-accent-700' : pedido.status === 'preparing' ? 'bg-purple-50 text-purple-700' : pedido.status === 'ready' ? 'bg-green-50 text-green-700' : pedido.status === 'served' ? 'bg-industrial-100 app-muted' : pedido.status === 'paid' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700' }}">
                        {{ pedido.status === 'pending' ? 'Pendente' : pedido.status === 'confirmed' ? 'Confirmado' :
                        pedido.status === 'preparing' ? 'Preparando' : pedido.status === 'ready' ? 'Pronto' :
                        pedido.status
                        === 'served' ? 'Servido' : pedido.status === 'paid' ? 'Pago' : 'Cancelado' }}
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm app-muted">{{ pedido.items ? pedido.items.length
                      : 0 }} itens</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right">
                      <strong class="text-industrial-900">{{ formatCurrency(pedido.total) }}</strong>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm app-muted">
                      {{{ formatDateTimestamp(pedido.createdAt) }}}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <div class="inline-flex gap-3">
                        <a href="{{ route('pedidos.show', [pedido.id]) }}" class="text-accent-600 hover:text-accent-500"
                          title="Ver detalhes">
                          <i class="fas fa-eye"></i>
                        </a>
                        @if(pedido.status !== 'paid')
                        <a href="{{ route('pedidos.edit', [pedido.id]) }}" class="app-muted hover:text-industrial-500"
                          title="Editar">
                          <i class="fas fa-edit"></i>
                        </a>
                        <button onclick="confirmDeletePedido({{ pedido.id }}, '{{ pedido.orderNumber }}')" type="button"
                          class="text-red-600 hover:text-red-500"
                          title="Deletar">
                          <i class="fas fa-trash"></i>
                        </button>
                        @end
                      </div>
                    </td>
                  </tr>
                  @end
                </tbody>
              </table>
            </div>

            @if(pedidos.data.length === 0)
            <div class="text-center py-12">
              <i class="fas fa-clipboard-list fa-3x text-industrial-200 mb-4"></i>
              <p class="app-muted mb-4">Nenhum pedido encontrado</p>
              <a href="{{ route('pedidos.create') }}"
                class="inline-flex items-center gap-2 px-4 py-2 bg-accent-600 text-white text-sm font-semibold rounded-lg hover:bg-accent-500">
                <i class="fas fa-plus"></i> Criar Primeiro Pedido
              </a>
            </div>
            @end
          </div>
        </div>

        <!-- Paginação -->
        @if(pedidos.meta.lastPage > 1)
        <nav class="flex items-center justify-center mt-6" aria-label="Navegação de páginas">
          <ul class="inline-flex gap-2">
            @each(page in Array.from({length: pedidos.meta.lastPage}, (_, i) => i + 1))
            <li>
              <a class="px-3 py-2 rounded-lg font-semibold {{ pedidos.meta.currentPage === page ? 'text-white bg-accent-600' : 'app-muted bg-white app-border hover:bg-industrial-50' }}"
                href="{{ route('pedidos.index', {}, {qs: {...filters, page}}) }}">
                {{ page }}
              </a>
            </li>
            @end
          </ul>
        </nav>
        @end
      </div>
    </main>
  </div>
  @include('components/quick_actions')
  <script>
    function confirmDeletePedido(pedidoId, orderNumber) {
      if (confirm(`Tem certeza que deseja deletar o pedido #${orderNumber}? Esta ação não pode ser desfeita.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/comandas/pedidos/${pedidoId}`;
        
        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = 'DELETE';
        
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'csrf_token';
        csrfInput.value = document.querySelector('meta[name="csrf-token"]')?.content || '';
        
        form.appendChild(methodInput);
        form.appendChild(csrfInput);
        document.body.appendChild(form);
        form.submit();
      }
    }
  </script>
</body>
</html>
@end