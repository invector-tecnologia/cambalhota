  <!-- Modal de Seleção de Itens para Impressão da Cozinha -->
  <div id="kitchenPrintModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-11/12 max-w-2xl shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-medium text-industrial-900">
            <i class="fas fa-utensils mr-2 text-orange-600"></i>
            Selecionar Itens para Impressão da Cozinha
          </h3>
          <button onclick="closeKitchenPrintModal()" class="text-industrial-400 hover:app-muted">
            <i class="fas fa-times text-xl"></i>
          </button>
        </div>
        
        <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded">
          <p class="text-sm text-blue-800">
            <i class="fas fa-info-circle mr-2"></i>
            Selecione os itens que deseja enviar para a cozinha
          </p>
        </div>

        <div id="modalItemsList" class="mb-4 max-h-96 overflow-y-auto">
          <!-- Itens serão preenchidos via JavaScript -->
        </div>

        <div class="flex items-center justify-end space-x-3 pt-4 border-t border-industrial-200">
          <button onclick="closeKitchenPrintModal()" 
            class="px-4 py-2 bg-white app-border app-muted rounded-md hover:bg-industrial-50">
            Cancelar
          </button>
          <button onclick="printSelectedItems()" 
            class="px-4 py-2 bg-orange-600 text-white rounded-md hover:bg-orange-700">
            <i class="fas fa-arrow-right mr-2"></i>
            Visualizar Selecionados
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Preview para Impressão -->
  <div id="kitchenPrintPreviewModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl w-full" style="max-width: 420px; height: 85vh; display: flex; flex-direction: column;">
      <div class="bg-white border-b border-industrial-200 px-6 py-4 flex justify-between items-center flex-shrink-0">
        <h3 class="text-lg font-semibold text-industrial-900">
          <i class="fas fa-print mr-2"></i> Preview da Impressão - Cozinha
        </h3>
        <button onclick="closeKitchenPrintPreviewModal()" class="text-industrial-400 hover:app-muted">
          <i class="fas fa-times text-xl"></i>
        </button>
      </div>
      
      <div class="flex-1 overflow-hidden">
        <iframe id="previewIframe" class="w-full h-full border-0"></iframe>
      </div>

      <div class="bg-white border-t border-industrial-200 px-6 py-4 flex items-center justify-end space-x-3 flex-shrink-0">
        <button onclick="closeKitchenPrintPreviewModal()" 
          class="px-4 py-2 bg-white app-border app-muted rounded-md hover:bg-industrial-50">
          Fechar
        </button>
        <button onclick="printPreview()" 
          class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
          <i class="fas fa-print mr-2"></i>
          Imprimir
        </button>
      </div>
    </div>
  </div>

  <script>
    // Dados dos itens do pedido
    const pedidoItems = [
      @each(item in pedido.items)
      {
        id: {{ item.id }},
        name: "{{ item.menuItem ? item.menuItem.name : item.itemName }}",
        quantity: {{ item.quantity }},
        notes: "{{ item.notes || '' }}"
      },
      @end
    ];

    // Selecionar/Desselecionar todos os itens
    document.getElementById('selectAllItems')?.addEventListener('change', function(e) {
      document.querySelectorAll('.kitchen-item-checkbox').forEach(checkbox => {
        checkbox.checked = e.target.checked;
      });
    });

    // Abrir modal de seleção
    function openKitchenPrintModal() {
      const modal = document.getElementById('kitchenPrintModal');
      const itemsList = document.getElementById('modalItemsList');
      
      // Limpar lista
      itemsList.innerHTML = '';
      
      if (pedidoItems.length === 0) {
        itemsList.innerHTML = '<p class="text-center text-industrial-500 py-4">Nenhum item disponível</p>';
        modal.classList.remove('hidden');
        return;
      }
      
      // Criar lista de itens no modal
      pedidoItems.forEach((item, index) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'flex items-start space-x-3 p-3 app-border rounded-md mb-2 hover:bg-industrial-50';
        
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.checked = true;
        checkbox.className = 'mt-1 rounded border-industrial-300 text-accent-600 focus:ring-accent-500 kitchen-item-checkbox';
        checkbox.dataset.itemId = item.id;
        checkbox.dataset.itemName = item.name;
        checkbox.dataset.itemQuantity = item.quantity;
        checkbox.dataset.itemNotes = item.notes;
        
        const infoDiv = document.createElement('div');
        infoDiv.className = 'flex-1';
        infoDiv.innerHTML = `
          <div class="font-medium text-industrial-900">${item.name}</div>
          <div class="text-sm app-muted">Quantidade: ${item.quantity}</div>
          ${item.notes ? `<div class="text-sm text-industrial-500 italic">${item.notes}</div>` : ''}
        `;
        
        itemDiv.appendChild(checkbox);
        itemDiv.appendChild(infoDiv);
        itemsList.appendChild(itemDiv);
      });
      
      modal.classList.remove('hidden');
    }

    // Fechar modal
    function closeKitchenPrintModal() {
      document.getElementById('kitchenPrintModal').classList.add('hidden');
    }

    // Imprimir itens selecionados
    function printSelectedItems() {
      const selectedItems = [];
      document.querySelectorAll('.kitchen-item-checkbox:checked').forEach(checkbox => {
        selectedItems.push(checkbox.dataset.itemId);
      });
      
      if (selectedItems.length === 0) {
        alert('Por favor, selecione pelo menos um item para imprimir.');
        return;
      }
      
      // Criar URL com itens selecionados
      const pedidoId = {{ pedido.id }};
      const itemsParam = selectedItems.join(',');
      const printUrl = `{{ route('pedidos.print.kitchen', [pedido.id]) }}?items=${itemsParam}`;
      
      // Fechar modal de seleção
      closeKitchenPrintModal();
      
      // Mostrar modal de preview e carregar conteúdo
      showKitchenPrintPreview(printUrl);
    }

    function showKitchenPrintPreview(printUrl) {
      const previewModal = document.getElementById('kitchenPrintPreviewModal');
      const previewIframe = document.getElementById('previewIframe');
      
      // Mostrar modal e carregar URL no iframe
      previewModal.classList.remove('hidden');
      previewIframe.src = printUrl;
    }

    function closeKitchenPrintPreviewModal() {
      document.getElementById('kitchenPrintPreviewModal').classList.add('hidden');
    }

    function printPreview() {
      const iframe = document.getElementById('previewIframe');
      iframe.contentWindow.print();
    }

    // Fechar modal ao clicar fora
    document.getElementById('kitchenPrintModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        closeKitchenPrintModal();
      }
    });

    // Lidar com mudança de status dos itens
    document.querySelectorAll('.item-status-select').forEach(select => {
      select.addEventListener('change', async (e) => {
        const itemId = e.target.dataset.itemId
        const pedidoId = e.target.dataset.pedidoId
        const newStatus = e.target.value

        try {
          const response = await fetch(`/pedidos/${pedidoId}/items/${itemId}/status`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || '',
            },
            body: JSON.stringify({ status: newStatus }),
          })

          if (!response.ok) {
            alert('Erro ao atualizar status do item')
            location.reload()
          } else {
            // Recarregar a página para refletir as mudanças
            location.reload()
          }
        } catch (error) {
          console.error('Erro:', error)
          alert('Erro ao atualizar status')
        }
      })
    })

    function confirmDeletePedido(pedidoId, orderNumber) {
      if (confirm(`Tem certeza que deseja deletar o pedido #${orderNumber}? Esta ação não pode ser desfeita.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/comandas/pedidos/${pedidoId}`;
        
        const methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = 'DELETE';
        
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'csrf_token';
        csrfInput.value = document.querySelector('meta[name="csrf-token"]')?.content || '';
        
        form.appendChild(methodInput);
        form.appendChild(csrfInput);
        document.body.appendChild(form);
        form.submit();
      }
    }
  </script>
</body>
</html>
@end