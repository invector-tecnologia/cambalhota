    <script>
        // Dados iniciais do pedido
        let orderItems = [];

        // Função para carregar itens existentes
        function loadExistingItems() {
            try {
                const pedidoData = {{{ JSON.stringify(pedido) }}};
                console.log('Pedido completo:', pedidoData);
                
                const items = pedidoData.items || [];
                console.log('Items do pedido:', items);

                if (Array.isArray(items) && items.length > 0) {
                    orderItems = items.map(item => {
                        console.log('Processando item:', item);
                        
                        // Tentar diferentes estruturas possíveis
                        const menuItemId = item.cardapioProdutoId || item.cardapio_produto_id || item.menuItemId;
                        const produto = item.cardapioProduto || item.cardapio_produto || item.produto;
                        const itemName = produto?.name || item.itemName || item.name || 'Item sem nome';
                        const unitPrice = parseFloat(item.unitPrice || item.unit_price || item.price || 0);
                        const quantity = parseInt(item.quantity || 1);
                        const notes = item.specialInstructions || item.special_instructions || item.notes || '';

                        return {
                            menuItemId: menuItemId,
                            itemName: itemName,
                            quantity: quantity,
                            unitPrice: unitPrice,
                            notes: notes
                        };
                    });

                    console.log('Items mapeados:', orderItems);
                } else {
                    console.log('Nenhum item encontrado no pedido');
                }
            } catch (error) {
                console.error('Erro ao carregar itens:', error);
                alert('Erro ao carregar os itens do pedido. Por favor, recarregue a página.');
            }
        }

        // Inicializar ao carregar a página
        document.addEventListener('DOMContentLoaded', () => {
            console.log('DOM carregado, inicializando...');
            loadExistingItems();
            updateOrderDisplay();
        });

        // Função para adicionar item
        function addItem(id, name, price) {
            console.log('Adicionando item:', { id, name, price });
            
            const existing = orderItems.find(item => item.menuItemId === id);
            if (existing) {
                existing.quantity++;
                console.log('Item já existe, aumentando quantidade:', existing);
            } else {
                const newItem = {
                    menuItemId: id,
                    itemName: name,
                    quantity: 1,
                    unitPrice: price,
                    notes: ''
                };
                orderItems.push(newItem);
                console.log('Novo item adicionado:', newItem);
            }
            updateOrderDisplay();
        }

        // Função para remover item
        function removeItem(id) {
            if (confirm('Tem certeza que deseja remover este item?')) {
                orderItems = orderItems.filter(item => item.menuItemId !== id);
                console.log('Item removido, items restantes:', orderItems);
                updateOrderDisplay();
            }
        }

        // Função para atualizar quantidade
        function updateQuantity(id, delta) {
            const item = orderItems.find(item => item.menuItemId === id);
            if (item) {
                item.quantity += delta;
                console.log('Quantidade atualizada:', item);
                
                if (item.quantity <= 0) {
                    removeItem(id);
                } else {
                    updateOrderDisplay();
                }
            }
        }

        // Função para escapar HTML
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, m => map[m]);
        }

        // Função para formatar moeda
        function formatCurrency(value) {
            return new Intl.NumberFormat('pt-BR', {
                style: 'currency',
                currency: 'BRL'
            }).format(value);
        }

        // Função para atualizar display dos itens
        function updateOrderDisplay() {
            const container = document.getElementById('orderItems');
            console.log('Atualizando display, total de items:', orderItems.length);

            if (orderItems.length === 0) {
                container.innerHTML = '<p class="text-industrial-500 text-center py-4">Nenhum item adicionado</p>';
            } else {
                let html = '<div class="space-y-3">';
                orderItems.forEach(item => {
                    const subtotal = item.quantity * item.unitPrice;
                    const safeName = escapeHtml(item.itemName);
                    
                    html += `
                        <div class="border-b border-industrial-200 pb-3">
                            <div class="flex justify-between items-start mb-2">
                                <strong class="text-sm">${safeName}</strong>
                                <button type="button" class="text-red-600 hover:text-red-800" onclick="removeItem(${item.menuItemId})">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <div class="flex justify-between items-center">
                                <div class="inline-flex rounded-lg ">
                                    <button type="button" class="px-2 py-1 text-xs app-border rounded-l-md bg-white hover:bg-industrial-50" onclick="updateQuantity(${item.menuItemId}, -1)">-</button>
                                    <span class="px-3 py-1 text-xs border-t border-b border-industrial-300 bg-industrial-50">${item.quantity}</span>
                                    <button type="button" class="px-2 py-1 text-xs app-border rounded-r-md bg-white hover:bg-industrial-50" onclick="updateQuantity(${item.menuItemId}, 1)">+</button>
                                </div>
                                <span class="text-sm font-semibold">${formatCurrency(subtotal)}</span>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;
            }

            updateTotals();
        }

        // Função para atualizar totais
        function updateTotals() {
            const subtotal = orderItems.reduce((sum, item) => sum + (item.quantity * item.unitPrice), 0);
            const discount = parseFloat(document.getElementById('discountInput').value) || 0;
            const serviceCharge = parseFloat(document.getElementById('serviceChargeInput').value) || 0;
            const total = subtotal - discount + serviceCharge;

            console.log('Totais:', { subtotal, discount, serviceCharge, total });

            document.getElementById('subtotal').textContent = formatCurrency(subtotal);
            document.getElementById('discountDisplay').textContent = formatCurrency(discount);
            document.getElementById('serviceChargeDisplay').textContent = formatCurrency(serviceCharge);
            document.getElementById('total').textContent = formatCurrency(total);
        }

        // Validar e enviar formulário
        document.getElementById('orderForm').addEventListener('submit', function (e) {
            if (orderItems.length === 0) {
                e.preventDefault();
                alert('Adicione pelo menos um item ao pedido');
                return;
            }

            // Atualizar campo hidden com os items
            document.getElementById('itemsInput').value = JSON.stringify(orderItems);
            console.log('Enviando formulário com items:', orderItems);
        });
    </script>
</body>
</html>
