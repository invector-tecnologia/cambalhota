    </main>

  <script>
    let orderItems = [];

    function handleOrderTypeChange() {
      const type = document.getElementById('orderType').value;
      const comandaField = document.getElementById('comandaField');
      const deliveryField = document.getElementById('deliveryAddressField');
      const customerNameField = document.getElementById('customerNameField');
      const customerPhoneField = document.getElementById('customerPhoneField');

      if (type === 'dine_in') {
        comandaField.style.display = 'block';
        deliveryField.style.display = 'none';
        customerNameField.style.display = 'none';
        customerPhoneField.style.display = 'none';
      } else if (type === 'delivery') {
        comandaField.style.display = 'none';
        deliveryField.style.display = 'block';
        customerNameField.style.display = 'block';
        customerPhoneField.style.display = 'block';
      } else {
        comandaField.style.display = 'none';
        deliveryField.style.display = 'none';
        customerNameField.style.display = 'block';
        customerPhoneField.style.display = 'block';
      }
    }

    function addItem(id, name, price) {
      const existing = orderItems.find(item => item.cardapioProductId === id);
      if (existing) {
        existing.quantity++;
      } else {
        orderItems.push({
          cardapioProductId: id,
          quantity: 1,
          specialInstructions: ''
        });
      }
      updateOrderDisplay();
    }

    function removeItem(id) {
      orderItems = orderItems.filter(item => item.cardapioProductId !== id);
      updateOrderDisplay();
    }

    function updateQuantity(id, delta) {
      const item = orderItems.find(item => item.cardapioProductId === id);
      if (item) {
        item.quantity += delta;
        if (item.quantity <= 0) {
          removeItem(id);
        } else {
          updateOrderDisplay();
        }
      }
    }

    function updateOrderDisplay() {
      const container = document.getElementById('orderItems');
      const submitBtn = document.getElementById('submitBtn');

      if (orderItems.length === 0) {
        container.innerHTML = '<p class="text-industrial-500 text-center py-4">Nenhum item adicionado</p>';
        submitBtn.disabled = true;
      } else {
        let html = '<div class="space-y-3">';
        orderItems.forEach(item => {
          // Buscar informações do produto do DOM
          const productCard = document.querySelector(`[data-product-id="${item.cardapioProductId}"]`);
          const productName = productCard ? productCard.getAttribute('data-product-name') : 'Item';
          const productPrice = productCard ? parseFloat(productCard.getAttribute('data-product-price')) : 0;
          const subtotal = item.quantity * productPrice;
          
          html += `
          <div class="border-b border-industrial-200 pb-3">
            <div class="flex justify-between items-start mb-2">
              <strong class="text-sm">${productName}</strong>
              <button type="button" class="text-red-600 hover:text-red-800" onclick="removeItem(${item.cardapioProductId})">
                <i class="fas fa-times"></i>
              </button>
            </div>
            <div class="flex justify-between items-center">
                            <div class="inline-flex rounded-lg ">
                                <button type="button" class="px-2 py-1 text-xs app-border rounded-l-md bg-white hover:bg-industrial-50" onclick="updateQuantity(${item.cardapioProductId}, -1)">-</button>
                                <span class="px-3 py-1 text-xs border-t border-b border-industrial-200 bg-industrial-50">${item.quantity}</span>
                                <button type="button" class="px-2 py-1 text-xs app-border rounded-r-md bg-white hover:bg-industrial-50" onclick="updateQuantity(${item.cardapioProductId}, 1)">+</button>
              </div>
              <span class="text-sm font-semibold">${window.formatCurrencyBR(subtotal)}</span>
            </div>
          </div>
        `;
        });
        html += '</div>';
        container.innerHTML = html;
        submitBtn.disabled = false;
      }

      updateTotals();
    }

    function updateTotals() {
      let subtotal = 0;
      orderItems.forEach(item => {
        const productCard = document.querySelector(`[data-product-id="${item.cardapioProductId}"]`);
        const productPrice = productCard ? parseFloat(productCard.getAttribute('data-product-price')) : 0;
        subtotal += item.quantity * productPrice;
      });
      
      const discount = parseFloat(document.getElementById('discountInput').value) || 0;
      const serviceCharge = parseFloat(document.getElementById('serviceChargeInput').value) || 0;
      const total = subtotal - discount + serviceCharge;

    document.getElementById('subtotal').textContent = window.formatCurrencyBR(subtotal);
    document.getElementById('discountDisplay').textContent = window.formatCurrencyBR(discount);
    document.getElementById('serviceChargeDisplay').textContent = window.formatCurrencyBR(serviceCharge);
    document.getElementById('total').textContent = window.formatCurrencyBR(total);
    }

    function updateTotalsFromForm() {
      // Função chamada quando os campos do formulário perdem o foco
      updateTotals();
    }

    function submitOrder() {
      if (orderItems.length === 0) {
        alert('Adicione pelo menos um item ao pedido');
        return;
      }

      // Set items value
      document.getElementById('itemsInput').value = JSON.stringify(orderItems);
      
      // Debug: log form data
      const formData = new FormData(document.getElementById('pedidoForm'));
      console.log('Form data being submitted:');
      for (let [key, value] of formData.entries()) {
        console.log(key, ':', value);
      }
      
      document.getElementById('pedidoForm').submit();
    }

    // Initialize
    handleOrderTypeChange();
    updateTotals();
  </script>
</body>
</html>