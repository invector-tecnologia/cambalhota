                        <span class="inline-flex items-center rounded-full bg-accent-100 px-2 py-1 text-xs font-medium text-accent-700">
                          <i class="fas fa-motorcycle mr-1"></i> Delivery
                        </span>
                        @end
                      </div>
                      <p class="text-xs text-industrial-500 mt-1">
                        <i class="fas fa-ban mr-1"></i>
                        Cancelado às {{{ item.updatedAt ? formatTimestamp(item.updatedAt) : '<span>--:--</span>' }}}
                      </p>
                    </div>
                    <span class="inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-800">
                      Cancelado
                    </span>
                  </div>
                  
                  <div class="border-t border-industrial-100 pt-3 mb-3">
                    <div class="flex items-start">
                      <div class="flex-shrink-0 bg-red-100 rounded-full w-8 h-8 flex items-center justify-center text-red-700 font-bold">
                        {{ item.quantity }}x
                      </div>
                      <div class="ml-3 flex-1">
                        <p class="font-semibold text-industrial-900">{{ item.cardapioProduto ? item.cardapioProduto.name : item.itemName }}</p>
                        @if(item.notes)
                        <p class="text-sm app-muted mt-1 bg-red-50 border-l-4 border-red-400 p-2 rounded">
                          <i class="fas fa-sticky-note mr-1"></i> {{ item.notes }}
                        </p>
                        @end
                      </div>
                    </div>
                  </div>

                  @if(item.pedido.customerName)
                  <div class="text-xs app-muted mb-3">
                    <i class="fas fa-user mr-1"></i> {{ item.pedido.customerName }}
                  </div>
                  @end

                  <a href="{{ route('pedidos.show', [item.pedido.id]) }}"
                    class="w-full inline-flex justify-center items-center px-4 py-2 bg-industrial-800 text-white text-sm font-medium rounded-md hover:bg-industrial-700">
                    <i class="fas fa-eye mr-2"></i> Ver Pedido
                  </a>
                </div>
                @end
                @end
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
    
  </div>
  
  <script>
    // Função para trocar abas
    function switchTab(tabName) {
      // Esconder todos os conteúdos de abas
      document.querySelectorAll('.tab-content').forEach(el => {
        el.classList.add('hidden');
      });
      
      // Remover todas as abas ativas
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('bg-purple-50', 'text-purple-600', 'border-b-purple-500', 'border-b-2');
        el.classList.add('border-transparent', 'app-muted');
      });
      
      // Mostrar a aba selecionada
      if (tabName === 'served') {
        document.getElementById('tabServedContent').classList.remove('hidden');
        document.getElementById('tabServedBtn').classList.remove('border-transparent', 'app-muted');
        document.getElementById('tabServedBtn').classList.add('bg-purple-50', 'text-purple-600', 'border-b-2', 'border-b-purple-500');
      } else if (tabName === 'cancelled') {
        document.getElementById('tabCancelledContent').classList.remove('hidden');
        document.getElementById('tabCancelledBtn').classList.remove('border-transparent', 'app-muted');
        document.getElementById('tabCancelledBtn').classList.add('bg-red-50', 'text-red-600', 'border-b-2', 'border-b-red-500');
      }
    }

    // Atualizar relógio
    const clockFormatter = new Intl.DateTimeFormat('pt-BR', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit'
    })

    function updateClock() {
      const now = new Date()
      document.getElementById('currentTime').textContent = clockFormatter.format(now)
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Atualizar contadores
    function updateCounters() {
      const pending = document.querySelectorAll('#pendingOrders > div:not(.text-center)').length;
      const preparing = document.querySelectorAll('#preparingOrders > div:not(.text-center)').length;
      const ready = document.querySelectorAll('#readyOrders > div:not(.text-center)').length;
      const served = document.querySelectorAll('#tabServedContent > div:not(.text-center)').length;
      const cancelled = document.querySelectorAll('#tabCancelledContent > div:not(.text-center)').length;
      
      document.getElementById('pendingCount').textContent = pending;
      document.getElementById('pendingBadge').textContent = pending;
      document.getElementById('preparingCount').textContent = preparing;
      document.getElementById('preparingBadge').textContent = preparing;
      document.getElementById('readyCount').textContent = ready;
      document.getElementById('readyBadge').textContent = ready;
      document.getElementById('servedCount').textContent = served;
      document.getElementById('servedBadge').textContent = served;
      document.getElementById('cancelledCount').textContent = cancelled;
      document.getElementById('cancelledBadge').textContent = cancelled;
    }
    
    updateCounters();
    setInterval(updateCounters, 2000);
  </script>
</body>
</html>
