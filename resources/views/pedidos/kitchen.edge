<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cozinha - Tavolo</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }
    
    @keyframes pulse-slow {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }
    
    .pulse-slow {
      animation: pulse-slow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    
    .kitchen-container {
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }
    
    .kitchen-header {
      flex-shrink: 0;
    }
    
    .kitchen-stats {
      flex-shrink: 0;
    }
    
    .kitchen-board {
      flex: 1;
      min-height: 0;
      padding: 1rem;
      overflow: hidden;
    }
    
    /* Desktop - 4 colunas lado a lado */
    @media (min-width: 1024px) {
      .columns-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        height: 100%;
      }
      
      .column {
        display: flex;
        flex-direction: column;
        min-width: 0;
        height: 100%;
        overflow: hidden;
      }
    }
    
    /* Mobile - scroll horizontal */
    @media (max-width: 1023px) {
      .columns-grid {
        display: flex;
        gap: 0.75rem;
        height: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
      }
      
      .column {
        flex: 0 0 85vw;
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
      }
    }
    
    .column-header {
      flex-shrink: 0;
    }
    
    .column-body {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      min-height: 0;
      padding: 1rem;
    }
    
    .column-body::-webkit-scrollbar {
      width: 8px;
    }
    
    .column-body::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 4px;
    }
    
    .column-body::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    
    .column-body::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    
    /* Garantir que os cards dentro das colunas não quebrem o layout */
    .column-body > * {
      flex-shrink: 0;
    }
  </style>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="bg-industrial-50">
  <div class="kitchen-container">
    
    <!-- Header -->
    <header class="kitchen-header bg-white  border-b border-industrial-100">
      <div class="px-4 py-3">
        <div class="flex justify-between items-center">
          <div class="flex items-center space-x-2">
            <i class="fas fa-utensils text-xl text-accent-600"></i>
            <h1 class="text-lg font-bold text-industrial-900">Cozinha</h1>
            <span id="currentTime" class="text-sm app-muted ml-2"></span>
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="location.reload()"
              class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold app-text ring-1 ring-inset ring-industrial-200 hover:bg-industrial-50">
              <i class="fas fa-sync mr-2"></i> Atualizar
            </button>
            <a href="{{ route('pedidos.index') }}"
              class="inline-flex items-center rounded-md bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
              <i class="fas fa-list mr-2"></i> Todos
            </a>
          </div>
        </div>
      </div>
    </header>
    
    <!-- Estatísticas -->
