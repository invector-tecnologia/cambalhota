<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ titulo }} - Guias Tavolo</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  </head>
<body class="bg-gradient-to-br from-slate-50 via-white to-slate-50">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center justify-between gap-4">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <h1 class="text-2xl font-bold text-industrial-900">Tavolo</h1>
          <div class="mt-1 h-0.5 w-8 bg-accent-500"></div>
        </div>
        
        <!-- Breadcrumb - Hidden on Mobile -->
        <nav class="hidden md:flex items-center gap-2 text-sm flex-1 ml-4">
          <a href="/guias" class="text-slate-600 hover:text-slate-900 transition">Guias</a>
          <span class="text-slate-400">/</span>
          <span class="text-slate-900 font-medium truncate">{{ titulo }}</span>
        </nav>
        
        <!-- Actions -->
        <div class="flex items-center gap-2">
          <a href="/guias" class="text-slate-600 hover:text-slate-900 px-3 py-2 rounded-lg transition hover:bg-slate-100">
            <i class="fas fa-arrow-left mr-2"></i><span class="hidden sm:inline">Voltar</span>
          </a>
          <a href="/dashboard" class="px-4 py-2 bg-accent-500 text-white rounded-lg hover:bg-accent-600 transition font-medium">
            <i class="fas fa-home mr-2"></i><span class="hidden sm:inline">Dashboard</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Sidebar com Índice -->
      <aside class="lg:col-span-1">
        <div class="sticky top-32 space-y-4">
          <!-- Table of Contents -->
          <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="text-sm font-bold text-slate-900 mb-4 uppercase tracking-wide flex items-center gap-2">
              <i class="fas fa-list text-accent-500"></i> Índice
            </h3>
            <nav id="table-of-contents" class="space-y-2 text-sm max-h-96 overflow-y-auto">
              <p class="text-slate-500 italic text-xs">Carregando...</p>
            </nav>
          </div>
          
          <!-- Tips Box -->
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl shadow-sm border border-blue-200 p-6">
            <div class="flex gap-3">
              <div class="text-2xl flex-shrink-0">💡</div>
              <div>
                <h4 class="font-semibold text-slate-900 mb-2 text-sm">Dica</h4>
                <p class="text-xs text-slate-700 leading-relaxed">
                  Use o índice para navegar rapidamente. Em mobile, role para ver as seções.
                </p>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <article class="lg:col-span-3">
        <!-- Guide Header -->
        <div class="mb-8">
          <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-3">{{ titulo }}</h1>
          <div class="h-1 w-24 bg-gradient-to-r from-accent-500 to-transparent rounded-full"></div>
          <p class="text-slate-600 mt-4 text-lg">Guia completo sobre este tópico do sistema Tavolo</p>
        </div>

        <!-- Content Wrapper -->
        <div class="bg-white rounded-xl shadow-lg border border-slate-100 p-8 md:p-10 prose-guide">
          {{{ conteudo }}}
        </div>

        <!-- Navigation Footer -->
        <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row gap-4 justify-between items-center">
          <a href="/guias" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-slate-100 text-slate-900 hover:bg-slate-200 transition font-medium">
            <i class="fas fa-arrow-left"></i> Voltar aos Guias
          </a>
          <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-accent-50 text-accent-600 hover:bg-accent-100 transition font-medium">
            <i class="fas fa-arrow-up"></i> Ir para o topo
          </button>
        </div>
      </article>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="text-center text-slate-600 text-sm">
        <p class="font-medium">Tavolo - Sistema ERP para Restaurantes</p>
        <p class="mt-2">Precisa de ajuda? Consulte a <a href="/guias/faq" class="text-accent-600 hover:underline font-medium">seção FAQ</a></p>
      </div>
    </div>
  </footer>

  <style>
    /* Enhanced Typography for Guide Content */
    .prose-guide {
      color: #334155;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }
    
    .prose-guide h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #0f172a;
      margin-top: 2rem;
      margin-bottom: 1.5rem;
      scroll-margin-top: 120px;
      line-height: 1.2;
    }
    
    .prose-guide h2 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #0f172a;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      scroll-margin-top: 120px;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid #e2e8f0;
      line-height: 1.3;
    }
    
    .prose-guide h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #1e293b;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      scroll-margin-top: 120px;
    }
    
    .prose-guide p {
      font-size: 1rem;
      line-height: 1.75;
      margin-bottom: 1.5rem;
      text-align: justify;
    }
    
    .prose-guide ul, .prose-guide ol {
      margin-bottom: 1.5rem;
      margin-left: 2rem;
    }
    
    .prose-guide li {
      margin-bottom: 0.75rem;
      line-height: 1.6;
      color: #475569;
    }
    
    .prose-guide ul li:before {
      content: "▸";
      color: #2563eb;
      font-weight: bold;
      margin-right: 0.75rem;
    }
    
    .prose-guide a {
      color: #2563eb;
      text-decoration: underline;
      transition: color 0.2s;
      font-weight: 500;
    }
    
    .prose-guide a:hover {
      color: #1d4ed8;
    }
    
    .prose-guide code {
      background-color: #1e293b;
      color: #fbbf24;
      padding: 0.25rem 0.5rem;
      border-radius: 0.375rem;
      font-size: 0.875em;
      font-family: 'Courier New', monospace;
      display: inline-block;
    }
    
    .prose-guide pre {
      background-color: #1e293b;
      color: #e2e8f0;
      padding: 1.5rem;
      border-radius: 0.75rem;
      overflow-x: auto;
      margin-bottom: 1.5rem;
      border-left: 4px solid #2563eb;
      font-size: 0.875rem;
      line-height: 1.5;
    }
    
    .prose-guide pre code {
      background-color: transparent;
      color: #e2e8f0;
      padding: 0;
      border-radius: 0;
      font-size: 0.875em;
    }
    
    .prose-guide blockquote {
      border-left: 4px solid #2563eb;
      background-color: #eff6ff;
      padding: 1.5rem;
      margin: 1.5rem 0;
      border-radius: 0.5rem;
      font-style: italic;
    }
    
    .prose-guide blockquote p {
      margin: 0;
      color: #1e40af;
      font-weight: 500;
    }
    
    .prose-guide table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      overflow: hidden;
    }
    
    .prose-guide th {
      background-color: #1e293b;
      color: #ffffff;
      padding: 1rem;
      text-align: left;
      font-weight: 600;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    
    .prose-guide td {
      padding: 1rem;
      border-bottom: 1px solid #e2e8f0;
      color: #475569;
    }
    
    .prose-guide tr:hover td {
      background-color: #f8fafc;
    }
    
    .prose-guide strong {
      font-weight: 700;
      color: #0f172a;
    }
    
    .prose-guide em {
      font-style: italic;
      color: #475569;
    }
    
    .prose-guide hr {
      margin: 2rem 0;
      border: none;
      border-top: 2px solid #e2e8f0;
    }
    
    /* Custom styling for info boxes */
    .prose-guide .info-box {
      background-color: #dbeafe;
      border-left: 4px solid #2563eb;
      padding: 1rem;
      margin: 1.5rem 0;
      border-radius: 0.5rem;
    }
    
    .prose-guide .warning-box {
      background-color: #fed7aa;
      border-left: 4px solid #ea580c;
      padding: 1rem;
      margin: 1.5rem 0;
      border-radius: 0.5rem;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const contentArea = document.querySelector('.prose-guide');
      const tocContainer = document.getElementById('table-of-contents');
      
      if (!contentArea || !tocContainer) return;
      
      const headings = contentArea.querySelectorAll('h2, h3');
      
      if (headings.length === 0) {
        tocContainer.innerHTML = '<p class="text-slate-500 italic text-xs">Sem seções nesta guia</p>';
        return;
      }
      
      let html = '';
      
      headings.forEach((heading, index) => {
        if (!heading.id) {
          heading.id = `guide-section-${index}`;
        }
        
        const isH2 = heading.tagName === 'H2';
        const paddingClass = isH2 ? 'pl-0' : 'pl-4';
        const text = heading.textContent.trim();
        const id = heading.id;
        
        html += `
          <a href="#${id}" 
            class="${paddingClass} block py-2.5 px-2 rounded transition text-slate-700 hover:text-accent-600 hover:bg-slate-100 ${isH2 ? 'font-semibold' : 'text-sm'}"
            onclick="document.getElementById('${id}').scrollIntoView({behavior: 'smooth'}); return false;">
            ${text}
          </a>
        `;
      });
      
      tocContainer.innerHTML = html;
    });
  </script>
</body>
</html>
