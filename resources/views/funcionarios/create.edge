<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta charset="UTF-8">
  <title>Novo Funcionário - Tavolo</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  @vite(['resources/css/app.css'])
</head>
<body class="min-h-screen bg-industrial-50 font-sans text-industrial-900">
  <div class="min-h-screen">
    <header class="bg-white ">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div class="flex items-center space-x-3">
            <div class="h-10 w-10 rounded-full bg-accent-500/10 text-accent-600 flex items-center justify-center">
              <i class="fas fa-user-plus"></i>
            </div>
            <div>
              <h1 class="text-lg font-semibold">Novo Funcionário</h1>
              <p class="text-sm text-industrial-500">Cadastro de colaboradores e permissões</p>
            </div>
          </div>
          <a href="{{ route('funcionarios.index') }}"
            class="inline-flex items-center rounded-md bg-industrial-600 px-3 py-2 text-sm font-semibold text-white ml-auto hover:bg-industrial-500">
            <i class="fas fa-list mr-2"></i> Lista de Funcionários
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="overflow-hidden rounded-xl bg-white  ring-1 ring-industrial-100">
        <div class="border-b border-industrial-100 bg-gradient-to-r from-white via-white to-industrial-50 px-6 py-5">
          <h2 class="text-lg font-semibold text-industrial-900">Dados do funcionário</h2>
          <p class="text-sm text-industrial-500">Preencha nome, contato e defina as funções de acesso.</p>
        </div>

        <form action="{{ route('funcionarios.store') }}" method="POST" class="px-6 py-6 space-y-6">
          {{ csrfField() }}
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div>
              <label class="block text-sm font-medium app-muted mb-2">Nome *</label>
              <input type="text" name="name" required class="mt-1 block w-full rounded-md app-border px-3 py-2 text-sm  focus:border-accent-500 focus:ring-accent-500" placeholder="Nome completo">
            </div>
            <div>
              <label class="block text-sm font-medium app-muted mb-2">CPF</label>
              <input type="text" name="cpf" class="mt-1 block w-full rounded-md app-border px-3 py-2 text-sm  focus:border-accent-500 focus:ring-accent-500" placeholder="000.000.000-00">
            </div>
            <div>
              <label class="block text-sm font-medium app-muted mb-2">Email</label>
              <input type="email" name="email" class="mt-1 block w-full rounded-md app-border px-3 py-2 text-sm  focus:border-accent-500 focus:ring-accent-500" placeholder="email@exemplo.com">
            </div>
            <div>
              <label class="block text-sm font-medium app-muted mb-2">Telefone</label>
              <input type="text" name="phone" class="mt-1 block w-full rounded-md app-border px-3 py-2 text-sm  focus:border-accent-500 focus:ring-accent-500" placeholder="(00) 00000-0000">
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold app-muted mb-3">Funções *</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              @each(funcao in funcoes)
                <label class="flex items-center gap-2 rounded-md app-border px-3 py-2 text-sm app-muted hover:bg-industrial-50">
                  <input type="checkbox" name="funcoes[]" value="{{ funcao.id }}" class="h-4 w-4 rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                  {{ funcao.name }}
                </label>
              @end
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-3 border-t border-industrial-100 pt-4">
            <a href="{{ route('funcionarios.index') }}" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold app-muted  ring-1 ring-inset ring-industrial-200 hover:bg-industrial-100">
              Cancelar
            </a>
            <button type="submit" class="inline-flex items-center rounded-md bg-accent-600 px-4 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
              <i class="fas fa-save mr-2"></i> Salvar
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>

  @include('components/quick_actions')
</body>
</html>
