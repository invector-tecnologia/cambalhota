          </div>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-3xl py-6 sm:px-6 lg:px-8">
        <!-- Flash Messages -->
        @if(flashMessages.has('error'))
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">{{ flashMessages.get('error') }}</p>
            </div>
          </div>
        </div>
        @end

        @if(flashMessages.has('errors'))
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">Erros de validação:</p>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                @each(error in Object.values(flashMessages.get('errors')).flat())
                <li>{{ error }}</li>
                @end
              </ul>
            </div>
          </div>
        </div>
        @end

  <div class="bg-white rounded-lg shadow p-6">
    <form action="{{ route('funcionarios.update', [funcionario.id]) }}" method="POST" class="space-y-6">
      {{ csrfField() }}
      <input type="hidden" name="_method" value="PUT">

      <!-- Informações Pessoais -->
      <div>
        <h3 class="text-lg font-medium text-industrial-900 mb-4 pb-2 border-b">Informações Pessoais</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="md:col-span-1">
            <label for="name" class="block text-sm font-medium app-muted mb-2">
              Nome *
            </label>
            <input 
              type="text"
              id="name" 
              name="name" 
              value="{{ old('name', funcionario.name) }}" 
              required 
              maxlength="255"
              placeholder="Nome completo"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">Nome completo do funcionário</p>
          </div>

          <div>
            <label for="cpf" class="block text-sm font-medium app-muted mb-2">
              CPF
            </label>
            <input 
              type="text"
              id="cpf" 
              name="cpf" 
              value="{{ old('cpf', funcionario.cpf) }}" 
              maxlength="14"
              placeholder="000.000.000-00"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">CPF (opcional)</p>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium app-muted mb-2">
              Email
            </label>
            <input 
              type="email"
              id="email" 
              name="email" 
              value="{{ old('email', funcionario.email) }}" 
              maxlength="255"
              placeholder="email@example.com"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">Email (opcional)</p>
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium app-muted mb-2">
              Telefone
            </label>
            <input 
              type="text"
              id="phone" 
              name="phone" 
              value="{{ old('phone', funcionario.phone) }}" 
              maxlength="20"
              placeholder="(XX) XXXXX-XXXX"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">Telefone (opcional)</p>
          </div>
        </div>
      </div>

      <!-- Funções -->
      <div>
        <h3 class="text-lg font-medium text-industrial-900 mb-4 pb-2 border-b">Funções *</h3>
        <div class="space-y-3">
          @if(funcoes && funcoes.length > 0)
            @each(funcao in funcoes)
              <label class="flex items-center">
                <input 
                  type="checkbox" 
                  name="funcoes[]" 
                  value="{{ funcao.id }}" 
                  {{ funcionario.funcoesIds && funcionario.funcoesIds.includes(funcao.id) ? 'checked' : '' }}
                  class="h-4 w-4 text-accent-600 focus:ring-accent-500 border-industrial-300 rounded"
                >
                <span class="ml-3 text-sm app-muted">{{ funcao.name }}</span>
              </label>
            @end
          @else
            <p class="text-sm text-industrial-500">Nenhuma função disponível</p>
          @end
        </div>
        <p class="mt-2 text-sm text-industrial-500">
          Selecione as funções do funcionário
        </p>
      </div>

      <!-- Botões -->
      <div class="flex items-center justify-end gap-3 pt-6 border-t">
        <a 
          href="{{ route('funcionarios.index') }}" 
          class="px-4 py-2 app-border rounded-md app-muted hover:bg-industrial-50"
        >
          Cancelar
        </a>
        <button 
          type="submit" 
          class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
        >
          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
      </div>
    </main>
  </div>
