<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teste - Tavolo</title>
  @vite(['resources/css/app.css'])
</head>
<body class="h-full font-sans text-industrial-900">
    <div class="max-w-6xl mx-auto p-8">
        <div class="bg-white rounded-lg ring-1 ring-industrial-100 p-8 mb-8">
            <h1 class="text-3xl font-bold text-industrial-900 mb-6">🧪 Página de Teste - Tavolo</h1>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Usuários -->
                <div class="bg-blue-50 rounded-lg p-6">
                    <h2 class="text-xl font-semibold text-blue-900 mb-4">👥 Usuários Cadastrados</h2>
                    @if(hasUsers)
                        @each(user in users)
                        <div class="bg-white rounded-lg p-4 mb-4 border border-blue-200">
                            <h3 class="font-semibold text-industrial-900">{{ user.fullName }}</h3>
                            <p class="app-muted">📧 {{ user.email }}</p>
                            <p class="app-muted">🏭 {{ user.empresa.razaoSocial }}</p>
                            <p class="app-muted">👤 {{ user.role.name }}</p>
                            <p class="text-sm text-industrial-500">Status: {{ user.status }}</p>
                            
                            <div class="mt-4 space-x-2">
                                <a href="/test/auto-login/{{ user.email }}" 
                                   class="inline-block bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600 transition-colors">
                                    🚀 Login Automático
                                </a>
                                <a href="/dashboard" 
                                   class="inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition-colors">
                                    📊 Ir para Dashboard
                                </a>
                            </div>
                        </div>
                        @end
                    @else
                        <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded">
                            <p>❌ Nenhum usuário encontrado.</p>
                            <a href="/registro" class="text-blue-600 underline">Fazer registro inicial</a>
                        </div>
                    @end
                </div>

                <!-- Empresas -->
                <div class="bg-green-50 rounded-lg p-6">
                    <h2 class="text-xl font-semibold text-green-900 mb-4">🏢 Empresas Cadastradas</h2>
                    @each(company in companies)
                    <div class="bg-white rounded-lg p-4 mb-4 border border-green-200">
                        <h3 class="font-semibold text-industrial-900">{{ empresa.razaoSocial }}</h3>
                        <p class="app-muted">📄 CNPJ: {{ empresa.cnpj }}</p>
                        <p class="app-muted">📍 {{ empresa.city }}/{{ empresa.state }}</p>
                        <p class="text-sm text-industrial-500">
                            Status: {{ empresa.active ? '✅ Ativa' : '❌ Inativa' }}
                        </p>
                    </div>
                    @end
                </div>
            </div>

            <!-- Ações de Teste -->
            <div class="bg-industrial-50 rounded-lg p-6 mt-8">
                <h2 class="text-xl font-semibold text-industrial-900 mb-4">🛠️ Ações de Teste</h2>
                <div class="space-x-4">
                    <a href="/login" 
                       class="inline-block bg-accent-500 text-white px-6 py-3 rounded-lg hover:bg-accent-600 transition-colors">
                        🔐 Página de Login
                    </a>
                    <a href="/registro" 
                       class="inline-block bg-purple-500 text-white px-6 py-3 rounded-lg hover:bg-purple-600 transition-colors">
                        📝 Página de Registro
                    </a>
                    <a href="/dashboard" 
                       class="inline-block bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition-colors">
                        📊 Dashboard
                    </a>
                    <a href="/test/clear-session" 
                       class="inline-block bg-red-500 text-white px-6 py-3 rounded-lg hover:bg-red-600 transition-colors">
                        🗑️ Limpar Sessão
                    </a>
                </div>
            </div>

            <!-- Informações do Sistema -->
            <div class="bg-industrial-50 rounded-lg p-6 mt-8">
                <h2 class="text-xl font-semibold text-industrial-900 mb-4">💻 Informações do Sistema</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                        <strong>Total de usuários:</strong> {{ users.length }}
                    </div>
                    <div>
                        <strong>Total de empresas:</strong> {{ companies.length }}
                    </div>
                    <div>
                        <strong>Ambiente:</strong> {{ process.env.NODE_ENV || 'development' }}
                    </div>
                    <div>
                        <strong>Versão:</strong> AdonisJS v6
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>