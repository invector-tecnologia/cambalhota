</head>
<body class="min-h-screen bg-industrial-50 font-sans text-industrial-900">
  <div class="min-h-screen">
    <header class="bg-white shadow-sm">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div class="flex items-center space-x-3 ml-auto">
            <div class="h-10 w-10 rounded-full bg-accent-500/10 text-accent-600 flex items-center justify-center">
              <i class="fas fa-chair"></i>
            </div>
            <div>
              <h1 class="text-lg font-semibold">Nova Mesa</h1>
              <p class="text-sm text-industrial-500">Cadastre localização, número e status</p>
            </div>
          </div>
          <a href="{{ route('mesas.index') }}"
            class="inline-flex items-center rounded-md bg-industrial-600 px-3 py-2 text-sm font-semibold text-white ml-auto hover:bg-industrial-500"><i
              class="fas fa-list mr-2"></i> Lista de Mesas</a>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-5xl py-8 sm:px-6 lg:px-8 px-4">
        <!-- Flash Messages -->
        @if(flashMessages.has('error'))
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">{{ flashMessages.get('error') }}</p>
            </div>
          </div>
        </div>
        @end

        @if(flashMessages.has('errors'))
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">Erros de validação:</p>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                @each(error in Object.values(flashMessages.get('errors')).flat())
                <li>{{ error }}</li>
                @end
              </ul>
            </div>
          </div>
        </div>
        @end

        <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-industrial-100">
          <form action="{{ route('mesas.store') }}" method="POST" class="space-y-6 px-6 py-6">
            {{ csrfField() }}

            <!-- Informações Básicas -->
            <div>
              <h3 class="text-lg font-semibold text-industrial-900 mb-4 pb-2 border-b border-industrial-100">Informações Básicas</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="number" class="block text-sm font-medium app-muted mb-2">
                    Número *
                  </label>
                  <input type="number" id="number" name="number" value="{{ old('number') || '' }}" required min="1" step="1"
                    placeholder="Ex: 1, 101"
                    class="w-full px-3 py-2 rounded-md app-border shadow-sm focus:ring-accent-500 focus:border-accent-500"
                    onblur="validateMesaNumber(this)">
                  <p class="mt-1 text-sm text-industrial-500">Apenas números inteiros. Identificação única da mesa</p>
                  <span id="number-error" class="text-xs text-red-600 hidden"></span>
                  <script>
                    function validateMesaNumber(input) {
                      const errorSpan = document.getElementById('number-error');
                      if (!input.value.match(/^\d+$/)) {
                        errorSpan.textContent = 'Digite apenas números inteiros para o número da mesa.';
                        errorSpan.classList.remove('hidden');
                        input.classList.add('border-red-500');
                        input.value = '';
                        input.focus();
                      } else {
                        errorSpan.textContent = '';
                        errorSpan.classList.add('hidden');
                        input.classList.remove('border-red-500');
                      }
                    }
                  </script>
                </div>

                <div>
                  <label for="name" class="block text-sm font-medium app-muted mb-2">
                    Nome
                  </label>
                  <input type="text" id="name" name="name" value="{{ old('name') || '' }}" maxlength="100"
                    placeholder="Ex: Mesa VIP, Mesa Externa"
                    class="w-full px-3 py-2 rounded-md app-border shadow-sm focus:ring-accent-500 focus:border-accent-500">
                  <p class="mt-1 text-sm text-industrial-500">Nome descritivo (opcional)</p>
                </div>

                <div class="md:col-span-2">
                  <label for="location" class="block text-sm font-medium app-muted mb-2">
                    Localização
                  </label>
                  <input type="text" id="location" name="location" value="{{ old('location') || '' }}" maxlength="100"
                    placeholder="Ex: Salão Principal, Varanda, 2º Andar"
                    class="w-full px-3 py-2 rounded-md app-border shadow-sm focus:ring-accent-500 focus:border-accent-500">
                  <p class="mt-1 text-sm text-industrial-500">Área ou andar da mesa</p>
                </div>

                <div>
                  <label for="capacity" class="block text-sm font-medium app-muted mb-2">
                    Capacidade
                  </label>
                  <input type="number" id="capacity" name="capacity" value="{{ old('capacity') || '' }}" min="1"
                    placeholder="Ex: 4, 6, 8"
                    class="w-full px-3 py-2 rounded-md app-border shadow-sm focus:ring-accent-500 focus:border-accent-500">
                  <p class="mt-1 text-sm text-industrial-500">Número de pessoas (opcional)</p>
                </div>

                <div>
                  <label for="status" class="block text-sm font-medium app-muted mb-2">
                    Status de Operação
                  </label>
                  <select id="status" name="status" class="w-full px-3 py-2 rounded-md app-border shadow-sm focus:ring-accent-500 focus:border-accent-500">
                    <option value="available" {{ old('status') === 'available' || !old('status') ? 'selected' : '' }}>Disponível</option>
                    <option value="occupied" {{ old('status') === 'occupied' ? 'selected' : '' }}>Ocupada</option>
                    <option value="reserved" {{ old('status') === 'reserved' ? 'selected' : '' }}>Reservada</option>
                    <option value="maintenance" {{ old('status') === 'maintenance' ? 'selected' : '' }}>Manutenção</option>
                  </select>
                  <p class="mt-1 text-sm text-industrial-500">Status operacional da mesa</p>
                </div>
              </div>
            </div>

            <!-- Ativo/Inativo -->
            <div>
              <h3 class="text-lg font-semibold text-industrial-900 mb-4 pb-2 border-b border-industrial-100">Ativo/Inativo</h3>
              <div class="flex items-center">
                <input type="checkbox" id="active" name="active" value="1" {{ old('active', true) ? 'checked' : '' }}
                  class="h-4 w-4 text-accent-600 focus:ring-accent-500 border-industrial-300 rounded">
                <label for="active" class="ml-2 block text-sm app-muted">
                  Mesa ativa
                </label>
              </div>
              <p class="mt-1 text-sm text-industrial-500 ml-6">
                Mesas inativas não aparecem na lista de seleção
              </p>
            </div>

            <!-- Botões -->
            <div class="flex items-center justify-end gap-3 pt-6 border-t border-industrial-100">
              <a href="{{ route('mesas.index') }}"
                class="inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-semibold app-muted shadow-sm ring-1 ring-inset ring-industrial-200 hover:bg-industrial-100">
                Cancelar
              </a>
              <button type="submit" class="inline-flex items-center rounded-md bg-accent-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-accent-500">
                Criar Mesa
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
  @include('components/quick_actions')
</body>
</html>