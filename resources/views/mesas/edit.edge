    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-3xl py-6 sm:px-6 lg:px-8">
        <!-- Flash Messages -->
        @if(flashMessages.has('error'))
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">{{ flashMessages.get('error') }}</p>
            </div>
          </div>
        </div>
        @end

        @if(flashMessages.has('errors'))
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">Erros de validação:</p>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                @each(error in Object.values(flashMessages.get('errors')).flat())
                <li>{{ error }}</li>
                @end
              </ul>
            </div>
          </div>
        </div>
        @end

  <div class="bg-white rounded-lg shadow p-6">
    <form action="{{ route('mesas.update', [mesa.id]) }}" method="POST" class="space-y-6">
      {{ csrfField() }}
      <input type="hidden" name="_method" value="PUT">

      <!-- Informações Básicas -->
      <div>
        <h3 class="text-lg font-medium text-industrial-900 mb-4 pb-2 border-b">Informações Básicas</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="number" class="block text-sm font-medium app-muted mb-2">
              Número *
            </label>
            <input 
              type="text"
              id="number" 
              name="number" 
              value="{{ old('number', mesa.number) }}" 
              required 
              maxlength="20"
              placeholder="Ex: 1, 101, A1"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">Identificação única da mesa</p>
          </div>

          <div>
            <label for="name" class="block text-sm font-medium app-muted mb-2">
              Nome
            </label>
            <input 
              type="text"
              id="name" 
              name="name" 
              value="{{ old('name', mesa.name) }}" 
              maxlength="100"
              placeholder="Ex: Mesa VIP, Mesa Externa"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">Nome descritivo (opcional)</p>
          </div>

          <div class="md:col-span-2">
            <label for="location" class="block text-sm font-medium app-muted mb-2">
              Localização
            </label>
            <input 
              type="text"
              id="location" 
              name="location" 
              value="{{ old('location', mesa.location) }}" 
              maxlength="100"
              placeholder="Ex: Salão Principal, Varanda, 2º Andar"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">Área ou andar da mesa</p>
          </div>

          <div>
            <label for="capacity" class="block text-sm font-medium app-muted mb-2">
              Capacidade
            </label>
            <input 
              type="number"
              id="capacity" 
              name="capacity" 
              value="{{ old('capacity', mesa.capacity) }}" 
              min="1"
              placeholder="Ex: 4, 6, 8"
              class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
            >
            <p class="mt-1 text-sm text-industrial-500">Número de pessoas (opcional)</p>
          </div>

          <div>
            <label for="status" class="block text-sm font-medium app-muted mb-2">
              Status de Operação
            </label>
            <select id="status" name="status" class="w-full px-3 py-2 app-border rounded-md focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
              <option value="available" {{ old('status', mesa.status) === 'available' ? 'selected' : '' }}>Disponível</option>
              <option value="occupied" {{ old('status', mesa.status) === 'occupied' ? 'selected' : '' }}>Ocupada</option>
              <option value="reserved" {{ old('status', mesa.status) === 'reserved' ? 'selected' : '' }}>Reservada</option>
              <option value="maintenance" {{ old('status', mesa.status) === 'maintenance' ? 'selected' : '' }}>Manutenção</option>
            </select>
            <p class="mt-1 text-sm text-industrial-500">Status operacional da mesa</p>
          </div>
        </div>
      </div>

      <!-- Ativo/Inativo -->
      <div>
        <h3 class="text-lg font-medium text-industrial-900 mb-4 pb-2 border-b">Ativo/Inativo</h3>
        <div class="flex items-center">
          <input 
            type="checkbox"
            id="active" 
            name="active" 
            value="1"
            {{ old('active', mesa.active) ? 'checked' : '' }}
            class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-industrial-300 rounded"
          >
          <label for="active" class="ml-2 block text-sm app-muted">
            Mesa ativa
          </label>
        </div>
        <p class="mt-1 text-sm text-industrial-500 ml-6">
          Mesas inativas não aparecem na lista de seleção
        </p>
      </div>

      <!-- Botões -->
      <div class="flex items-center justify-end gap-3 pt-6 border-t">
        <a 
          href="{{ route('mesas.show', [mesa.id]) }}" 
          class="px-4 py-2 app-border rounded-md app-muted hover:bg-industrial-50"
        >
          Cancelar
        </a>
        <button 
          type="submit" 
          class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
        >
          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
      </div>
    </main>
  </div>
