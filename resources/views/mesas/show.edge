<body class="h-full font-sans text-industrial-900">
  <div class="min-h-full">
    <header class="bg-white shadow">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div class="flex items-center space-x-3 ml-auto">
            <h1 class="text-xl font-semibold leading-6 text-industrial-900">
              Mesa {{ mesa.number }}
              @if(mesa.name)
                <span class="text-industrial-500 font-normal text-base">- {{ mesa.name }}</span>
              @end
            </h1>
            <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold {{ mesa.active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }}">
              {{ mesa.active ? 'Ativa' : 'Inativa' }}
            </span>
          </div>
          <div class="flex items-center space-x-4 ml-auto">
            <a href="{{ route('mesas.edit', [mesa.id]) }}" class="inline-flex items-center rounded-md bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">Editar</a>
            <a href="{{ route('mesas.index') }}" class="inline-flex items-center rounded-md bg-industrial-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-industrial-500"><i class="fas fa-list mr-2"></i> Lista de Mesas</a>
          </div>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
          <i class="fas fa-receipt text-blue-600 text-2xl"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium app-muted">Total de Comandas</p>
          <p class="text-2xl font-bold text-industrial-900">{{ mesa.comandas.length }}</p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
          <i class="fas fa-check-circle text-green-600 text-2xl"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium app-muted">Comandas Ativas</p>
          <p class="text-2xl font-bold text-industrial-900">
            {{ mesa.comandas.filter(c => c.isActive).length }}
          </p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-purple-100 rounded-lg p-3">
          <i class="fas fa-users text-purple-600 text-2xl"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium app-muted">Capacidade</p>
          <p class="text-2xl font-bold text-industrial-900">
            {{ mesa.capacity ? mesa.capacity + ' pessoas' : 'N/A' }}
          </p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-yellow-100 rounded-lg p-3">
          <i class="fas fa-clipboard-list text-yellow-600 text-2xl"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium app-muted">Status</p>
          <p class="text-lg font-bold text-industrial-900">
            @if(mesa.status === 'available')
              <span class="text-green-600">Disponível</span>
            @elseif(mesa.status === 'occupied')
              <span class="text-red-600">Ocupada</span>
            @elseif(mesa.status === 'reserved')
              <span class="text-yellow-600">Reservada</span>
            @else
              <span class="app-muted">Manutenção</span>
            @end
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Comandas da Mesa -->
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-industrial-200 flex justify-between items-center">
      <h2 class="text-lg font-semibold text-industrial-900">Comandas Vinculadas</h2>
      <a href="{{ route('comandas.create') }}?mesa_id={{ mesa.id }}" 
         class="inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-green-500">
        <i class="fas fa-plus mr-2"></i>
        Nova Comanda
      </a>
    </div>

    @if(mesa.comandas.length > 0)
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-industrial-200">
          <thead class="bg-industrial-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-industrial-500 uppercase tracking-wider">
                Número
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-industrial-500 uppercase tracking-wider">
                Nome
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-industrial-500 uppercase tracking-wider">
                Situação
              </th>
              <th class="px-6 py-3 text-right text-xs font-medium text-industrial-500 uppercase tracking-wider">
                Ações
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-industrial-200">
            @each(comanda in mesa.comandas)
              <tr class="hover:bg-industrial-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-industrial-900">{{ comanda.number }}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-industrial-900">{{ comanda.name || '-' }}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  @if(comanda.active)
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Ativa
                    </span>
                  @else
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-industrial-100 app-muted">
                      Inativa
                    </span>
                  @end
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <a 
                    href="{{ route('comandas.show', [comanda.id]) }}" 
                    class="text-blue-600 hover:text-blue-900"
                    title="Ver comanda"
                  >
                    <i class="fas fa-eye"></i>
                  </a>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="px-6 py-12 text-center text-industrial-500">
        <i class="fas fa-inbox text-4xl mb-3 text-industrial-300"></i>
        <p>Nenhuma comanda vinculada a esta mesa</p>
        <p class="text-sm mt-2">Comandas podem ser vinculadas ao criar ou editar</p>
      </div>
    @end
      </div>
    </main>
  </div>
