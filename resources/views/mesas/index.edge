    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
        <!-- Flash Messages -->
        @if(flashMessages.has('success'))
        <div class="mb-6 rounded-md bg-green-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-check-circle text-green-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-green-800">{{ flashMessages.get('success') }}</p>
            </div>
          </div>
        </div>
        @end

        @if(flashMessages.has('error'))
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">{{ flashMessages.get('error') }}</p>
            </div>
          </div>
        </div>
        @end

        <!-- Filtros -->
        <div class="bg-white rounded-xl shadow-sm ring-1 ring-industrial-100 p-6 mb-6">
          <form method="GET" action="{{ route('mesas.index') }}" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-sm font-medium app-muted mb-2">Buscar</label>
              <input type="text" name="search" value="{{ filters.search }}" placeholder="Número ou nome..."
                class="w-full px-3 py-2 app-border rounded-lg shadow-sm focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
            </div>

            <div>
              <label class="block text-sm font-medium app-muted mb-2">Localização</label>
              <select name="location"
                class="w-full px-3 py-2 app-border rounded-lg shadow-sm focus:ring-2 focus:ring-accent-500 focus:border-accent-500">
                <option value="">Todas</option>
                @each(location in locations)
                <option value="{{ location }}" {{ filters.location===location ? 'selected' : '' }}>
                  {{ location }}
                </option>
                @end
              </select>
            </div>

            <div class="flex items-end">
              <label class="inline-flex items-center">
                <input type="checkbox" name="active_only" value="1" {{ filters.activeOnly ? 'checked' : '' }}
                  class="rounded border-industrial-300 text-accent-600 focus:ring-accent-500">
                <span class="ml-2 text-sm app-muted">Apenas ativas</span>
              </label>
            </div>

            <div class="flex items-end gap-2">
              <button type="submit" class="flex-1 bg-accent-600 text-white px-4 py-2 rounded-lg shadow-sm font-semibold hover:bg-accent-500">
                Filtrar
              </button>
              <a href="{{ route('mesas.index') }}" class="px-4 py-2 app-border rounded-lg shadow-sm font-semibold app-muted hover:bg-industrial-50">
                Limpar
              </a>
            </div>
          </form>
        </div>

        <!-- Lista de Mesas -->
        <div class="bg-white rounded-xl shadow-sm ring-1 ring-industrial-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-industrial-100">
              <thead class="bg-industrial-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    Número
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    Nome
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    Localização
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    Comandas
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">
                    Status
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">
                    Ações
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-industrial-100">
                @if(mesas.data.length > 0)
                @each(mesa in mesas.data)
                <tr class="hover:bg-industrial-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-semibold text-industrial-900">Mesa {{ mesa.number }}</div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-industrial-900">{{ mesa.name || '-' }}</div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm app-muted">{{ mesa.location || '-' }}</div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span
                      class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-50 text-accent-700">
                      {{ (mesa.$extras && mesa.$extras.comandas_count) || 0 }} comandas
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center gap-2">
                      @let(operationalStatus = mesa.active ? mesa.status : 'maintenance')

                      @if(operationalStatus === 'occupied')
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700">
                        <i class="fas fa-chair mr-1"></i>
                        Ocupada
                      </span>
                      @elseif(operationalStatus === 'reserved')
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700">
                        <i class="fas fa-calendar-check mr-1"></i>
                        Reservada
                      </span>
                      @elseif(operationalStatus === 'maintenance')
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                        <i class="fas fa-tools mr-1"></i>
                        Manutenção
                      </span>
                      @else
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-700">
                        <i class="fas fa-circle-check mr-1"></i>
                        Disponível
                      </span>
                      @end

                      @if(mesa.active)
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-green-100 text-green-700">
                        <i class="fas fa-check-circle mr-1"></i>
                        Ativa
                      </span>
                      @else
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-industrial-100 app-muted">
                        <i class="fas fa-times-circle mr-1"></i>
                        Inativa
                      </span>
                      @end
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div class="flex items-center justify-end gap-3">
                      <a href="{{ route('mesas.show', [mesa.id]) }}" class="text-accent-600 hover:text-accent-500"
                        title="Ver detalhes">
                        <i class="fas fa-eye"></i>
                      </a>                      
                      <a href="{{ route('mesas.edit', [mesa.id]) }}" class="app-muted hover:text-industrial-500"
                        title="Editar">
                        <i class="fas fa-edit"></i>
                      </a>                                            
                      <form action="{{ route('mesas.toggleActive', [mesa.id]) }}" method="POST" class="inline"
                        onsubmit="return confirm('Deseja alterar o status desta mesa?')">
                        {{ csrfField() }}
                        <button type="submit" class="app-muted hover:text-industrial-500"
                          title="{{ mesa.active ? 'Desativar' : 'Ativar' }}">
                          <i class="fas fa-power-off"></i>
                        </button>
                      </form>                                            
                      <form action="{{ route('mesas.destroy', [mesa.id]) }}" method="POST" class="inline"
                        onsubmit="return confirm('Tem certeza que deseja excluir esta mesa?')">
                        {{ csrfField() }}
                        <input type="hidden" name="_method" value="DELETE">
                        <button type="submit" class="text-red-600 hover:text-red-500" title="Excluir">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>                      
                    </div>
                  </td>
                </tr>
                @end
                @else
                <tr>
                  <td colspan="6" class="px-6 py-12 text-center app-muted">
                    <i class="fas fa-inbox text-4xl mb-3 text-industrial-200"></i>
                    <p>Nenhuma mesa cadastrada</p>
                  </td>
                </tr>
                @end
              </tbody>
            </table>
          </div>

          <!-- Paginação -->
          @if(mesas.lastPage > 1)
          <div class="bg-industrial-50 px-4 py-3 border-t border-industrial-100 sm:px-6">
            <div class="flex items-center justify-between">
              <div class="text-sm app-muted">
                Mostrando <span class="font-semibold">{{ mesas.firstItem }}</span> até
                <span class="font-semibold">{{ mesas.lastItem }}</span> de
                <span class="font-semibold">{{ mesas.total }}</span> resultados
              </div>
              <div class="flex gap-2">
                @if(mesas.hasPages)
                @each(page in mesas.getUrlRange(1, mesas.lastPage))
                <a href="{{ page.url }}"
                  class="px-3 py-1 rounded-lg font-semibold {{ page.isActive ? 'bg-accent-600 text-white' : 'bg-white app-muted hover:bg-industrial-50 app-border' }}">
                  {{ page.page }}
                </a>
                @end
                @end
              </div>
            </div>
          </div>
          @end
        </div>
      </div>    <!-- Fecha mx-auto max-w-7xl -->
    </main>
  </div>
  @include('components/quick_actions')
