<!DOCTYPE html>
<html lang="pt-BR" data-theme="{{ theme }}" class="h-full bg-industrial-50">
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vendas - Tavolo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="h-full font-sans text-industrial-900">
  <div class="min-h-full">
    <header class="bg-white shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-accent-500/10 text-accent-600 flex items-center justify-center">
            <i class="fas fa-cash-register"></i>
          </div>
          <div>
            <h1 class="text-lg font-semibold text-industrial-900">Vendas</h1>
            <p class="text-sm text-industrial-500">Histórico e filtros</p>
          </div>
          <div class="flex items-center gap-2 ml-auto">
            <!--a href="{{ route('vendas.create') }}"
              class="inline-flex items-center rounded-md bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
              <i class="fas fa-plus -ml-0.5 mr-1.5"></i> Nova Venda
            </a -->
            <a href="{{ route('dashboard.index') }}"
              class="inline-flex items-center gap-2 rounded-lg bg-industrial-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-industrial-400">
              <i class="fas fa-home mr-2"></i> Dashboard
            </a>
          </div>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
        <!-- Filtros -->
        <div class="bg-white  rounded-xl ring-1 ring-industrial-100 mb-6">
          <div class="px-6 py-4 border-b border-industrial-100">
            <h2 class="text-lg font-semibold text-industrial-900">Filtros</h2>
          </div>
          <div class="p-6">
            <form method="GET" class="grid grid-cols-1 gap-4 md:grid-cols-5">
              <div>
                <input type="text" name="search" placeholder="Buscar..." value="{{ filters.search || '' }}"
                  class="block w-full rounded-lg border-industrial-200  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
              </div>
              <div>
                <select name="payment_method"
                  class="block w-full rounded-lg border-industrial-200  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
                  <option value="">Todos</option>
                  <option value="cash" {{ filters.paymentMethod==='cash' ? 'selected' : '' }}>Dinheiro</option>
                  <option value="card" {{ filters.paymentMethod==='card' ? 'selected' : '' }}>Cartão</option>
                  <option value="pix" {{ filters.paymentMethod==='pix' ? 'selected' : '' }}>PIX</option>
                </select>
              </div>
              <div>
                <input type="date" name="date_from" value="{{ filters.dateFrom || '' }}"
                  class="block w-full rounded-lg border-industrial-200  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
              </div>
              <div>
                <input type="date" name="date_to" value="{{ filters.dateTo || '' }}"
                  class="block w-full rounded-lg border-industrial-200  focus:border-accent-500 focus:ring-accent-500 sm:text-sm">
              </div>
              <div class="flex items-end gap-2">
                <button type="submit"
                  class="flex-1 inline-flex justify-center items-center gap-2 rounded-lg bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
                  <i class="fas fa-search"></i> Filtrar
                </button>
                @if(filters.search || filters.paymentMethod || filters.dateFrom || filters.dateTo)
                <a href="{{ route('vendas.index') }}"
                  class="inline-flex items-center rounded-lg bg-industrial-200 px-3 py-2 text-sm font-semibold app-muted  hover:bg-industrial-300">
                  <i class="fas fa-times"></i>
                </a>
                @endif
              </div>
            </form>
          </div>
        </div>

        <!-- Lista -->
        <div class="bg-white  rounded-xl ring-1 ring-industrial-100">
          <div class="px-6 py-4 border-b border-industrial-100">
            <h2 class="text-lg font-semibold text-industrial-900">Histórico de Vendas</h2>
          </div>
          @if(vendas.data.length === 0)
          <div class="text-center py-12">
            <i class="fas fa-cash-register text-6xl text-industrial-200 mb-4"></i>
            <h3 class="mt-2 text-sm font-semibold text-industrial-900">Nenhuma venda encontrada</h3>
            <p class="mt-1 text-sm app-muted">Comece registrando uma nova venda.</p>
            <div class="mt-6">
              <a href="{{ route('vendas.create') }}"
                class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-3 py-2 text-sm font-semibold text-white  hover:bg-accent-500">
                <i class="fas fa-plus"></i> Nova Venda
              </a>
            </div>
          </div>
          @else
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-industrial-100">
              <thead class="bg-industrial-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Número</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Data</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Pagamento
                  </th>
                  <th class="px-6 py-3 text-right text-xs font-semibold app-muted uppercase tracking-wider">Total</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold app-muted uppercase tracking-wider">Atendente
                  </th>
                  <th class="relative px-6 py-3"><span class="sr-only">Ações</span></th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-industrial-100">
                @each(venda in vendas.data)
                <tr class="hover:bg-industrial-50">
                  <td class="px-6 py-4 text-sm font-semibold text-industrial-900">#{{ venda.saleNumber }}</td>
                  <td class="px-6 py-4 text-sm app-muted">{{{ formatDateTimestamp(venda.saleDate) }}}</td>
                  <td class="px-6 py-4">
                    <span
                      class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold {{ venda.paymentMethod === 'cash' ? 'bg-green-50 text-green-700' : venda.paymentMethod === 'card' ? 'bg-blue-50 text-blue-700' : 'bg-purple-50 text-purple-700' }}">
                      {{ venda.paymentMethod === 'cash' ? 'Dinheiro' : venda.paymentMethod === 'card' ? 'Cartão' : 'PIX'
                      }}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm font-semibold text-industrial-900 text-right">{{ formatCurrency(venda.total) }}
                  </td>
                  <td class="px-6 py-4 text-sm app-muted">
                    @if(venda.comanda && venda.comanda.pedidos && venda.comanda.pedidos.length)
                      {{ venda.comanda.pedidos
                        .filter(p => p.funcionario)
                        .map(p => p.funcionario.name)
                        .filter((name, idx, arr) => arr.indexOf(name) === idx)
                        .join(', ') || '-' }}
                    @else
                      -
                    @endif
                  </td>
                  <td class="px-6 py-4 text-right text-sm font-medium">
                    <a href="{{ route('vendas.show', [venda.id]) }}" class="text-accent-600 hover:text-accent-500">
                      <i class="fas fa-eye"></i>
                    </a>
                  </td>
                </tr>
                @end
              </tbody>
            </table>
          </div>
          @endif
        </div>
      </div>
    </main>
  </div>
  @include('components/quick_actions')
</body>
</html>