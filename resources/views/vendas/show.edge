                    <dd class="mt-1">
                      <span id="nfceStatusBadge" class="inline-flex rounded-full px-3 py-1 text-sm">
                        @if(!fiscalNote)
                          <span class="bg-industrial-100 app-muted px-3 py-1 rounded-full">Não emitida</span>
                        @elseif(fiscalNote.status === 'AUTHORIZED')
                          <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full">Autorizada</span>
                        @elseif(fiscalNote.status === 'PENDING')
                          <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full">Pendente</span>
                        @elseif(fiscalNote.status === 'CANCELLED')
                          <span class="bg-industrial-200 app-muted px-3 py-1 rounded-full">Cancelada</span>
                        @elseif(fiscalNote.status === 'CONTINGENCY')
                          <span class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full">Contingência</span>
                        @else
                          <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full">Erro</span>
                        @end
                      </span>
                    </dd>
                  </div>
                  @if(!fiscalNote || fiscalNote.status === 'PENDING')
                  <div id="nfceStatusHint" class="text-xs text-industrial-500">
                    NF-e em processamento. O status será atualizado automaticamente.
                  </div>
                  @end
                  <script>
                    const shouldPoll = {{ !fiscalNote || fiscalNote.status === 'PENDING' ? 'true' : 'false' }}
                    const vendaId = {{ venda.id }}
                    const initialStatus = '{{ fiscalNote ? fiscalNote.status : 'NOT_ISSUED' }}'
                    const statusMap = {
                      NOT_ISSUED: { label: 'Não emitida', className: 'bg-industrial-100 app-muted' },
                      AUTHORIZED: { label: 'Autorizada', className: 'bg-green-100 text-green-700' },
                      PENDING: { label: 'Pendente', className: 'bg-yellow-100 text-yellow-700' },
                      CANCELLED: { label: 'Cancelada', className: 'bg-industrial-200 app-muted' },
                      CONTINGENCY: { label: 'Contingência', className: 'bg-orange-100 text-orange-700' },
                      ERROR: { label: 'Erro', className: 'bg-red-100 text-red-700' },
                    }

                    const updateBadge = (status) => {
                      const badge = document.getElementById('nfceStatusBadge')
                      if (!badge) return
                      const data = statusMap[status] || statusMap.ERROR
                      badge.innerHTML = `<span class="${data.className} px-3 py-1 rounded-full">${data.label}</span>`
                    }

                    const updateButtons = (status) => {
                      const emitBtn = document.getElementById('emitNfeBtn')
                      const emitLabel = document.getElementById('emitNfeLabel')
                      const printBtn = document.getElementById('printNfeModalBtn')

                      if (status === 'AUTHORIZED') {
                        if (emitBtn) emitBtn.classList.add('hidden')
                        if (printBtn) printBtn.classList.remove('hidden')
                        return
                      }

                      if (status === 'PENDING') {
                        if (emitLabel) emitLabel.textContent = 'Emitindo NF-e...'
                        if (emitBtn) emitBtn.setAttribute('disabled', 'disabled')
                        if (emitBtn) emitBtn.classList.add('opacity-60', 'cursor-not-allowed')
                        if (printBtn) printBtn.classList.add('hidden')
                        return
                      }

                      if (emitLabel) emitLabel.textContent = status === 'ERROR' ? 'Reemitir NF-e' : 'Emitir NF-e'
                      if (emitBtn) emitBtn.removeAttribute('disabled')
                      if (emitBtn) emitBtn.classList.remove('opacity-60', 'cursor-not-allowed')
                      if (printBtn) printBtn.classList.add('hidden')
                    }

                    const stopHintIfDone = (status) => {
                      if (status === 'PENDING' || status === 'NOT_ISSUED') return
                      const hint = document.getElementById('nfceStatusHint')
                      if (hint) {
                        hint.remove()
                      }
                    }

                    const pollStatus = async () => {
                      try {
                        const res = await fetch(`/api/vendas/${vendaId}/fiscal-note`, {
                          credentials: 'include',
                        })
                        if (!res.ok) return
                        const data = await res.json()
                        const status = data?.fiscalNote?.status || 'NOT_ISSUED'
                        updateBadge(status)
                        updateButtons(status)
                        stopHintIfDone(status)
                        if (status !== 'PENDING' && status !== 'NOT_ISSUED') {
                          clearInterval(window.__nfceStatusPoll)
                        }
                      } catch (error) {
                        // silencioso
                      }
                    }

                    updateButtons(initialStatus)

                    if (shouldPoll) {
                      window.__nfceStatusPoll = setInterval(pollStatus, 10000)
                    }
                  </script>
