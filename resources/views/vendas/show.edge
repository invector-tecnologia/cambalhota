      <!-- Header da Modal -->
      <div class="flex items-center justify-between p-6 border-b border-industrial-100">
        <h3 class="text-lg font-semibold text-industrial-900">Nota Fiscal - Venda #{{ venda.saleNumber }}</h3>
        <button id="closeModal" class="text-industrial-400 hover:app-muted text-2xl leading-none">
          ✕
        </button>
      </div>
      
      <!-- Conteúdo da Modal (iframe) -->
      <div class="flex-1 overflow-auto">
        <iframe id="printFrame" 
          src="{{ route('vendas.print', [venda.id]).replace(/https?:\/\/[^/]+/, '') }}"
          class="w-full h-full border-0"></iframe>
      </div>
      
      <!-- Footer da Modal -->
      <div class="flex items-center justify-between p-6 border-t border-industrial-100 bg-industrial-50">
        <button id="printFromModal"
                class="inline-flex items-center px-4 py-2 bg-accent-600 text-white text-sm font-semibold rounded-md hover:bg-accent-500">
          <i class="fas fa-print mr-2"></i> Imprimir
        </button>
        <button id="closeModalBtn"
                class="inline-flex items-center px-4 py-2 app-border app-muted text-sm font-semibold rounded-md bg-white hover:bg-industrial-50">
          <i class="fas fa-times mr-2"></i> Fechar
        </button>
      </div>
    </div>
  </div>

  <!-- Modal de Emissão de NF-e -->
  <div id="emitNfeModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
      <div class="flex items-center justify-between p-6 border-b border-industrial-100">
        <h3 class="text-lg font-semibold text-industrial-900">
          {{ fiscalNote && fiscalNote.status === 'ERROR' ? 'Reemitir NF-e' : 'Emitir NF-e' }}
        </h3>
        <button id="closeEmitNfeModal" class="text-industrial-400 hover:app-muted text-2xl leading-none cursor-pointer">✕</button>
      </div>
      <form id="emitNfeForm" class="p-6 space-y-4">
        {{ csrfField() }}
        <div>
          <label for="nfeCpf" class="block text-sm font-semibold text-industrial-900 mb-2">
            CPF do Cliente <span class="text-red-500">*</span> (Opcional)
          </label>
          <input 
            type="text" 
            id="nfeCpf" 
            name="cpf"
            placeholder="000.000.000-00"
            class="w-full px-4 py-2 border border-industrial-200 rounded-md focus:outline-none focus:ring-2 focus:ring-accent-500"
          />
          <p class="text-xs text-industrial-500 mt-1">
            Se deixar em branco, a NF-e será emitida sem CPF do cliente.
          </p>
        </div>
        <div class="flex gap-3">
          <button 
            type="submit" 
            id="emitNfeSubmitBtn"
            data-label="{{ fiscalNote && fiscalNote.status === 'ERROR' ? 'Reemitir NF-e' : 'Emitir NF-e' }}"
            class="flex-1 inline-flex items-center justify-center px-4 py-2 bg-blue-600 border border-transparent text-sm font-semibold rounded-md text-white hover:bg-blue-500">
            <i class="fas fa-file-excel mr-2"></i>
            {{ fiscalNote && fiscalNote.status === 'ERROR' ? 'Reemitir NF-e' : 'Emitir NF-e' }}
          </button>
          <button 
            type="button"
            onclick="document.getElementById('emitNfeModal').classList.add('hidden')"
            class="flex-1 inline-flex items-center justify-center px-4 py-2 app-border app-muted text-sm font-semibold rounded-md bg-white hover:bg-industrial-50">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de Impressão de NF-e -->
  @if(fiscalNote && fiscalNote.status !== 'ERROR')
  <div id="printNfeModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl h-[90vh] flex flex-col" style="width: 90mm;">
      <div class="flex items-center justify-between p-6 border-b border-industrial-100">
        <h3 class="text-lg font-semibold text-industrial-900">NF-e - Venda #{{ venda.saleNumber }}</h3>
        <button id="closeNfeModal" class="text-industrial-400 hover:app-muted text-2xl leading-none">✕</button>
      </div>
      <div class="flex-1 overflow-auto">
        <iframe id="printNfeFrame" src="{{ route('vendas.nfe.print', [venda.id]).replace(/https?:\/\/[^/]+/, '') }}" class="w-full h-full border-0"></iframe>
      </div>
      <div class="flex items-center justify-between p-6 border-t border-industrial-100 bg-industrial-50">
        <button id="printFromNfeModal" class="inline-flex items-center px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-md hover:bg-green-500">
          <i class="fas fa-print mr-2"></i> Imprimir
        </button>
        <button id="closeNfeModalBtn" class="inline-flex items-center px-4 py-2 app-border app-muted text-sm font-semibold rounded-md bg-white hover:bg-industrial-50">
          <i class="fas fa-times mr-2"></i> Fechar
        </button>
      </div>
    </div>
  </div>
  @end

  <script>
    const printModalBtn = document.getElementById('printModalBtn')
    const printModal = document.getElementById('printModal')
    const closeModal = document.getElementById('closeModal')
    const closeModalBtn = document.getElementById('closeModalBtn')
    const printFromModal = document.getElementById('printFromModal')
    const printFrame = document.getElementById('printFrame')
    const printUrl = "{{ route('vendas.print', [venda.id]).replace(/https?:\/\/[^/]+/, '') }}"

    // NF-e modal elements
    const printNfeModalBtn = document.getElementById('printNfeModalBtn')
    const printNfeModal = document.getElementById('printNfeModal')
    const closeNfeModal = document.getElementById('closeNfeModal')
    const closeNfeModalBtn = document.getElementById('closeNfeModalBtn')
    const printFromNfeModal = document.getElementById('printFromNfeModal')
    const printNfeFrame = document.getElementById('printNfeFrame')
    const printNfeUrl = "{{ route('vendas.nfe.print', [venda.id]).replace(/https?:\/\/[^/]+/, '') }}"

    // Abrir modal
    printModalBtn?.addEventListener('click', () => {
      if (printFrame && printUrl) {
        printFrame.src = printUrl
      }
      printModal.classList.remove('hidden')
    })

    // Fechar modal (botão X)
    closeModal?.addEventListener('click', () => {
      printModal.classList.add('hidden')
    })

    // Fechar modal (botão Fechar)
    closeModalBtn?.addEventListener('click', () => {
      printModal.classList.add('hidden')
    })

    // Fechar modal ao clicar fora
    printModal?.addEventListener('click', (e) => {
      if (e.target === printModal) {
        printModal.classList.add('hidden')
      }
    })

    // Imprimir conteúdo do iframe
    printFromModal?.addEventListener('click', () => {
      try {
        printFrame.contentWindow?.print()
      } catch (error) {
        console.error('Erro ao imprimir:', error)
      }
    })

    // Abrir modal NF-e
    printNfeModalBtn?.addEventListener('click', () => {
      if (printNfeFrame && printNfeUrl) {
        printNfeFrame.src = printNfeUrl
      }
      printNfeModal.classList.remove('hidden')
    })

    // Fechar NF-e modal
    closeNfeModal?.addEventListener('click', () => {
      printNfeModal.classList.add('hidden')
    })
    closeNfeModalBtn?.addEventListener('click', () => {
      printNfeModal.classList.add('hidden')
    })
    printNfeModal?.addEventListener('click', (e) => {
      if (e.target === printNfeModal) {
        printNfeModal.classList.add('hidden')
      }
    })

    // Imprimir NF-e iframe
    printFromNfeModal?.addEventListener('click', () => {
      try {
        printNfeFrame.contentWindow?.print()
      } catch (error) {
        console.error('Erro ao imprimir NF-e:', error)
      }
    })

    // Modal de Emissão de NF-e
    const emitNfeBtn = document.getElementById('emitNfeBtn')
    const emitNfeModal = document.getElementById('emitNfeModal')
    const closeEmitNfeModal = document.getElementById('closeEmitNfeModal')
    const emitNfeForm = document.getElementById('emitNfeForm')
    const emitNfeSubmitBtn = document.getElementById('emitNfeSubmitBtn')
    const emitNfeDefaultLabel = emitNfeSubmitBtn?.getAttribute('data-label') || 'Emitir NF-e'
    
    console.log('[EMIT_NFE_SETUP] Elements found:', {
      emitNfeBtn: !!emitNfeBtn,
      emitNfeModal: !!emitNfeModal,
      emitNfeForm: !!emitNfeForm,
      emitNfeSubmitBtn: !!emitNfeSubmitBtn
    })

    // Abrir modal
    emitNfeBtn?.addEventListener('click', () => {
      emitNfeModal?.classList.remove('hidden')
    })

    // Fechar modal
    closeEmitNfeModal?.addEventListener('click', () => {
      emitNfeModal?.classList.add('hidden')
    })

    // Fechar ao clicar fora
    emitNfeModal?.addEventListener('click', (e) => {
      if (e.target === emitNfeModal) {
        emitNfeModal?.classList.add('hidden')
      }
    })

    // Enviar formulário
    emitNfeForm?.addEventListener('submit', async (e) => {
      console.log('[EMIT_NFE] Form submit event triggered!')
      e.preventDefault()
      
      const cpfInput = document.getElementById('nfeCpf')
      const cpf = cpfInput?.value || ''
      
      try {
        console.log('[EMIT_NFE] Iniciando emissão de NF-e para venda {{ venda.id }}')
        console.log('[EMIT_NFE] CPF:', cpf)
        
        emitNfeSubmitBtn.disabled = true
        emitNfeSubmitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Emitindo...'
        
        const formData = new FormData()
        formData.append('cpf', cpf)
        
        const url = "/financeiro/vendas/{{ venda.id }}/emit-nfce"
        console.log('[EMIT_NFE] URL:', url)
        
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
        console.log('[EMIT_NFE] CSRF Token:', csrfToken ? 'presente' : 'AUSENTE')
        
        formData.append('_csrf', csrfToken || '')

        const response = await fetch(url, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'X-CSRF-TOKEN': csrfToken || '',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: formData
        })
        
        console.log('[EMIT_NFE] Response status:', response.status)
        
        if (response.ok || response.status === 302 || response.status === 303) {
          console.log('[EMIT_NFE] Emissão bem-sucedida, recarregando...')
          // A resposta será um redirecionamento, então recarregamos a página
          setTimeout(() => window.location.reload(), 500)
        } else {
          const errorText = await response.text()
          console.error('[EMIT_NFE] Response error:', errorText)
          throw new Error('Erro ao emitir NF-e: ' + response.status)
        }
      } catch (error) {
        console.error('[EMIT_NFE] Erro:', error)
        emitNfeSubmitBtn.disabled = false
        emitNfeSubmitBtn.innerHTML = `<i class="fas fa-file-excel mr-2"></i> ${emitNfeDefaultLabel}`
        alert('Erro ao emitir NF-e. Verifique os dados e tente novamente.')
      }
    })
  </script>
  @include('components/quick_actions')
</body>
</html>