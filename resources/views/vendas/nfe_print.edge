<!DOCTYPE html>
<html>
<head>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NF-e - Venda #{{ venda.saleNumber }}</title>
  <style>
    @page { size: 80mm auto; margin: 0; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Courier New', Courier, monospace; font-size: 12px; line-height: 1.4; color: #000; background: #fff; width: 80mm; padding: 5mm; margin: 0 auto; font-weight: bold; }
    .receipt { width: 100%; }
    .header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 8px; }
    .logo { max-width: 60mm; max-height: 25mm; width: auto; height: auto; margin: 0 auto 8px; display: block; object-fit: contain; }
    .empresa-nome { font-size: 14px; font-weight: bold; margin-bottom: 2px; }
    .empresa-info { font-size: 10px; line-height: 1.3; }
    .doc-type { font-size: 13px; font-weight: bold; text-align: center; margin: 8px 0; padding: 6px; background: #f0f0f0; border: 1px solid #000; }
    .info-section { margin-bottom: 8px; font-size: 11px; }
    .info-row { display: flex; justify-content: space-between; margin-bottom: 2px; }
    .info-label { font-weight: bold; }
    .separator { border-top: 2px solid #000; margin: 8px 0; }
    .separator-dashed { border-top: 1px dashed #000; margin: 6px 0; }
    .section-title { font-weight: bold; font-size: 12px; margin-bottom: 4px; text-align: center; }
    .qrcode { display: flex; justify-content: center; align-items: center; margin-top: 8px; margin-bottom: 8px; }
    .qrcode img { display: block; margin: 0 auto; }
    .footer { margin-top: 12px; padding-top: 8px; border-top: 2px solid #000; text-align: center; font-size: 10px; }
    @media print { body { width: 80mm; } .no-print { display: none !important; } }
  </style>
</head>
<body>
  <div class="receipt">
    <div class="header">
      @if(empresa.logoUrl)
        <img src="{{ empresa.logoUrl }}" alt="Logo" class="logo">
      @end
      <div class="empresa-nome">{{ empresa.razaoSocial }}</div>
      @if(empresa.tradeName)
        <div class="empresa-info">{{ empresa.tradeName }}</div>
      @end
      <div class="empresa-info">Documento: {{ empresa.formattedDocument }}</div>
      <div class="empresa-info">Venda: #{{ venda.saleNumber }}</div>
    </div>

    <!-- Área destacada - Informações da NF-e -->    
    <div class="doc-type">NOTA FISCAL ELETRÔNICA (NF-e)</div>

    <div class="info-section">
      <div class="info-row"><span class="info-label">Chave de Acesso:</span><span>{{ nfce.accessKey || '-' }}</span></div>
      <div class="info-row"><span class="info-label">Protocolo:</span><span>{{ nfce.protocolNumber || '-' }}</span></div>
      <div class="info-row"><span class="info-label">Data/Hora:</span><span data-now="datetime"></span></div>
      <div class="info-row"><span class="info-label">Destinatário:</span><span>
        @if(nfeData && nfeData.dest && nfeData.dest.CPF)
          CPF {{ nfeData.dest.CPF }}
        @elseif(nfeData && nfeData.dest && nfeData.dest.CNPJ)
          CNPJ {{ nfeData.dest.CNPJ }}
        @else
          Consumidor final
        @end
      </span></div>
      @if(nfeData && nfeData.dest)
        @if(nfeData.dest.enderDest)
          <div class="info-row"><span class="info-label">Endereço:</span><span>{{ nfeData.dest.enderDest.xLgr }} {{ nfeData.dest.enderDest.nro }} - {{ nfeData.dest.enderDest.xBairro }}</span></div>
          <div class="info-row"><span class="info-label">Cidade/UF:</span><span>{{ nfeData.dest.enderDest.xMun }}/{{ nfeData.dest.enderDest.UF }}</span></div>
          <div class="info-row"><span class="info-label">CEP:</span><span>{{ nfeData.dest.enderDest.CEP }}</span></div>
        @end
      @end
    </div>

    <!-- Emitente -->
    <div class="separator"></div>
    <div class="section-title">EMITENTE</div>
    <div class="separator-dashed"></div>
    <div class="info-section">
      @if(nfeData && nfeData.emit)
        <div class="info-row"><span class="info-label">Razão Social:</span><span>{{ nfeData.emit.xNome || empresa.razaoSocial }}</span></div>
        <div class="info-row"><span class="info-label">Documento:</span><span>{{ nfeData.emit.CNPJ || nfeData.emit.CPF || empresa.formattedDocument }}</span></div>
        @if(nfeData.emit.IE)
          <div class="info-row"><span class="info-label">IE:</span><span>{{ nfeData.emit.IE }}</span></div>
        @end
        @if(nfeData.emit.CRT)
          <div class="info-row"><span class="info-label">Regime (CRT):</span><span>{{ nfeData.emit.CRT }}</span></div>
        @end
        @if(nfeData.emit.enderEmit)
          <div class="info-row"><span class="info-label">Endereço:</span><span>{{ nfeData.emit.enderEmit.xLgr }} {{ nfeData.emit.enderEmit.nro }} - {{ nfeData.emit.enderEmit.xBairro }}</span></div>
          <div class="info-row"><span class="info-label">Cidade/UF:</span><span>{{ nfeData.emit.enderEmit.xMun }}/{{ nfeData.emit.enderEmit.UF }}</span></div>
          <div class="info-row"><span class="info-label">CEP:</span><span>{{ nfeData.emit.enderEmit.CEP }}</span></div>
        @end
      @else
        <div class="info-row"><span>Dados do emitente indisponíveis</span><span></span></div>
      @end
    </div>

    <div class="separator"></div>
    <div class="section-title">ITENS</div>
    <div class="separator-dashed"></div>

    @if(nfeData && nfeData.items && nfeData.items.length)
      @each(item in nfeData.items)
        <div class="item">
          <div class="info-row">
            <span>{{ item.quantity }} x {{ item.name }}</span>
            <span>R$ {{ Number(item.subtotal).toFixed(2).replace('.', ',') }}</span>
          </div>
          <div class="empresa-info" style="display:flex; justify-content:space-between;">
            <span>NCM: {{ item.ncm || '-' }} | CFOP: {{ item.cfop || '-' }} | UN: {{ item.uCom || '-' }}</span>
            <span>V.Unit: R$ {{ Number(item.unitPrice).toFixed(2).replace('.', ',') }}</span>
          </div>
          @if(item.taxes)
            <div class="empresa-info" style="display:flex; justify-content:space-between;">
              <span>ICMS CST: {{ item.taxes.icms.cst || '-' }} | <br /> ICMS: {{ Number(item.taxes.icms.vICMS || 0).toFixed(2).replace('.', ',') }}</span>
              <span>PIS: {{ Number(item.taxes.pis.vPIS || 0).toFixed(2).replace('.', ',') }} | <br /> COFINS: {{ Number(item.taxes.cofins.vCOFINS || 0).toFixed(2).replace('.', ',') }}</span>
            </div>
            @if(item.taxes.ipi && (item.taxes.ipi.vIPI || item.taxes.ipi.pIPI))
              <div class="empresa-info" style="display:flex; justify-content:space-between;">
                <span>IPI: {{ Number(item.taxes.ipi.vIPI || 0).toFixed(2).replace('.', ',') }}</span>
                <span>Alíquota IPI: {{ Number(item.taxes.ipi.pIPI || 0).toFixed(2).replace('.', ',') }}%</span>
              </div>
            @end
          @end
        </div>
      @end
    @else
      <div class="info-row"><span>Itens não disponíveis</span><span></span></div>
    @end

    <div class="separator"></div>
    <div class="section-title">TOTAIS</div>
    <div class="separator-dashed"></div>
    @if(nfeData && nfeData.total)
      <div class="info-row"><span>Total Produtos:</span><span>R$ {{ Number(nfeData.total.vProd || 0).toFixed(2).replace('.', ',') }}</span></div>
      <div class="info-row"><span>Descontos:</span><span>R$ {{ Number(nfeData.total.vDesc || 0).toFixed(2).replace('.', ',') }}</span></div>
      <div class="info-row"><span>ICMS:</span><span>R$ {{ Number(nfeData.total.vICMS || 0).toFixed(2).replace('.', ',') }}</span></div>
      @if(nfeData.total.vBC)
        <div class="info-row"><span>Base ICMS:</span><span>R$ {{ Number(nfeData.total.vBC).toFixed(2).replace('.', ',') }}</span></div>
      @end
      @if(nfeData.total.vBCST)
        <div class="info-row"><span>Base ST:</span><span>R$ {{ Number(nfeData.total.vBCST).toFixed(2).replace('.', ',') }}</span></div>
      @end
      @if(nfeData.total.vST)
        <div class="info-row"><span>ST:</span><span>R$ {{ Number(nfeData.total.vST).toFixed(2).replace('.', ',') }}</span></div>
      @end
      <div class="info-row"><span>PIS:</span><span>R$ {{ Number(nfeData.total.vPIS || 0).toFixed(2).replace('.', ',') }}</span></div>
      <div class="info-row"><span>COFINS:</span><span>R$ {{ Number(nfeData.total.vCOFINS || 0).toFixed(2).replace('.', ',') }}</span></div>
      @if(nfeData.totalsRaw?.ICMSTot?.vIPI)
        <div class="info-row"><span>IPI:</span><span>R$ {{ Number(nfeData.totalsRaw.ICMSTot.vIPI).toFixed(2).replace('.', ',') }}</span></div>
      @end
      @if(nfeData.totalsRaw?.ISSQNtot?.vISS)
        <div class="info-row"><span>ISSQN:</span><span>R$ {{ Number(nfeData.totalsRaw.ISSQNtot.vISS).toFixed(2).replace('.', ',') }}</span></div>
      @end
      <div class="info-row"><span>Valor NF:</span><span>R$ {{ Number(nfeData.total.vNF || 0).toFixed(2).replace('.', ',') }}</span></div>
    @else
      <div class="info-row"><span>TOTAIS não disponíveis</span><span></span></div>
    @end

    <div class="separator"></div>
    <div class="section-title">CONSULTA</div>
    <div class="separator-dashed"></div>

    <div class="qrcode">
      @if(qrCodeUrl)
        <img alt="QR Code NF-e" src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data={{ encodeURIComponent(qrCodeUrl) }}" style="display: block; margin: 0 auto;" />
      @else
        <div style="font-size: 10px; color: #666; text-align: center;">NF-e sem QRCode disponível</div>
      @end
    </div>

    <div class="footer">
      @if(empresa.notaFiscalFooterMessage)
        <div style="margin-bottom: 6px;">{{ empresa.notaFiscalFooterMessage }}</div>
      @end
      <div>Documento válido conforme autorização SEFAZ</div>
    </div>
  </div>
  <script>
    (function () {
      const dateTimeFormatter = new Intl.DateTimeFormat('pt-BR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      })

      document.querySelectorAll('[data-now="datetime"]').forEach((el) => {
        el.textContent = dateTimeFormatter.format(new Date())
      })
    })()
  </script>
</body>
</html>
