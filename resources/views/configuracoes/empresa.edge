  <script>
    // Controlar exibição de CPF/CNPJ baseado no tipo de documento
    const documentType = document.getElementById('documentType');
    const cpfField = document.getElementById('cpfField');
    const cnpjField = document.getElementById('cnpjField');
    const cpfInput = document.getElementById('cpfInput');
    const cnpjInput = document.getElementById('cnpjInput');

    function toggleDocumentFields() {
      if (documentType.value === 'cpf') {
        cpfField.classList.remove('hidden');
        cnpjField.classList.add('hidden');
        cpfInput.required = true;
        cnpjInput.required = false;
      } else {
        cnpjField.classList.remove('hidden');
        cpfField.classList.add('hidden');
        cnpjInput.required = true;
        cpfInput.required = false;
      }
    }

    documentType.addEventListener('change', toggleDocumentFields);

    // Validação do formulário
    const form = document.querySelector('form');
    form.addEventListener('submit', function(e) {
      const state = document.querySelector('input[name="state"]');
      if (state.value && state.value.length !== 2) {
        e.preventDefault();
        alert('UF deve ter exatamente 2 caracteres (ex: SP, RJ, MG).');
        state.focus();
        return;
      }

      // Limpar o campo de documento não selecionado antes de enviar
      if (documentType.value === 'cpf') {
        cnpjInput.value = '';
      } else {
        cpfInput.value = '';
      }
    });

    // Forçar UF em maiúsculo
    const stateInput = document.querySelector('input[name="state"]');
    stateInput.addEventListener('input', function() {
      this.value = this.value.toUpperCase();
    });

    // Buscar código IBGE do município
    const btnBuscarCodIBGE = document.getElementById('btnBuscarCodIBGE');
    const codMunicipioInput = document.getElementById('codMunicipio');
    if (btnBuscarCodIBGE && codMunicipioInput) {
      btnBuscarCodIBGE.addEventListener('click', async function() {
        const cityInput = document.querySelector('input[name="city"]');
        const stateInput = document.querySelector('input[name="state"]');
        
        const city = cityInput.value.trim();
        const state = stateInput.value.trim().toUpperCase();
        
        if (!city || !state) {
          alert('❌ Preencha cidade e UF primeiro');
          return;
        }
        
        if (state.length !== 2) {
          alert('❌ UF deve ter exatamente 2 letras (ex: SP, RJ, MG)');
          stateInput.focus();
          return;
        }
        
        const originalText = this.innerHTML;
        this.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Buscando...';
        this.disabled = true;
        
        try {
          const response = await fetch(`/api/ibge/municipio?city=${encodeURIComponent(city)}&state=${state}`);
          const data = await response.json();
          
          if (data.success && data.codigo) {
            codMunicipioInput.value = data.codigo;
            codMunicipioInput.classList.remove('bg-industrial-50');
            codMunicipioInput.classList.add('bg-green-50', 'border-green-400');
            alert(`✅ Código IBGE encontrado: ${data.codigo}\nMunicípio: ${data.nome}/${data.uf}`);
          } else {
            alert('❌ Código IBGE não encontrado.\n\nVerifique se o nome da cidade está correto.\nExemplo: "São Paulo", "Rio de Janeiro", "Belo Horizonte"');
            cityInput.focus();
          }
        } catch (error) {
          console.error('Erro ao buscar código IBGE:', error);
          alert('❌ Erro ao buscar código IBGE. Tente novamente.');
        } finally {
          this.innerHTML = originalText;
          this.disabled = false;
        }
      });
    }
  </script>
</body>
