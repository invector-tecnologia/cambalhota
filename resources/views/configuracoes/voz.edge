      <!-- Form -->
      <form action="{{ route('configuracoes.updateVoz') }}" method="POST" class="rounded-xl bg-white border border-industrial-200 shadow-sm overflow-hidden">
        {{ csrfField() }}

        <div class="p-6 space-y-6">

          <!-- Status atual -->
          @if(voiceConfig)
            <div class="flex items-center gap-3 text-sm">
              <span class="font-medium text-industrial-700">Status:</span>
              @if(voiceConfig.enabled)
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-green-100 text-green-700">
                  <i class="fas fa-check-circle"></i> Ativo
                </span>
              @else
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-industrial-100 text-industrial-600">
                  <i class="fas fa-pause-circle"></i> Inativo
                </span>
              @end
              @if(voiceConfig.hasKey)
                <span class="text-industrial-500">| Chave: {{ voiceConfig.maskedKey }}</span>
              @end
            </div>
          @end

          <!-- API Key -->
          <div>
            <label for="openaiApiKey" class="block text-sm font-medium text-industrial-700 mb-1">
              API Key da OpenAI
            </label>
            <div class="relative">
              <input type="password" id="openaiApiKey" name="openaiApiKey"
                class="w-full rounded-lg border border-industrial-300 px-3 py-2 pr-10 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-200 transition-colors"
