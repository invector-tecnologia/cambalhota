                autocomplete="new-password" data-1p-ignore data-lpignore="true" data-form-type="other">
              <button type="button" id="toggleApiKeyVisibility"
                class="absolute inset-y-0 right-0 flex items-center pr-3 text-industrial-400 hover:text-industrial-600 transition-colors"
                title="Mostrar/ocultar chave">
                <i class="fas fa-eye" id="toggleApiKeyIcon"></i>
              </button>
            </div>
            <p class="mt-1 text-xs text-industrial-500">
              Obtenha em <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener" class="text-accent-600 underline">platform.openai.com/api-keys</a>
            </p>
          </div>

          <!-- Ativar/Desativar -->
          <div class="flex items-center gap-3">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="hidden" name="enabled" value="false">
              <input type="checkbox" name="enabled" value="true"
                class="sr-only peer"
                {{ voiceConfig && voiceConfig.enabled ? 'checked' : '' }}>
              <div class="w-11 h-6 bg-industrial-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-accent-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-industrial-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-accent-600"></div>
            </label>
            <span class="text-sm font-medium text-industrial-700">Módulo de Voz ativo</span>
          </div>

          <!-- Modelos (avançado) -->
          <details class="group">
            <summary class="cursor-pointer text-sm font-medium text-industrial-500 hover:text-industrial-700 transition-colors">
              <i class="fas fa-sliders-h mr-1"></i> Configurações avançadas
            </summary>
            <div class="mt-4 space-y-4 pl-4 border-l-2 border-industrial-200">
              <div>
                <label for="whisperModel" class="block text-sm font-medium text-industrial-700 mb-1">
                  Modelo Whisper (STT)
                </label>
                <input type="text" id="whisperModel" name="whisperModel"
                  class="w-full rounded-lg border border-industrial-300 px-3 py-2 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-200"
                  value="{{ voiceConfig ? voiceConfig.whisperModel : 'whisper-1' }}"
                  placeholder="whisper-1">
              </div>
              <div>
                <label for="llmModel" class="block text-sm font-medium text-industrial-700 mb-1">
                  Modelo LLM (NLU)
                </label>
                <input type="text" id="llmModel" name="llmModel"
                  class="w-full rounded-lg border border-industrial-300 px-3 py-2 text-sm focus:border-accent-500 focus:ring-2 focus:ring-accent-200"
                  value="{{ voiceConfig ? voiceConfig.llmModel : 'gpt-4o-mini' }}"
                  placeholder="gpt-4o-mini">
              </div>
            </div>
          </details>

        </div>

        <!-- Actions -->
        <div class="px-6 py-4 bg-industrial-50 border-t border-industrial-200 flex items-center gap-3">
          <button type="submit"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-accent-500 transition-colors">
            <i class="fas fa-save"></i> Salvar Configuração
          </button>

          <button type="button" id="testKeyBtn"
            class="inline-flex items-center gap-2 rounded-lg bg-white border border-industrial-300 px-4 py-2.5 text-sm font-semibold text-industrial-700 hover:bg-industrial-50 transition-colors">
            <i class="fas fa-vial"></i> Testar API Key
          </button>

          <div id="testResult" class="hidden ml-3 text-sm"></div>
        </div>
      </form>

    </div>
  </div>

  <script>
    // Proteger o campo API key de envio indevido (autocomplete do navegador)
    // O campo começa sem name; só ganha name se o usuário realmente digitar algo
    (function() {
      const apiKeyInput = document.getElementById('openaiApiKey')
      let userHasTyped = false

      // Remover o name ao carregar para que autocomplete não envie dados
      apiKeyInput.removeAttribute('name')

      // Detectar quando o USUÁRIO realmente digita (não autofill)
      apiKeyInput.addEventListener('keydown', function() {
        userHasTyped = true
      })
      apiKeyInput.addEventListener('input', function() {
        if (userHasTyped && this.value.trim().length > 0) {
          this.setAttribute('name', 'openaiApiKey')
        } else if (this.value.trim().length === 0) {
          this.removeAttribute('name')
        }
      })

      // Antes do submit, garantir que campo vazio não é enviado
      apiKeyInput.closest('form').addEventListener('submit', function() {
        if (!userHasTyped || apiKeyInput.value.trim().length === 0) {
          apiKeyInput.removeAttribute('name')
        }
      })
    })()

    // Toggle visibilidade da API key
    document.getElementById('toggleApiKeyVisibility').addEventListener('click', function() {
      const input = document.getElementById('openaiApiKey')
      const icon = document.getElementById('toggleApiKeyIcon')
      if (input.type === 'password') {
        input.type = 'text'
        icon.classList.remove('fa-eye')
        icon.classList.add('fa-eye-slash')
      } else {
        input.type = 'password'
        icon.classList.remove('fa-eye-slash')
        icon.classList.add('fa-eye')
      }
    })

    document.getElementById('testKeyBtn').addEventListener('click', async function() {
      const btn = this
      const resultEl = document.getElementById('testResult')

      btn.disabled = true
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Testando...'
      resultEl.classList.add('hidden')

      try {
        const resp = await fetch('{{ route("configuracoes.testVozKey") }}', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-XSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.content || '',
          },
        })

        const json = await resp.json()
        resultEl.classList.remove('hidden')

        if (json.success && json.data?.valid) {
          resultEl.className = 'ml-3 text-sm text-green-700'
          resultEl.innerHTML = '<i class="fas fa-check-circle"></i> ' + json.data.message
        } else {
          resultEl.className = 'ml-3 text-sm text-red-700'
          resultEl.innerHTML = '<i class="fas fa-times-circle"></i> ' + (json.error || 'Falha no teste')
        }
      } catch (err) {
        resultEl.classList.remove('hidden')
        resultEl.className = 'ml-3 text-sm text-red-700'
        resultEl.innerHTML = '<i class="fas fa-times-circle"></i> Erro de conexão'
      }

      btn.disabled = false
      btn.innerHTML = '<i class="fas fa-vial"></i> Testar API Key'
    })
  </script>
</body>
</html>
