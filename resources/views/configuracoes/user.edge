      <form action="{{ route('configuracoes.updateUser') }}" method="POST" class="bg-white ring-1 ring-industrial-100 rounded-lg p-6">
        {{ csrfField() }}
        <input type="hidden" name="_method" value="PUT">
        
        <div class="space-y-6">
          <!-- Dados Básicos -->
          <div>
            <h3 class="text-lg font-semibold text-industrial-900 mb-4">Dados Pessoais</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium app-muted mb-1">Nome Completo *</label>
                <input type="text" name="fullName" required minlength="3" maxlength="100"
                  class="w-full app-border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent-500" 
                  value="{{ user.fullName || '' }}"
                  placeholder="João da Silva">
                <p class="mt-1 text-xs text-industrial-500">Mínimo 3 caracteres</p>
              </div>

              <div>
                <label class="block text-sm font-medium app-muted mb-1">Email *</label>
                <input type="email" name="email" required 
                  class="w-full app-border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent-500" 
                  value="{{ user.email || '' }}"
                  placeholder="seuemail@exemplo.com">
                <p class="mt-1 text-xs text-industrial-500">Email válido para login</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium app-muted mb-1">CPF</label>
                  <input type="text" name="cpf" maxlength="14"
                    class="w-full app-border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent-500" 
                    value="{{ user.cpf || '' }}"
                    placeholder="000.000.000-00">
                </div>

                <div>
                  <label class="block text-sm font-medium app-muted mb-1">Telefone</label>
                  <input type="text" name="phone" maxlength="15"
                    class="w-full app-border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent-500" 
                    value="{{ user.phone || '' }}"
                    placeholder="(00) 00000-0000">
                </div>
              </div>
            </div>
          </div>

          <!-- Alteração de Senha -->
          <div class="border-t border-industrial-200 pt-6">
            <h3 class="text-lg font-semibold text-industrial-900 mb-4">Alteração de Senha</h3>
            <p class="text-sm app-muted mb-4">Deixe em branco se não desejar alterar a senha.</p>
            
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium app-muted mb-1">Senha Atual</label>
                <input type="password" name="currentPassword" id="currentPassword"
                  class="w-full app-border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent-500"
                  placeholder="Digite sua senha atual">
              </div>

              <div>
                <label class="block text-sm font-medium app-muted mb-1">Nova Senha</label>
                <input type="password" name="newPassword" id="newPassword"
                  class="w-full app-border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent-500"
                  minlength="6"
                  placeholder="Mínimo 6 caracteres">
                <p class="mt-1 text-xs text-industrial-500">Deve ter no mínimo 6 caracteres</p>
              </div>

              <div>
                <label class="block text-sm font-medium app-muted mb-1">Confirmar Nova Senha</label>
                <input type="password" name="newPasswordConfirmation" id="newPasswordConfirmation"
                  class="w-full app-border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent-500"
                  minlength="6"
                  placeholder="Digite a nova senha novamente">
                <p class="mt-1 text-xs text-red-600 hidden" id="passwordMismatch">As senhas não coincidem</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex gap-2 justify-end border-t border-industrial-200 pt-6">
          <a href="{{ route('dashboard.index') }}" 
            class="inline-flex items-center rounded-md bg-industrial-200 px-4 py-2 text-sm font-semibold app-muted hover:bg-industrial-300">
            <i class="fas fa-times mr-2"></i> Cancelar
          </a>
          <button type="submit" 
            class="inline-flex items-center rounded-md bg-accent-600 px-4 py-2 text-sm font-semibold text-white hover:bg-accent-700">
            <i class="fas fa-save mr-2"></i> Salvar Alterações
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Validação de confirmação de senha
    const newPassword = document.getElementById('newPassword');
    const newPasswordConfirmation = document.getElementById('newPasswordConfirmation');
    const currentPassword = document.getElementById('currentPassword');
    const passwordMismatch = document.getElementById('passwordMismatch');
    const form = document.querySelector('form');

    function validatePasswords() {
      if (newPassword.value || newPasswordConfirmation.value) {
        if (newPassword.value !== newPasswordConfirmation.value) {
          passwordMismatch.classList.remove('hidden');
          return false;
        } else {
          passwordMismatch.classList.add('hidden');
          return true;
        }
      }
      return true;
    }

    newPassword.addEventListener('input', validatePasswords);
    newPasswordConfirmation.addEventListener('input', validatePasswords);

    form.addEventListener('submit', function(e) {
      // Validar senha se algum campo de senha foi preenchido
      if (newPassword.value || newPasswordConfirmation.value || currentPassword.value) {
        if (!currentPassword.value) {
          e.preventDefault();
          alert('Para alterar a senha, você deve informar a senha atual.');
          currentPassword.focus();
          return;
        }
        if (!newPassword.value) {
          e.preventDefault();
          alert('Digite a nova senha.');
          newPassword.focus();
          return;
        }
        if (!validatePasswords()) {
          e.preventDefault();
          alert('As senhas não coincidem.');
          newPasswordConfirmation.focus();
          return;
        }
      }
    });
  </script>
</body>
</html>
