<!-- Quick Actions Floating Button -->
<div id="quickActionsContainer" class="fixed bottom-6 right-6 z-50">
  <!-- Floating Action Button -->
  <button
    id="quickActionsBtn"
    type="button"
    class="w-14 h-14 bg-accent-600 hover:bg-accent-700 rounded-full ring-2 ring-white/60 shadow-lg shadow-accent-600/25 transform hover:scale-110 transition-all duration-200 flex items-center justify-center text-white group"
    aria-label="Ações Rápidas"
  >
    <i class="fas fa-bolt text-xl group-hover:rotate-12 transition-transform duration-200"></i>
  </button>

  <!-- Quick Actions Menu (Hidden by default) -->
  <div
    id="quickActionsMenu"
    class="hidden absolute bottom-16 right-0 w-72 bg-white rounded-lg ring-1 ring-industrial-100 app-border overflow-hidden"
  >
    <!-- Header -->
    <div class="px-4 py-3 bg-white text-industrial-900 flex items-center justify-between border-b border-industrial-200">
      <div class="flex items-center">
        <div class="w-8 h-8 rounded-md bg-accent-600 text-white flex items-center justify-center mr-2">
          <i class="fas fa-bolt"></i>
        </div>
        <h3 class="font-semibold">Ações Rápidas</h3>
      </div>
      <button
        id="configQuickActionsBtn"
        type="button"
        class="inline-flex items-center gap-2 rounded-md bg-white app-border px-3 py-2 text-sm font-semibold text-accent-700 hover:border-accent-500 hover:text-accent-800 hover:bg-industrial-50 transition-colors shadow-sm"
        title="Configurar ações"
      >
        <i class="fas fa-cog"></i>        
      </button>
    </div>

    <!-- Actions List -->
    <div id="quickActionsList" class="py-2 max-h-96 overflow-y-auto">
      <!-- Loading state -->
      <div class="px-4 py-8 text-center text-industrial-500">
        <i class="fas fa-spinner fa-spin text-2xl mb-2"></i>
        <p class="text-sm">Carregando ações...</p>
      </div>
    </div>

  </div>
</div>

<!-- Configuration Modal -->
<div
  id="quickActionsConfigModal"
  class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4"
>
  <div class="bg-white rounded-lg ring-1 ring-industrial-100 max-w-2xl w-full max-h-[90vh] overflow-hidden">
    <!-- Modal Header -->
    <div class="px-6 py-4 bg-accent-700 text-white flex items-center justify-between">
      <div class="flex items-center">
        <i class="fas fa-cog mr-3"></i>
        <h3 class="text-lg font-semibold">Configurar Ações Rápidas</h3>
      </div>
      <button
        id="closeConfigModal"
        type="button"
        class="text-white hover:text-industrial-200 transition-colors"
      >
        <i class="fas fa-times text-xl"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 overflow-y-auto max-h-[calc(90vh-140px)]">
      <p class="app-muted mb-4">
        Selecione e organize as ações que você mais utiliza. Arraste para reordenar.
      </p>

      <!-- Available Actions -->
      <div id="availableActionsList" class="space-y-2">
        <!-- Will be populated by JavaScript -->
        <div class="text-center py-8 text-industrial-500">
          <i class="fas fa-spinner fa-spin text-2xl mb-2"></i>
          <p class="text-sm">Carregando opções...</p>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 bg-industrial-50 border-t border-industrial-200 flex justify-end space-x-3">
      <button
        id="cancelConfigBtn"
        type="button"
        class="px-4 py-2 text-sm font-medium app-muted bg-white app-border rounded-lg hover:bg-industrial-50 transition-colors"
      >
        Cancelar
      </button>
      <button
        id="saveConfigBtn"
        type="button"
        class="px-4 py-2 text-sm font-medium text-white bg-accent-600 hover:bg-accent-700 rounded-lg transition-colors shadow-sm"
      >
        <i class="fas fa-save mr-2"></i>
        Salvar Configurações
      </button>
    </div>
  </div>
</div>

<style>
  /* Smooth animations */
  #quickActionsMenu {
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Drag and drop styles */
  .dragging {
    opacity: 0.5;
  }

  .drag-over {
    border-top: 2px solid #6366f1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quickActionsBtn = document.getElementById('quickActionsBtn');
    const quickActionsMenu = document.getElementById('quickActionsMenu');
    const quickActionsList = document.getElementById('quickActionsList');
    const configModal = document.getElementById('quickActionsConfigModal');
    const configBtn = document.getElementById('configQuickActionsBtn');
    const closeModalBtn = document.getElementById('closeConfigModal');
    const cancelConfigBtn = document.getElementById('cancelConfigBtn');
    const saveConfigBtn = document.getElementById('saveConfigBtn');
    const availableActionsList = document.getElementById('availableActionsList');

    let currentActions = [];
    let availableActions = [];
    let isMenuOpen = false;

    // Color classes mapping
    const colorClasses = {
      blue: 'bg-blue-600 hover:bg-blue-700',
      green: 'bg-green-600 hover:bg-green-700',
      purple: 'bg-accent-600 hover:bg-accent-700',
      indigo: 'bg-indigo-600 hover:bg-indigo-700',
      orange: 'bg-orange-600 hover:bg-orange-700',
      teal: 'bg-teal-600 hover:bg-teal-700',
      pink: 'bg-pink-600 hover:bg-pink-700',
      amber: 'bg-amber-600 hover:bg-amber-700',
      red: 'bg-red-600 hover:bg-red-700',
      gray: 'bg-gray-600 hover:bg-gray-700',
    };

    // Toggle menu
    quickActionsBtn.addEventListener('click', function() {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        quickActionsMenu.classList.remove('hidden');
        loadQuickActions();
      } else {
        quickActionsMenu.classList.add('hidden');
      }
    });

    // Close menu when clicking outside
    document.addEventListener('click', function(e) {
      if (!quickActionsBtn.contains(e.target) && !quickActionsMenu.contains(e.target)) {
        isMenuOpen = false;
        quickActionsMenu.classList.add('hidden');
      }
    });

    // Open configuration modal
    function openConfigModal(e) {
      if (e) e.stopPropagation();
      configModal.classList.remove('hidden');
      loadAvailableActions();
    }

    configBtn.addEventListener('click', openConfigModal);

    // Close modal
    [closeModalBtn, cancelConfigBtn].forEach(btn => {
      btn.addEventListener('click', function() {
        configModal.classList.add('hidden');
      });
    });

    // Close modal on overlay click
    configModal.addEventListener('click', function(e) {
      if (e.target === configModal) {
        configModal.classList.add('hidden');
      }
    });

    // Load quick actions
    async function loadQuickActions() {
      try {
        const response = await fetch('/quick-actions');
        const data = await response.json();
        
        currentActions = data.userActions || [];
        availableActions = data.availableActions || [];
        
        renderQuickActions();
      } catch (error) {
        console.error('Erro ao carregar ações rápidas:', error);
        quickActionsList.innerHTML = '<div class="px-4 py-4 text-center text-red-500"><p class="text-sm">Erro ao carregar ações</p></div>';
      }
    }

    // Render quick actions in menu
    function renderQuickActions() {
      if (currentActions.length === 0) {
        quickActionsList.innerHTML = '<div class="px-4 py-4 text-center text-industrial-500"><p class="text-sm">Nenhuma ação configurada</p></div>';
        return;
      }

      const enabledActions = currentActions.filter(ua => ua.enabled);
      
      if (enabledActions.length === 0) {
        quickActionsList.innerHTML = '<div class="px-4 py-4 text-center text-industrial-500"><p class="text-sm">Nenhuma ação ativa</p></div>';
        return;
      }

      const html = enabledActions.map(userAction => {
        const action = availableActions.find(a => a.key === userAction.actionKey);
        if (!action) return '';

        const colorClass = colorClasses[action.color] || colorClasses.blue;

        return `
          <a
            href="${action.url || '#'}"
            class="flex items-center px-4 py-3 hover:bg-industrial-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-lg ${colorClass} flex items-center justify-center text-white group-hover:scale-110 transition-transform">
              <i class="fas ${action.icon}"></i>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-industrial-900">${action.label}</p>
            </div>
          </a>
        `;
      }).join('');

      quickActionsList.innerHTML = html;
    }

    // Load available actions for configuration
    async function loadAvailableActions() {
      try {
        const response = await fetch('/quick-actions');
        const data = await response.json();
        
        currentActions = data.userActions || [];
        availableActions = data.availableActions || [];
        
        renderAvailableActions();
      } catch (error) {
        console.error('Erro ao carregar ações disponíveis:', error);
      }
    }

    // Render available actions in config modal
    function renderAvailableActions() {
      const html = availableActions.map((action, index) => {
        const userAction = currentActions.find(ua => ua.actionKey === action.key);
        const isEnabled = userAction ? userAction.enabled : false;
        const colorClass = colorClasses[action.color] || colorClasses.blue;

        return `
          <div
            class="flex items-center justify-between p-4 bg-industrial-50 rounded-lg app-border hover:border-accent-300 transition-colors cursor-move"
            draggable="true"
            data-action-key="${action.key}"
            data-action-index="${index}"
          >
            <div class="flex items-center flex-1">
              <i class="fas fa-grip-vertical text-industrial-400 mr-3"></i>
              <div class="w-10 h-10 rounded-lg ${colorClass} flex items-center justify-center text-white">
                <i class="fas ${action.icon}"></i>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-industrial-900">${action.label}</p>
              </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                class="sr-only peer"
                ${isEnabled ? 'checked' : ''}
                data-action-key="${action.key}"
              >
              <div class="w-11 h-6 bg-industrial-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-accent-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-industrial-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-accent-600"></div>
            </label>
          </div>
        `;
      }).join('');

      availableActionsList.innerHTML = html;

      // Setup drag and drop
      setupDragAndDrop();
    }

    // Setup drag and drop functionality
    function setupDragAndDrop() {
      const items = availableActionsList.querySelectorAll('[draggable="true"]');
      let draggedItem = null;

      items.forEach(item => {
        item.addEventListener('dragstart', function(e) {
          draggedItem = this;
          this.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
        });

        item.addEventListener('dragend', function() {
          this.classList.remove('dragging');
          items.forEach(i => i.classList.remove('drag-over'));
        });

        item.addEventListener('dragover', function(e) {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          
          const afterElement = getDragAfterElement(availableActionsList, e.clientY);
          if (afterElement == null) {
            availableActionsList.appendChild(draggedItem);
          } else {
            availableActionsList.insertBefore(draggedItem, afterElement);
          }
        });
      });
    }

    function getDragAfterElement(container, y) {
      const draggableElements = [...container.querySelectorAll('[draggable="true"]:not(.dragging)')];

      return draggableElements.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;

        if (offset < 0 && offset > closest.offset) {
          return { offset: offset, element: child };
        } else {
          return closest;
        }
      }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    // Save configuration
    saveConfigBtn.addEventListener('click', async function() {
      const items = availableActionsList.querySelectorAll('[draggable="true"]');
      const actions = [];

      items.forEach((item, index) => {
        const key = item.dataset.actionKey;
        const checkbox = item.querySelector('input[type="checkbox"]');
        const enabled = checkbox.checked;

        actions.push({
          key: key,
          enabled: enabled,
          sortOrder: index
        });
      });

      try {
        saveConfigBtn.disabled = true;
        saveConfigBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Salvando...';

        // Get CSRF token from meta tag or input field
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || 
                         document.querySelector('input[name="_csrf"]')?.value || '';

        const response = await fetch('/quick-actions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': csrfToken
          },
          body: JSON.stringify({ actions })
        });

        if (response.ok) {
          configModal.classList.add('hidden');
          loadQuickActions();
          
          // Show success message
          const successMsg = document.createElement('div');
          successMsg.className = 'fixed top-4 right-4 z-50 bg-green-500 text-white px-6 py-3 rounded-lg ring-1 ring-industrial-100';
          successMsg.innerHTML = '<i class="fas fa-check mr-2"></i>Configurações salvas com sucesso!';
          document.body.appendChild(successMsg);
          
          setTimeout(() => {
            successMsg.remove();
          }, 3000);
        } else {
          throw new Error('Erro ao salvar configurações');
        }
      } catch (error) {
        console.error('Erro ao salvar:', error);
        alert('Erro ao salvar configurações. Tente novamente.');
      } finally {
        saveConfigBtn.disabled = false;
        saveConfigBtn.innerHTML = '<i class="fas fa-save mr-2"></i>Salvar Configurações';
      }
    });
  });
</script>
