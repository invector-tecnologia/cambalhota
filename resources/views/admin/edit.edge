        @end

        <div class="bg-white rounded-lg">
          <div class="px-6 py-4 border-b border-industrial-100">
            <h2 class="text-lg font-medium text-industrial-900">Editar Registro</h2>
            <p class="mt-1 text-sm text-industrial-500">Modifique os dados em formato JSON</p>
          </div>
          <form method="POST" action="{{ route('admin.update', { model, id: record.id }) }}" class="p-6">
            {{ csrfField() }}
            <input type="hidden" name="_method" value="PUT">
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium app-muted mb-2">Dados JSON</label>
                <textarea name="data" rows="20"
                  class="block w-full rounded-md border-industrial-300  focus:border-accent-500 focus:ring-accent-500 sm:text-sm font-mono">{{ JSON.stringify(record, null, 2) }}</textarea>
                <p class="mt-2 text-sm text-industrial-500">
                  <i class="fas fa-info-circle"></i> Modifique os campos necessários mantendo a estrutura JSON válida
                </p>
              </div>
            </div>
            <div class="mt-6 flex justify-end gap-3">
              <a href="{{ route('admin.list', { model }) }}"
                class="inline-flex items-center rounded-md bg-industrial-200 px-4 py-2 text-sm font-semibold app-muted  hover:bg-industrial-300">
                <i class="fas fa-arrow-left mr-2"></i> {{ modelName }}
              </a>
              <button type="submit"
                class="inline-flex items-center rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800">
                <i class="fas fa-save mr-2"></i> Salvar
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
