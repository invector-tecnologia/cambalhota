{{-- Modal de Reprocessamento em Lote --}}
<div id="batchReprocessModal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
  <div class="app-card rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
    <h2 class="text-2xl font-bold app-strong mb-4">Reprocessar em Lote</h2>
    
    <form method="POST" action="{{ route('processing.batchReprocess') }}">
      @csrf
      
      <div class="mb-4">
        <label class="block text-sm font-medium app-text mb-1">Tipo de Entidade</label>
        <select name="entityType" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
          <option value="">Todos</option>
          <option value="Pedido">Pedido</option>
          <option value="Venda">Venda</option>
          <option value="Comanda">Comanda</option>
          <option value="Nfe">NFe</option>
        </select>
      </div>

      <div class="mb-4">
        <label class="block text-sm font-medium app-text mb-1">Status</label>
        <select name="status" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
          <option value="">Todos com falha</option>
          <option value="partial">Apenas Parcial</option>
          <option value="failed">Apenas Falho</option>
        </select>
      </div>

      <div class="flex gap-2">
        <button type="button" onclick="hideBatchReprocessModal()" class="flex-1 px-4 py-2 app-muted app-border rounded-lg hover:bg-industrial-50">
          Cancelar
        </button>
        <button type="submit" class="flex-1 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
          <i class="fas fa-sync mr-2"></i>Reprocessar
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function showBatchReprocessModal() {
  document.getElementById('batchReprocessModal').classList.remove('hidden')
}

function hideBatchReprocessModal() {
  document.getElementById('batchReprocessModal').classList.add('hidden')
}
</script>
