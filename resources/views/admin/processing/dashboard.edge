        <span class="px-4 py-2">Página {{ pagination.currentPage }} de {{ pagination.lastPage }}</span>

        @if(pagination.currentPage < pagination.lastPage)
          <a href="?page={{ pagination.currentPage + 1 }}" class="px-3 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50">Próxima</a>
          <a href="?page={{ pagination.lastPage }}" class="px-3 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50">Última</a>
