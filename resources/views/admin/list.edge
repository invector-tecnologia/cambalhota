<body class="h-full font-sans text-industrial-900">
  <script>
    function confirmEmpresaDelete(form) {
      const opcao = window.prompt(
        'Escolha o tipo de deleção da empresa:\n- Digite "L" para deleção lógica (desativar)\n- Digite "P" para deleção permanente (apagar tudo)'
      )

      if (!opcao) {
        return false
      }

      const modo = String(opcao).trim().toUpperCase()
      if (modo !== 'L' && modo !== 'P') {
        window.alert('Opção inválida. Use L ou P.')
        return false
      }

      if (modo === 'P') {
        const confirmou = window.confirm(
          'Confirma deleção PERMANENTE? Esta ação remove empresa, usuários e todas as dependências e não pode ser desfeita.'
        )

        if (!confirmou) {
          return false
        }
      }

      const input = form.querySelector('input[name="deleteMode"]')
      if (input) {
        input.value = modo === 'P' ? 'permanent' : 'logical'
      }

      return true
    }
  </script>
  <div class="min-h-full">
