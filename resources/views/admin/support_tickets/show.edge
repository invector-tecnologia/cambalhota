<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-industrial-50">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Ticket {{ ticket.protocolo || ('SUP-' + ticket.id) }}</title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="h-full font-sans text-industrial-900">
  <main class="mx-auto max-w-6xl py-8 px-4">
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-xl font-semibold">Ticket {{ ticket.protocolo || ('SUP-' + ticket.id) }}</h1>
      <a href="{{ route('admin.supportTickets.index') }}" class="text-sm text-red-700 hover:text-red-800">Voltar à Lista</a>
    </div>

    @if(flashMessages.has('success'))
      <div class="mb-4 rounded-md bg-green-50 p-3 text-sm text-green-800">{{ flashMessages.get('success') }}</div>
    @end
    @if(flashMessages.has('error'))
      <div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">{{ flashMessages.get('error') }}</div>
    @end

    <div class="bg-white rounded-lg border border-industrial-100 p-4 mb-4">
      <p class="text-sm"><span class="font-semibold">Empresa:</span> {{ ticket.empresa?.razaoSocial || ('Empresa #' + ticket.empresaId) }}</p>
      <p class="text-sm"><span class="font-semibold">Usuário:</span> {{ ticket.openedByUser?.fullName || ticket.nomeContato }} ({{ ticket.emailContato }})</p>
      <p class="text-sm"><span class="font-semibold">Assunto:</span> {{ ticket.assunto }}</p>
      <p class="text-sm"><span class="font-semibold">Status:</span> {{ ticket.status }}</p>
      <p class="text-sm"><span class="font-semibold">Admin sem resposta (sequência):</span> {{ ticket.adminNoReplyStreak || 0 }}</p>
    </div>

    <div class="bg-white rounded-lg border border-industrial-100 p-4 mb-4">
      <h2 class="text-sm font-semibold mb-3">Conversa</h2>
      <div class="space-y-3 max-h-[420px] overflow-y-auto">
        @if(mensagens && mensagens.length > 0)
          @each(msg in mensagens)
            <div class="rounded-md p-3 {{ msg.senderTipo === 'usuario' ? 'bg-blue-50 border border-blue-100' : msg.senderTipo === 'admin' ? 'bg-emerald-50 border border-emerald-100' : 'bg-industrial-50 border border-industrial-100' }}">
              <div class="text-xs mb-1 text-industrial-500">{{ msg.senderTipo }} • {{ msg.senderUser?.fullName || msg.senderUser?.email || '-' }} • {{ msg.createdAt || '-' }}</div>
              <p class="text-sm whitespace-pre-wrap">{{ msg.mensagem }}</p>
            </div>
          @end
        @else
          <p class="text-sm text-industrial-500">Sem mensagens no ticket.</p>
        @end
      </div>
    </div>

    @if(ticket.status !== 'resolvido' && ticket.status !== 'fechado' && ticket.status !== 'cancelado')
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <form method="POST" action="{{ route('admin.supportTickets.reply', { id: ticket.id }) }}" class="bg-white rounded-lg border border-industrial-100 p-4">
          {{ csrfField() }}
          <h3 class="text-sm font-semibold mb-2">Responder Usuário</h3>
          <textarea name="mensagem" rows="5" required class="w-full rounded-md border-industrial-300 focus:border-red-700 focus:ring-red-700"></textarea>
          <div class="mt-3 flex justify-end">
            <button type="submit" class="px-4 py-2 rounded-md bg-red-700 text-white text-sm font-semibold hover:bg-red-800">Enviar Resposta</button>
          </div>
        </form>

        <form method="POST" action="{{ route('admin.supportTickets.suggestSolution', { id: ticket.id }) }}" class="bg-white rounded-lg border border-industrial-100 p-4">
          {{ csrfField() }}
          <h3 class="text-sm font-semibold mb-2">Sugerir Solução</h3>
          <textarea name="mensagem" rows="5" required class="w-full rounded-md border-industrial-300 focus:border-red-700 focus:ring-red-700" placeholder="Explique a solução e peça confirmação do usuário."></textarea>
          <div class="mt-3 flex justify-end">
            <button type="submit" class="px-4 py-2 rounded-md bg-green-700 text-white text-sm font-semibold hover:bg-green-800">Enviar Sugestão</button>
          </div>
        </form>
      </div>
    @end
  </main>
</body>
</html>
