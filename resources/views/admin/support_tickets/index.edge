<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-industrial-50">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin - Tickets de Suporte</title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="h-full font-sans text-industrial-900">
  <main class="mx-auto max-w-6xl py-8 px-4">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-semibold">Tickets de Suporte (Admin)</h1>
      <a href="{{ route('admin.index') }}" class="text-sm text-red-700 hover:text-red-800">Voltar ao Admin</a>
    </div>

    <form method="GET" class="mb-4">
      <select name="status" class="rounded-md border-industrial-300 text-sm">
        <option value="">Todos os status</option>
        <option value="aberto" {{ status === 'aberto' ? 'selected' : '' }}>aberto</option>
        <option value="aguardando_usuario" {{ status === 'aguardando_usuario' ? 'selected' : '' }}>aguardando_usuario</option>
        <option value="aguardando_admin" {{ status === 'aguardando_admin' ? 'selected' : '' }}>aguardando_admin</option>
        <option value="em_andamento" {{ status === 'em_andamento' ? 'selected' : '' }}>em_andamento</option>
        <option value="sugestao_solucao" {{ status === 'sugestao_solucao' ? 'selected' : '' }}>sugestao_solucao</option>
        <option value="resolvido" {{ status === 'resolvido' ? 'selected' : '' }}>resolvido</option>
        <option value="cancelado" {{ status === 'cancelado' ? 'selected' : '' }}>cancelado</option>
      </select>
      <button type="submit" class="ml-2 px-3 py-2 rounded-md bg-red-700 text-white text-sm">Filtrar</button>
    </form>

    <div class="bg-white rounded-lg border border-industrial-100 overflow-hidden">
      <table class="min-w-full divide-y divide-industrial-100">
        <thead class="bg-industrial-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-industrial-600 uppercase">Protocolo</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-industrial-600 uppercase">Empresa</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-industrial-600 uppercase">Usuário</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-industrial-600 uppercase">Assunto</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-industrial-600 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-industrial-600 uppercase">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-industrial-100">
          @if(tickets.data && tickets.data.length > 0)
            @each(ticket in tickets.data)
              <tr>
                <td class="px-4 py-3 text-sm font-medium">{{ ticket.protocolo || ('SUP-' + ticket.id) }}</td>
                <td class="px-4 py-3 text-sm">{{ ticket.empresa?.razaoSocial || ('Empresa #' + ticket.empresaId) }}</td>
                <td class="px-4 py-3 text-sm">{{ ticket.openedByUser?.fullName || ticket.nomeContato }}</td>
                <td class="px-4 py-3 text-sm">{{ ticket.assunto }}</td>
                <td class="px-4 py-3 text-sm">{{ ticket.status }}</td>
                <td class="px-4 py-3 text-sm"><a class="text-red-700 hover:text-red-800" href="{{ route('admin.supportTickets.show', { id: ticket.id }) }}">Abrir</a></td>
              </tr>
            @end
          @else
            <tr><td colspan="6" class="px-4 py-10 text-center text-sm text-industrial-500">Nenhum ticket encontrado.</td></tr>
          @end
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
