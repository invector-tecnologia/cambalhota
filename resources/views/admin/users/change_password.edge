</div>

<script>
function switchMode(mode) {
  const generateTab = document.getElementById('generateTab');
  const manualTab = document.getElementById('manualTab');
  const generateMode = document.getElementById('generateMode');
  const manualMode = document.getElementById('manualMode');
  const newPasswordInput = document.getElementById('new_password');
  
  if (mode === 'generate') {
    generateTab.classList.add('active');
    manualTab.classList.remove('active');
    generateMode.classList.remove('hidden');
    manualMode.classList.add('hidden');
    
    // Remover required do campo manual
    newPasswordInput.removeAttribute('required');
  } else {
    manualTab.classList.add('active');
    generateTab.classList.remove('active');
    manualMode.classList.remove('hidden');
    generateMode.classList.add('hidden');
    
    // Adicionar required ao campo manual
    newPasswordInput.setAttribute('required', 'required');
  }
}

function togglePasswordVisibility(fieldId) {
  const field = document.getElementById(fieldId);
  const icon = field.nextElementSibling.querySelector('i');
  
  if (field.type === 'password') {
    field.type = 'text';
    icon.classList.remove('fa-eye');
    icon.classList.add('fa-eye-slash');
  } else {
    field.type = 'password';
    icon.classList.remove('fa-eye-slash');
    icon.classList.add('fa-eye');
  }
}

function copyPassword(button) {
  const successMsg = button.closest('.bg-green-50').querySelector('.text-green-800');
  const text = successMsg.textContent;
  
  // Extrair senha da mensagem
  const match = text.match(/Nova senha: (.+)$/);
  if (match) {
    const password = match[1];
    navigator.clipboard.writeText(password).then(() => {
      const originalText = button.innerHTML;
      button.innerHTML = '<i class="fas fa-check mr-2"></i>Copiado!';
      button.classList.remove('bg-green-600', 'hover:bg-green-700');
      button.classList.add('bg-green-800');
      
      setTimeout(() => {
        button.innerHTML = originalText;
        button.classList.remove('bg-green-800');
        button.classList.add('bg-green-600', 'hover:bg-green-700');
      }, 2000);
    });
  }
}

// Validação de confirmação de senha
document.addEventListener('DOMContentLoaded', function() {
  const form = document.querySelector('form');
  if (form) {
    form.addEventListener('submit', function(e) {
      const mode = document.getElementById('manualMode').classList.contains('hidden') ? 'generate' : 'manual';
      
      if (mode === 'manual') {
        const password = document.getElementById('new_password').value;
        const confirm = document.getElementById('confirm_password').value;
        
        if (password !== confirm) {
          e.preventDefault();
          alert('As senhas não coincidem. Por favor, verifique e tente novamente.');
          return false;
        }
      }
    });
  }
});
</script>

<style>
.tab-button {
  background-color: #f3f4f6;
  color: #374151;
}

.tab-button.active {
  background-color: #dc2626;
  color: white;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.tab-button:hover:not(.active) {
  background-color: #e5e7eb;
}
</style>
