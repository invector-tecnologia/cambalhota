<body class="h-full font-sans text-industrial-900">
  <script>
    function confirmEmpresaDelete(form) {
      const opcao = window.prompt(
        'Escolha o tipo de deleção da empresa:\n- Digite "L" para deleção lógica (desativar)\n- Digite "P" para deleção permanente (apagar tudo)'
      )

      if (!opcao) {
        return false
      }

      const modo = String(opcao).trim().toUpperCase()
      if (modo !== 'L' && modo !== 'P') {
        window.alert('Opção inválida. Use L ou P.')
        return false
      }

      if (modo === 'P') {
        const confirmou = window.confirm(
          'Confirma deleção PERMANENTE? Esta ação remove empresa, usuários e todas as dependências e não pode ser desfeita.'
        )

        if (!confirmou) {
          return false
        }
      }

      const input = form.querySelector('input[name="deleteMode"]')
      if (input) {
        input.value = modo === 'P' ? 'permanent' : 'logical'
      }

      return true
    }
  </script>
  <div class="min-h-full">
    <header class="bg-red-700 shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center gap-3">
          <div class="h-10 w-10 rounded-full bg-white/15 text-white flex items-center justify-center">
            <i class="fas fa-shield-alt"></i>
          </div>
          <h1 class="text-lg font-semibold text-white">{{ modelName }} #{{ record.id }}</h1>
          <div class="flex items-center space-x-4 ml-auto">
            @if(model === 'users')
              <a href="{{ route('admin.users.change_password', { id: record.id }) }}"
                class="inline-flex items-center rounded-lg bg-yellow-500 px-3 py-2 text-sm font-semibold text-white hover:bg-yellow-600">
                <i class="fas fa-key mr-2"></i> Alterar Senha
              </a>
            @end
            <a href="{{ route('admin.edit', { model, id: record.id }) }}"
              class="inline-flex items-center rounded-lg ring-1 ring-white/30 bg-white/10 px-3 py-2 text-sm font-semibold text-white hover:bg-white/20">
              <i class="fas fa-edit mr-2"></i> Editar
            </a>
            <a href="{{ route('admin.list', { model }) }}"
              class="inline-flex items-center rounded-lg ring-1 ring-white/30 bg-white/10 px-3 py-2 text-sm font-semibold text-white hover:bg-white/20">
              <i class="fas fa-arrow-left mr-2"></i> {{ modelName }}
            </a>
          </div>
        </div>
      </div>
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">

        <!-- Detalhes do registro -->
        <div class="bg-white rounded-lg overflow-hidden">
          <div class="px-6 py-4 border-b border-industrial-100">
            <h2 class="text-lg font-medium text-industrial-900">Detalhes do Registro</h2>
          </div>
          <div class="px-6 py-4">
            <pre class="text-sm bg-industrial-50 p-4 rounded overflow-x-auto">{{ JSON.stringify(record, null, 2) }}</pre>
          </div>
        </div>

        <!-- Ações -->
        <div class="mt-6 flex justify-end space-x-3">
          @if(model === 'empresas')
            <form method="POST" action="{{ route('admin.destroy', { model, id: record.id }) }}"
              onsubmit="return confirmEmpresaDelete(this)">
              {{ csrfField() }}
              <input type="hidden" name="_method" value="DELETE">
              <input type="hidden" name="deleteMode" value="logical">
              <button type="submit"
                class="inline-flex items-center rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800">
                <i class="fas fa-trash mr-2"></i> Deletar
              </button>
            </form>
          @else
            <form method="POST" action="{{ route('admin.destroy', { model, id: record.id }) }}"
              onsubmit="return confirm('Tem certeza que deseja deletar este registro? Esta ação não pode ser desfeita.')">
              {{ csrfField() }}
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit"
                class="inline-flex items-center rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800">
                <i class="fas fa-trash mr-2"></i> Deletar
              </button>
            </form>
          @end
        </div>

      </div>
    </main>
  </div>
