    "@adonisjs/session": "^7.5.1",
    "@adonisjs/shield": "^8.1.2",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^4.0.0",
    "@aws-sdk/client-s3": "^3.705.0",
    "@types/xml2js": "^0.4.14",
    "@vinejs/vine": "^3.0.0",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bullmq": "^5.66.1",
    "crypto-js": "^4.2.0",
    "edge.js": "^6.2.1",
    "fast-xml-parser": "^5.3.3",
