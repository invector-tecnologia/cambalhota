{
  "name": "tavolo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "postbuild": "node scripts/copy_ca_bundle.mjs",
