    "@types/adm-zip": "^0.5.5",
    "@types/archiver": "^7.0.0",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.13.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@types/sinon": "^21.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.20.1",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.0",
    "postcss": "^8.5.6",
    "sinon": "^21.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7",
    "vite": "^6.1.0"
